#!/usr/bin/env python3
"""Print stable word-based token estimates for the runtime skill files.

--traversal: per evals/traversal case, the controller's read load — SKILL.md plus the
references the case expects it to read.
"""

from __future__ import annotations

import json
import math
import re
import sys
from pathlib import Path


root = Path(__file__).resolve().parents[1]
skill_dirs = sorted(path for path in (root / "skills").iterdir() if path.is_dir())
if len(skill_dirs) != 1 or skill_dirs[0].name == "__SKILL_NAME__":
    raise SystemExit("count-skill-tokens: instantiate exactly one skill first")

skill = skill_dirs[0]


def estimate(path: Path) -> int:
    return math.ceil(len(re.findall(r"\b\w+\b", path.read_text(encoding="utf-8"))) * 1.35)


if "--traversal" in sys.argv[1:]:
    cases = json.loads((root / "evals" / "traversal" / "cases.json").read_text(encoding="utf-8"))
    router = estimate(skill / "SKILL.md")
    for case in cases:
        refs = case.get("expected_references", [])
        load = router + sum(estimate(skill / ref) for ref in refs)
        print(f"{load:6d}  {case['id']}  (SKILL.md + {len(refs)} references)")
    raise SystemExit(0)

total = 0
for path in sorted(path for path in skill.rglob("*") if path.is_file() and path.suffix in {".md", ".yaml", ".yml"}):
    tokens = estimate(path)
    total += tokens
    print(f"{tokens:6d}  {path.relative_to(root)}")
print(f"{total:6d}  total estimated tokens")
