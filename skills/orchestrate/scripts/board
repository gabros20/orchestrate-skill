# --- workspace -----------------------------------------------------------------------

def runs_dir() -> Path:
    """The machine-wide run registry: one small pointer file per workspace, touched on every journal write."""
    return Path(os.environ.get("ORCHESTRATE_HOME") or (Path.home() / ".orchestrate")) / "runs"


def touch_registry(ws: Path, run_id: str) -> None:
    try:
        d = runs_dir()
        d.mkdir(parents=True, exist_ok=True)
        (d / f"{sha(str(ws.resolve()))[:16]}.json").write_text(json.dumps(
            {"ws": str(ws.resolve()), "run": run_id, "repo": ws.resolve().parent.name, "last": time.time()}), encoding="utf-8")
    except OSError:
        pass  # the registry is a convenience for the pane, never a record


def registry_runs() -> list[dict]:
    """Known runs, newest activity first; pointers to vanished workspaces are dropped."""
    out = []
    try:
        for p in runs_dir().glob("*.json"):
            try:
                r = json.loads(p.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                continue
            if not Path(r.get("ws", "")).exists():
                try:
                    p.unlink()
                except OSError:
                    pass
                continue
            out.append(r)
    except OSError:
        pass
    return sorted(out, key=lambda r: -float(r.get("last", 0)))


def latest_run_ws(here: Path | None) -> Path | None:
    """The pane's default: the workspace with the newest journal activity on this machine, `here` on ties."""
    if os.environ.get("ORCHESTRATE_WS"):
        return here
    here_last = 0.0
    if here and (here / JOURNAL).exists():
        here_last = (here / JOURNAL).stat().st_mtime
        key = sha(str(here.resolve()))[:16]
        if not (runs_dir() / f"{key}.json").exists():   # backfill: a run journaled before the registry existed
            touch_registry(here, last_line(here / JOURNAL).get("run", ""))
            try:
                os.utime(runs_dir() / f"{key}.json", (here_last, here_last))
                (runs_dir() / f"{key}.json").write_text(json.dumps({"ws": str(here.resolve()), "run": last_line(here / JOURNAL).get("run", ""),
                                                                    "repo": here.resolve().parent.name, "last": here_last}), encoding="utf-8")
            except OSError:
                pass
    best = None
    for r in registry_runs():
        if here and Path(r["ws"]).resolve() == here.resolve():
            continue
        if float(r.get("last", 0)) > here_last + 1 and (best is None or r["last"] > best["last"]):
            best = r
    return Path(best["ws"]) if best else here


def workspace_or_none() -> Path | None:
    try:
        return workspace()
    except SystemExit:
        return None


def workspace() -> Path:
    env = os.environ.get("ORCHESTRATE_WS")
    if env:
        return Path(env)
    try:
        common = subprocess.run(["git", "rev-parse", "--git-common-dir"], capture_output=True,
                                text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        sys.exit("board: not inside a git repository")
    common_path = Path(common)
    if not common_path.is_absolute():
        common_path = Path.cwd() / common_path
    return common_path.resolve().parent / ".orchestrate"


GIT_CWD: Path | None = None   # the workspace's repo — a pane following another run must not read its own cwd's git


def git(*args: str) -> str:
    try:
        return subprocess.run(["git", *args], capture_output=True, text=True, cwd=GIT_CWD).stdout.strip()
    except (FileNotFoundError, OSError):
        return ""


def now_iso() -> str:
    return dt.datetime.now().isoformat(timespec="milliseconds")


def now_utc() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def sha(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def new_run_id() -> str:
    return dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + os.urandom(2).hex()


def canonical(env: dict) -> str:
    return json.dumps({k: v for k, v in env.items() if k != "hash"}, sort_keys=True, ensure_ascii=False,
                      separators=(",", ":"))


def chain_hash(prev: str, env: dict) -> str:
    return sha(prev + "\n" + canonical(env))


def atomic_write(path: Path, text: str) -> None:
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def journal_path(ws: Path) -> Path:
    """Locate the journal; migrate the pre-release name and v1 (schema-less) lines atomically."""
    path = ws / JOURNAL
    legacy = ws / LEGACY_JOURNAL
    if not path.exists() and legacy.exists():
        shutil.copy2(legacy, ws / (LEGACY_JOURNAL + ".bak"))
        os.replace(legacy, path)
    if path.exists():
        migrate_v1(path)
    return path


def migrate_v1(path: Path) -> None:
    raw = path.read_text(encoding="utf-8")
    lines = [ln for ln in raw.splitlines() if ln.strip()]
    if not lines:
        return
    try:
        first = json.loads(lines[0])
    except json.JSONDecodeError:
        first = {}
    if first.get("schema") == SCHEMA:
        return
    shutil.copy2(path, path.with_name("journal.jsonl.v1.bak"))
    run_id = "legacy-" + dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    out, prev = [], ""
    seq = 0
    for ln in lines:
        try:
            ev = json.loads(ln)
        except json.JSONDecodeError:
            continue
        seq += 1
        env = {"schema": SCHEMA, "run": run_id, "seq": seq, "ts": ev.pop("ts", now_iso()), "ts_utc": "",
               "actor": ev.get("agent") if ev.get("ev") == "note" else "controller", **ev, "prev": prev}
        env["hash"] = chain_hash(prev, env)
        prev = env["hash"]
        out.append(json.dumps(env, ensure_ascii=False))
    atomic_write(path, "\n".join(out) + "\n")


def last_line(path: Path) -> dict:
    if not path.exists():
        return {}
    with path.open("rb") as fh:
        try:
            fh.seek(-4096, os.SEEK_END)
        except OSError:
            fh.seek(0)
        tail = fh.read().decode("utf-8", "replace").strip().splitlines()
    for ln in reversed(tail):
        try:
            return json.loads(ln)
        except json.JSONDecodeError:
            continue
    return {}


def append_event(ws: Path, actor: str = "controller", **fields: object) -> dict:
    ws.mkdir(parents=True, exist_ok=True)
    gi = ws / ".gitignore"
    if not gi.exists():
        gi.write_text("*\n")
    path = journal_path(ws)
    # One writer at a time: parallel workers (`note`, `exec`) must not race the seq/prev chain.
    with (ws / ".journal.lock").open("a") as lock:
        try:
            import fcntl
            fcntl.flock(lock, fcntl.LOCK_EX)
        except (ImportError, OSError):
            pass  # no POSIX locks here — best effort, the chain check still catches a race
        last = last_line(path)
        run_id = str(fields.pop("run_id", "") or last.get("run") or new_run_id())
        env = {"schema": SCHEMA, "run": run_id, "seq": int(last.get("seq", 0)) + 1, "ts": now_iso(), "ts_utc": now_utc(),
               "actor": actor, **{k: v for k, v in fields.items() if v not in (None, "", [], {})},
               "prev": str(last.get("hash", ""))}
        env["hash"] = chain_hash(env["prev"], env)
        with path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(env, ensure_ascii=False) + "\n")
    touch_registry(ws, run_id)
    return env


def read_events(ws: Path) -> tuple[list[dict], list[str]]:
    """Returns (events, integrity problems). Problems never hide events — views stay usable."""
    if not ws.exists():
        return [], []
    path = journal_path(ws)
    if not path.exists():
        return [], []
    out, problems = [], []
    prev, expect = "", 1
    for i, line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        line = line.strip()
        if not line:
            continue
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            problems.append(f"journal line {i}: malformed JSON (skipped)")
            continue
        if ev.get("schema") != SCHEMA:
            problems.append(f"journal line {i}: schema {ev.get('schema')} (expected {SCHEMA})")
        seq = ev.get("seq")
        if seq != expect:
            problems.append(f"journal line {i}: seq {seq}, expected {expect} (gap or reorder)")
            expect = int(seq) + 1 if isinstance(seq, int) else expect + 1
        else:
            expect += 1
        if ev.get("prev", "") != prev:
            problems.append(f"journal line {i}: prev-hash mismatch (line inserted, removed or edited before it)")
        recomputed = chain_hash(str(ev.get("prev", "")), ev)
        if ev.get("hash") != recomputed:
            problems.append(f"journal line {i}: hash mismatch (line edited in place)")
        prev = recomputed  # the chain continues from what the line SHOULD hash to, so a break propagates
        out.append(ev)
    return out, problems


# --- derivation ----------------------------------------------------------------------

class Task:
    def __init__(self, tid: str):
        self.id = tid
        self.title = ""
        self.candidates: list[tuple[float, int, str, str]] = []  # (ts, seq, state, detail) — later seq wins ties
        self.agent = self.model = self.engine = ""
        self.since = 0.0
        self.artifact_ts = 0.0    # deliverable deltas only (rule 3b)
        self.heartbeat_ts = 0.0   # notes and events — never liveness
        self.gate_entries: list[tuple[float, int, str, str]] = []  # (ts, attempt, kind, "ok r1"/"fail r2"/".. r1")
        self.attempt = 0
        self.note = ""
        self.final = ""
        self.final_note = ""
        self.dispatched = False
        self.returned = False
        self.report = ""
        self.findings: list[str] = []
        self.last_status = ""
        self.check_entries: list[tuple[float, int, str, str, str, str, str]] = []  # (ts, attempt, name, status, exit, dur, log)
        self.escalations = 0
        self.vote_entries: list[tuple[float, int, str, str, str, str]] = []  # (ts, attempt, kind, agent, verdict, why)

    @property
    def checks(self) -> dict[str, dict[str, str]]:
        """Named checks of the current attempt (latest result per name): status running|ok|fail, exit, dur, log."""
        out: dict[str, tuple[float, dict[str, str]]] = {}
        for ts, attempt, name, status, code, dur, log in self.check_entries:
            if attempt >= self.attempt and (name not in out or ts >= out[name][0]):
                out[name] = (ts, {"status": status, "exit": code, "dur": dur, "log": log, "ts": str(ts)})
        return {k: v[1] for k, v in out.items()}

    @property
    def failed_checks(self) -> list[str]:
        return [k for k, v in self.checks.items() if v["status"] == "fail"]

    def votes(self, kind: str) -> list[tuple[str, str]]:
        """(agent, verdict) — the current attempt's latest vote per agent for one gate kind."""
        latest: dict[str, tuple[float, str]] = {}
        for ts, attempt, k, agent, verdict, _ in self.vote_entries:
            if k == kind and attempt >= self.attempt and (agent not in latest or ts >= latest[agent][0]):
                latest[agent] = (ts, verdict)
        return [(a, v) for a, (_, v) in latest.items()]

    @property
    def gates(self) -> dict[str, str]:
        out: dict[str, tuple[float, str]] = {}
        for ts, attempt, kind, text in self.gate_entries:
            if attempt >= self.attempt and (kind not in out or ts >= out[kind][0]):
                out[kind] = (ts, text)
        return {k: v[1] for k, v in out.items()}

    @property
    def state(self) -> str:
        if self.final:
            return self.final
        if not self.candidates:
            return "todo"
        return max(self.candidates, key=lambda c: (c[0], c[1]))[2]

    @property
    def detail(self) -> str:
        if self.candidates:
            return max(self.candidates, key=lambda c: (c[0], c[1]))[3]
        return ""

    @property
    def last_activity(self) -> float:
        return max(self.artifact_ts, self.since)

    def touch_artifact(self, ts: float) -> None:
        self.artifact_ts = max(self.artifact_ts, ts)

    def touch_heartbeat(self, ts: float) -> None:
        self.heartbeat_ts = max(self.heartbeat_ts, ts)


class Stint:
    """One dispatched agent, from dispatch to return."""

    def __init__(self, ev: dict, ts: float, attempt: int):
        self.agent = str(ev.get("agent", ""))
        self.task = str(ev.get("task", ""))
        self.role = str(ev.get("role") or "implementer")
        self.model = str(ev.get("model", ""))
        self.engine = str(ev.get("engine", ""))
        self.effort = str(ev.get("effort", ""))
        self.worktree = str(ev.get("worktree", ""))
        self.attempt = attempt
        self.started = ts
        self.returned = 0.0
        self.status = ""
        self.observed = ""
        self.tokens = 0
        self.commits = ""
        self.report = ""
        self.nudges = 0
        self.escalated_to = ""
        self.heartbeat_ts = ts
        self.owns = str(ev.get("owns", ""))          # exclusive files/areas — what peers must ask before touching
        self.by = str(ev.get("by") or "controller")   # who dispatched this stint: the controller, or a lead (sub-orchestrator) — authority is lineage
        self.sent = 0                                 # mails sent during this stint (MAIL_CAP)
        self.learned = 0                              # learnings journaled during this stint (LEARN_CAP)
        self.seq = int(ev.get("seq") or 0)            # the dispatch's journal seq — record changes after it are news to this stint
        self.session = str(ev.get("session", ""))    # the engine's session id — resume by THIS, never "last"
        self.log = str(ev.get("log", ""))            # captured event stream / stdout, relative to .orchestrate/
        self.cmd_file = str(ev.get("cmd_file", ""))  # the wrapper script that launched the lane
        self.pid = int(ev.get("pid") or 0)
        self.after = [x for x in str(ev.get("after") or "").split(",") if x]   # tasks this lane's wrapper waits for before the engine starts
        self.exit_code: int | None = None            # the lane process's exit status (an observation, not a return)
        self.exited = 0.0
        self.calls = 0                                # model calls, from the receipt
        self.cost = 0.0                               # USD, from the receipt when the engine reports one
        self.reported = ""                            # the report file's own Status line, seen at return


class Mail:
    """One journaled message: information between agents, never a transition."""

    def __init__(self, ev: dict, ts: float):
        self.seq = int(ev.get("seq", 0))
        self.ts = ts
        self.sender = clean(ev.get("from", "")) or "?"
        self.to = clean(ev.get("to", "")) or "controller"
        self.msg = clean(ev.get("msg", ""))
        self.re = int(ev.get("re") or 0)
        self.ask = bool(ev.get("ask"))


class Learn:
    """One journaled learning: a worker's discovery peers receive at their next checkpoint — information, never a transition."""

    def __init__(self, ev: dict, ts: float):
        self.seq = int(ev.get("seq", 0))
        self.ts = ts
        self.agent = clean(ev.get("agent", "")) or "?"
        self.task = str(ev.get("task", ""))
        self.kind = str(ev.get("kind") or "gotcha")
        self.msg = clean(ev.get("msg", ""))
        self.path = clean(ev.get("path", ""))
        self.by = str(ev.get("by") or "controller")   # the sender's dispatcher — learnings travel within a team

    def key(self) -> str:
        return " ".join(self.msg.casefold().split())


class Change:
    """A decision or rail recorded after a worker was dispatched — its brief snapshot predates it."""

    def __init__(self, ev: dict, ts: float, revised: bool):
        self.seq = int(ev.get("seq", 0))
        self.ts = ts
        self.kind = str(ev.get("ev", ""))
        self.id = str(ev.get("id") or "")
        self.msg = clean(ev.get("msg", ""))
        self.why = clean(ev.get("why", ""))
        self.owner = str(ev.get("owner") or "")
        self.revised = revised


class Run:
    def __init__(self) -> None:
        self.id = ""
        self.dims: dict[str, object] = {}
        self.kickoff = 0.0
        self.branch = self.base = ""
        self.plan = ""          # approved / changed / skipped / pending
        self.plan_ts = 0.0
        self.plan_msg = ""
        self.plan_trail: list[str] = []
        self.rails: list[str] = []
        self.observed: dict[str, str] = {}    # role tier -> last observed model
        self.drift: list[str] = []            # every requested≠observed, in order
        self.decisions: list[dict] = []
        self.finish = ""        # pass / fail
        self.finish_evidence = ""
        self.finish_ts = 0.0
        self.finish_seq = 0
        self.finish_head = ""
        self.finish_goal = ""
        self.tokens = 0
        self.cycles = 0
        self.last_seq = 0
        self.last_hash = ""
        self.adopted = ""       # set when the journal was started over a pre-journal workspace

    @property
    def models(self) -> dict[str, str]:
        raw = self.dims.get("models") or {}
        return dict(raw) if isinstance(raw, dict) else {}

    @property
    def budget(self) -> dict[str, str]:
        raw = self.dims.get("budget") or {}
        return dict(raw) if isinstance(raw, dict) else {}


class State:
    def __init__(self, ws: Path):
        self.ws = ws
        self.tasks: dict[str, Task] = {}
        self.stints: list[Stint] = []
        self.run = Run()
        self.events: list[dict] = []
        self.problems: list[str] = []
        self.meta: dict[str, str] = {}
        self.mail: list[Mail] = []
        self.learned: list[Learn] = []
        self.changes: list[Change] = []   # decisions and rails, in journal order
        self.acks: dict[str, int] = {}   # agent -> highest seq it has read (mail, learnings and changes share the watermark)
        self.run_checks: dict[str, dict[str, str]] = {}   # run-level checks (integration, final verification)

    def unread(self, agent: str) -> list[Mail]:
        """Mail an agent has not acked: direct, or broadcast from someone else."""
        seen = self.acks.get(agent, 0)
        return [m for m in self.mail if m.seq > seen and (m.to == agent or (m.to == "all" and m.sender != agent))]

    def receives(self, agent: str, L: Learn) -> bool:
        """Team scope: same dispatcher, the sender's lead, or the sender's own workers. The controller sees every learning."""
        if agent == L.agent:
            return False
        if agent == "controller":
            return True
        s = self.open_stint(agent, "")
        return bool(s) and (s.by == L.by or agent == L.by or s.by == L.agent)

    def unread_learn(self, agent: str) -> list[Learn]:
        seen = self.acks.get(agent, 0)
        return [L for L in self.learned if L.seq > seen and self.receives(agent, L)]

    def unread_changes(self, agent: str) -> list[Change]:
        """Decisions and rails recorded after this stint's dispatch (its brief snapshot predates them), not yet handed over."""
        if agent == "controller":
            return []
        s = self.open_stint(agent, "")
        if not s:
            return []
        seen = max(self.acks.get(agent, 0), s.seq)
        return [c for c in self.changes if c.seq > seen]

    def digest(self, agent: str) -> list:
        """Everything a checkpoint hands over, in one list: mail, learnings, record changes."""
        return [*self.unread(agent), *self.unread_learn(agent), *self.unread_changes(agent)]

    def stint_of(self, agent: str) -> Stint | None:
        for s in reversed(self.stints):
            if s.agent == agent:
                return s
        return None

    def lead_of(self, agent: str) -> str:
        """The agent whose instructions bind this one: its dispatcher (a lead in a tree), else the controller."""
        s = self.stint_of(agent)
        return s.by if s and s.by and s.by != agent else "controller"

    def resolve_to(self, sender: str, to: str) -> tuple[str, str]:
        """`controller` and `lead` are RELATIVE: a subtree worker's questions go to the lead that dispatched it
        (while that lead is open), so the controller never micromanages a subtree. Returns (recipient, note)."""
        if to in ("controller", "lead") and sender != "controller":
            lead = self.lead_of(sender)
            if lead != "controller":
                s = self.stint_of(lead)
                if s and not s.returned:
                    return lead, f"routed to your lead {lead} (it dispatched you; the controller sees it only if it goes stale)"
        return ("controller" if to == "lead" else to), ""

    def card_agent(self, t: Task) -> str:
        open_ = [s for s in self.stints if s.task == t.id and not s.returned]
        return open_[-1].agent if open_ else t.agent

    def derived_rails(self) -> list[str]:
        """Rails the record implies without anyone journaling them — stated, never silent."""
        d = self.run.dims
        out = []
        if str(d.get("isolation") or "") in ("off", "none") and str(d.get("strategy") or "") in ("parallel", "team", "hierarchical", "workflow"):
            out.append("shared tree (isolation=off): commit by path — git add <your files>, never -A")
        return out


    def task(self, tid: str) -> Task:
        return self.tasks.setdefault(str(tid), Task(str(tid)))

    def ordered(self) -> list[Task]:
        return sorted(self.tasks.values(), key=lambda t: natural_key(t.id))

    def open_stint(self, agent: str, task: str) -> Stint | None:
        for s in reversed(self.stints):
            if s.agent == agent and (not task or s.task == task) and not s.returned:
                return s
        return None

    def open_stints(self) -> list[Stint]:
        return [s for s in self.stints if not s.returned]

    @property
    def lanes(self) -> list[str]:
        """Declared lanes (run dim `lanes`, comma-separated) or the canonical columns."""
        raw = self.run.dims.get("lanes")
        names = [x.strip().lower().replace(" ", "_") for x in (raw.split(",") if isinstance(raw, str) else list(raw or []))]
        names = [x for x in names if x]
        if not names or not {"todo", "done", "blocked"} <= set(names):
            return list(COLUMNS)
        return names

    def lane_of(self, t: Task) -> str:
        """Project a card onto the declared lanes: canonical state, refined by the open stint's role."""
        lanes, s = self.lanes, t.state
        if s == "in_progress" and queued_after(self, t):
            return "todo"   # the wrapper is waiting for a dependency; the engine has not started
        if s in ("todo", "done", "blocked") or lanes == COLUMNS:
            return s
        open_ = [x for x in self.stints if x.task == t.id and not x.returned]
        role = open_[-1].role.lower() if open_ else ""
        want = ""
        for key, lane in LANE_OF_ROLE:
            if key in role:
                want = lane
                break
        if not want and any(c["status"] == "running" for c in t.checks.values()):
            want = "verify"
        if want in lanes:
            return want
        if s in lanes:
            return s
        base = "review" if s == "review" else "in_progress"
        alt = [l for l in lanes if LANE_BASE.get(l, l) == base]
        return alt[0] if alt else lanes[1]


def parse_ts(value: object) -> float:
    try:
        return dt.datetime.fromisoformat(str(value)).timestamp()
    except (TypeError, ValueError):
        return 0.0


def parse_tokens(value: object) -> int:
    if value is None:
        return 0
    s = str(value).strip().lower().replace(",", "")
    m = re.match(r"^(\d+(?:\.\d+)?)\s*([km]?)$", s)
    if not m:
        return 0
    return int(float(m.group(1)) * {"": 1, "k": 1_000, "m": 1_000_000}[m.group(2)])


def fmt_tokens(n: int) -> str:
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}m"
    if n >= 1_000:
        return f"{n // 1_000}k"
    return str(n)


def parse_kv(value: str | None) -> dict[str, str]:
    """'worker=sonnet,reviewer=opus' or 'worker:sonnet reviewer:opus' -> dict."""
    out: dict[str, str] = {}
    if not value:
        return out
    for part in re.split(r"[,\s]+", value.strip()):
        if not part:
            continue
        k, sep, v = re.split(r"([=:])", part, maxsplit=1) if re.search(r"[=:]", part) else (part, "", "")
        out[k.strip()] = v.strip() if sep else ""
    return out


def quorum(review: str, votes: list[tuple[str, str]]) -> str:
    """Derived gate text from votes: panel:N = majority of ok, consensus:N (and anything else) = any-deny."""
    m = re.match(r"(panel|consensus):(\d+)", review or "")
    n = int(m.group(2)) if m else max(len(votes), 1)
    majority = bool(m) and m.group(1) == "panel"
    ok = sum(1 for _, v in votes if v in ("ok", "warn"))
    deny = [a for a, v in votes if v == "fail"]
    if majority:
        if ok * 2 > n:
            return f"ok {ok}/{n}"
        if len(deny) * 2 >= n:
            return f"fail {ok}/{n} (deny: {', '.join(deny)})"
        return f".. {ok}/{n}"
    if deny:
        return f"fail {ok}/{n} (deny: {', '.join(deny)})"
    if ok >= n:
        return f"ok {ok}/{n}"
    return f".. {ok}/{n}"


def role_short(role: str) -> str:
    r = (role or "implementer").lower()
    return next((short for key, short in ROLE_SHORT if key in r), re.sub(r"[^a-z0-9]+", "", r) or "impl")


def agent_name(st: "State", task: str, role: str) -> str:
    """`<role>-<task>`, with `-rN` when that name already had a stint in this run (a re-dispatch is attempt N)."""
    base = f"{role_short(role)}-{task}"
    prior = sum(1 for s in st.stints if s.agent == base or re.fullmatch(re.escape(base) + r"-r\d+", s.agent))
    return base if not prior else f"{base}-r{prior + 1}"


def check_agent(name: str, st: "State", task: str, role: str) -> str:
    """Enforce the schema on an explicit name; suggest the derived one."""
    if name == "controller":
        sys.exit("board: `controller` is the controller's name, never an agent's")
    if not AGENT_RE.match(name):
        sys.exit(f"board: agent name {name!r} is not <role>-<task>[-tag] (impl-3, lead-1, impl-1.1, spec-3, fix-3-r2) — "
                 f"omit --agent to get {agent_name(st, task, role)!r}, or name it that way")
    return name


def role_tier(role: str) -> str:
    """Dispatch role -> model tier (the `models=` vocabulary)."""
    r = role.lower()
    if r in ("implementer", "integrator", "executor", "worker", "fix", "fixer") or "worker" in r or "implement" in r:
        return "worker"
    if "review" in r or "verif" in r or "judge" in r:
        return "reviewer"
    if "advis" in r:
        return "advisor"
    if "plan" in r or "reason" in r or "architect" in r:
        return "reasoner"
    if "orchestr" in r or "lead" in r:
        return "orchestrator"
    if "peer" in r or "counter" in r:
        return "peer"
    return r


def natural_key(tid: str):
    """1 < 2 < 3 < 3.1 < 3.2 < 4 — a sub-orchestrator's subtasks are dotted ids under their parent."""
    parts = tid.split(".")
    if parts and all(p.isdigit() for p in parts):
        return (0, tuple(int(p) for p in parts))
    return (1, tid)


CONTROL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f​-‏ -‮⁦-⁩]")


def clean(text: object) -> str:
    """Untrusted text (titles, notes, decisions) never reaches the terminal raw."""
    return CONTROL_RE.sub("", str(text)).replace("\n", " ").replace("\t", " ")


def title_from(path: Path) -> str:
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line:
                continue
            m = re.match(r"^#+\s*(?:Task\s+\S+\s*[:—-]\s*)?(.+)$", line)
            return clean((m.group(1) if m else line).strip()[:80])
    except OSError:
        pass
    return ""


def report_status(path: Path) -> tuple[str, str]:
    try:
        head = path.read_text(encoding="utf-8", errors="replace")[:2000]
    except OSError:
        return "", ""
    m = re.search(r"\b(DONE_WITH_CONCERNS|NEEDS_CONTEXT|BLOCKED|REFUSED|DONE)\b[ \t]*[—:-]?[ \t]*([^\n]*)", head)
    return (m.group(1), clean(m.group(2).strip())) if m else ("", "")


def review_verdict(path: Path) -> str:
    """The FIRST verdict mark in text order wins — a fail followed by a stray checkmark stays a fail."""
    try:
        head = path.read_text(encoding="utf-8", errors="replace")[:1500]
    except OSError:
        return ".."
    marks = [(head.find(m), t) for m, t in (("✅", "ok"), ("❌", "fail"), ("⚠", "warn")) if m in head]
    if marks:
        return min(marks)[1]
    words = []
    for tok, pat in (("ok", r"\b(pass|clean|approved)\b"), ("fail", r"\b(fail|reject|blocking)\w*")):
        m = re.search(pat, head, re.I)
        if m:
            words.append((m.start(), tok))
    return min(words)[1] if words else ".."


def load(ws: Path, journal_only: bool = False) -> State:
    """Derive the run. `journal_only` replays the journal cold (no disk facts) — `board check --replay`."""
    st = State(ws)
    get = st.task

    # 1. disk facts (artifact deltas are the only liveness signal)
    if ws.exists() and not journal_only:
        for p in ws.glob("task-*-brief.md"):
            m = re.match(r"task-(.+)-brief\.md$", p.name)
            if not m:
                continue
            t = get(m.group(1))
            t.title = t.title or title_from(p)
            t.candidates.append((p.stat().st_mtime, 0, "todo", "brief ready"))
            t.touch_artifact(p.stat().st_mtime)
        for p in ws.glob("card-*.md"):
            m = re.match(r"card-(.+)\.md$", p.name)
            if not m:
                continue
            t = get(m.group(1))
            t.title = t.title or title_from(p)
            t.candidates.append((p.stat().st_mtime, 0, "todo", "card ready"))
            t.touch_artifact(p.stat().st_mtime)
        for p in ws.glob("task-*-report.md"):
            m = re.match(r"task-(.+)-report\.md$", p.name)
            if not m:
                continue
            t = get(m.group(1))
            ts = p.stat().st_mtime
            status, reason = report_status(p)
            t.report = p.name
            if status in ("BLOCKED", "NEEDS_CONTEXT", "REFUSED"):
                t.candidates.append((ts, 0, "blocked", reason or status.lower().replace("_", " ")))
            else:
                t.candidates.append((ts, 0, "review", "report landed" + (" · concerns" if status == "DONE_WITH_CONCERNS" else "")))
            t.touch_artifact(ts)
        ledger = ws / "progress.md"
        if ledger.exists():
            for line in ledger.read_text(encoding="utf-8", errors="replace").splitlines():
                m = re.match(r"^\s*(?:Task|Card)\s+(\S+?):\s*(complete|merged|done|shipped)\b\s*(.*)$", line, re.I)
                if m:
                    t = get(m.group(1))
                    t.final = "done"
                    t.final_note = clean(m.group(3).strip(" ()") or m.group(2))
                elif re.match(r"^\s*Cycle\s+\d+\s*:", line, re.I):
                    st.run.cycles += 1
        raw = ws / "raw"
        if raw.exists():
            for p in raw.iterdir():
                m = re.search(r"task[-_ ]?(\d+)", p.name)
                if m and m.group(1) in st.tasks:
                    st.tasks[m.group(1)].touch_artifact(p.stat().st_mtime)
        dec = ws / "decisions.md"
        if dec.exists():
            for line in dec.read_text(encoding="utf-8", errors="replace").splitlines():
                m = re.match(r"^\s*[-*]?\s*(D-?\d+|[A-Z]+-\d+)\s*[:—-]\s*(.+)$", line)
                if m:
                    st.run.decisions.append({"id": m.group(1), "msg": clean(m.group(2).strip()), "src": "file"})

    # 2. journal (newest fact wins; ledger stays final)
    st.events, st.problems = read_events(ws)
    run = st.run
    for ev in st.events:
        seq = int(ev.get("seq", 0))
        run.last_seq, run.last_hash = seq, str(ev.get("hash", ""))
        ts = parse_ts(ev.get("ts"))
        kind = ev.get("ev", "")
        run.id = run.id or str(ev.get("run", ""))
        if kind == "run":
            run.dims = {k: ev[k] for k in DIMS if k in ev}
            run.kickoff = run.kickoff or ts
            run.branch, run.base = str(ev.get("branch", "")), str(ev.get("base", ""))
            continue
        if kind == "set":
            for k, v in (ev.get("dims") or {}).items():
                run.dims[k] = v
            run.plan, run.plan_msg = "pending", f"re-resolved {', '.join((ev.get('dims') or {}).keys())}"
            run.plan_trail.append(f"{hhmm(ts)} set {', '.join(f'{k}={v}' for k, v in (ev.get('dims') or {}).items())}")
            continue
        if kind == "plan":
            run.plan, run.plan_ts, run.plan_msg = str(ev.get("outcome", "")), ts, clean(ev.get("msg", ""))
            run.plan_trail.append(f"{hhmm(ts)} {run.plan}" + (f" ({run.plan_msg})" if run.plan_msg else ""))
            continue
        if kind == "rail":
            run.rails.append(clean(ev.get("msg", "")))
            st.changes.append(Change(ev, ts, False))
            continue
        if kind == "learn":
            L = Learn(ev, ts)
            st.learned.append(L)
            s = st.open_stint(L.agent, "")
            if s:
                s.learned += 1
                s.heartbeat_ts = max(s.heartbeat_ts, ts)
            continue
        if kind == "adopt":
            run.adopted = clean(ev.get("msg", "")) or "adopted"
            continue
        if kind == "mail":
            m = Mail(ev, ts)
            st.mail.append(m)
            s = st.open_stint(m.sender, "")
            if s:
                s.sent += 1
                s.heartbeat_ts = max(s.heartbeat_ts, ts)
            continue
        if kind == "ack":
            a = str(ev.get("agent", ""))
            st.acks[a] = max(st.acks.get(a, 0), int(ev.get("upto") or 0))
            continue
        if kind == "decide":
            revised = any(d["id"] == ev.get("id") and d.get("src") == "journal" for d in run.decisions)   # the file mirror is not a prior
            run.decisions = [d for d in run.decisions if d["id"] != ev.get("id")]
            run.decisions.append({"id": str(ev.get("id", "")), "msg": clean(ev.get("msg", "")), "why": clean(ev.get("why", "")),
                                  "owner": str(ev.get("owner", "")), "task": str(ev.get("task", "")), "src": "journal", "seq": seq})
            st.changes.append(Change(ev, ts, revised))
            continue
        if kind == "finish":
            run.finish, run.finish_evidence, run.finish_ts = str(ev.get("gate", "")), str(ev.get("evidence", "")), ts
            run.finish_seq, run.finish_head, run.finish_goal = seq, str(ev.get("head", "")), str(ev.get("goal_hash", ""))
            continue
        tid = ev.get("task")
        if tid is None:
            continue
        if kind == "check" and (str(tid) in ("run", "-", "") or (str(tid) not in st.tasks and not any(
                e.get("task") == tid and e.get("ev") in ("todo", "dispatch") for e in st.events))):
            st.run_checks[clean(ev.get("name", "check")) or "check"] = {"status": str(ev.get("status", "")), "exit": str(ev.get("exit", "")),
                                                                        "dur": str(ev.get("dur", "")), "log": str(ev.get("log", ""))}
            continue
        t = get(str(tid))
        if ev.get("title"):
            t.title = clean(str(ev["title"])[:80])
        if kind == "todo":
            t.candidates.append((ts, seq, "todo", clean(ev.get("msg", "queued"))))
        elif kind == "dispatch":
            if role_tier(str(ev.get("role") or "implementer")) == "worker":
                t.attempt += 1  # a new implementer attempt starts a fresh review cycle
            t.candidates.append((ts, seq, "in_progress", clean(ev.get("msg", ""))))
            t.agent, t.model, t.engine = ev.get("agent", ""), ev.get("model", ""), ev.get("engine", "")
            t.since, t.dispatched, t.returned = ts, True, False
            st.stints.append(Stint(ev, ts, t.attempt))
        elif kind == "return":
            status = str(ev.get("status", "DONE"))
            prior = next((s_ for s_ in reversed(st.stints) if s_.agent == str(ev.get("agent", "")) and s_.task == str(tid)), None)
            if prior and prior.returned and str(ev.get("status", "")) == prior.status:
                # receipt amendment: same agent, same task, same status — attach what the first return lacked
                if ev.get("tokens"):
                    prior.tokens = parse_tokens(ev.get("tokens"))
                prior.observed = str(ev.get("observed_model") or prior.observed)
                prior.session = str(ev.get("session") or prior.session)
                t.touch_heartbeat(ts)
                continue
            t.last_status = status
            if status in ("BLOCKED", "NEEDS_CONTEXT", "REFUSED"):
                t.candidates.append((ts, seq, "blocked", clean(ev.get("msg", "")) or status.lower().replace("_", " ")))
            else:
                t.candidates.append((ts, seq, "review", "returned" + (" · concerns" if status == "DONE_WITH_CONCERNS" else "")))
            t.returned = True
            t.report = str(ev.get("report") or t.report)
            s = st.open_stint(str(ev.get("agent", "")), str(tid))
            if s:
                s.returned, s.status = ts, status
                s.session = str(ev.get("session") or s.session)
                s.observed = str(ev.get("observed_model", ""))
                s.tokens = parse_tokens(ev.get("tokens")) or s.tokens   # a receipt may already have landed
                s.commits, s.report = str(ev.get("commits", "")), str(ev.get("report", ""))
                s.reported = str(ev.get("reported", ""))
                if s.observed:
                    run.observed[s.role if s.role in run.models else role_tier(s.role)] = s.observed
                    if s.model and s.observed != s.model:
                        run.drift.append(f"task {s.task} {s.agent}: requested {s.model}, observed {s.observed}")
        elif kind == "review":
            t.candidates.append((ts, seq, "review", clean(ev.get("msg", ""))))
            rnd = ev.get("round")
            t.gate_entries.append((ts, t.attempt, str(ev.get("kind", "review")), f".. r{rnd}" if rnd else ".."))
            if ev.get("agent"):
                t.agent, t.model, t.engine = ev.get("agent", ""), ev.get("model", ""), ev.get("engine", "")
                t.since = ts
                rev = dict(ev, role=ev.get("role") or f"{ev.get('kind', 'review')} reviewer")
                st.stints.append(Stint(rev, ts, t.attempt))
        elif kind == "gate":
            rnd = ev.get("round")
            t.gate_entries.append((ts, t.attempt, str(ev.get("kind", "review")),
                                   f"{ev.get('verdict', '..')}" + (f" r{rnd}" if rnd else "")))
            t.candidates.append((ts, seq, "review", f"{ev.get('kind')} {ev.get('verdict')}"))
            for s in st.stints:
                if s.task == str(tid) and not s.returned and s.role.startswith(str(ev.get("kind", "?"))):
                    s.returned, s.status = ts, str(ev.get("verdict", "")).upper()
        elif kind == "nudge":
            s = st.open_stint(str(ev.get("agent", "")), str(tid))
            if s:
                s.nudges += 1
        elif kind == "escalate":
            s = st.open_stint(str(ev.get("agent", "")), str(tid))
            if s:
                s.escalated_to = str(ev.get("to", ""))
            t.escalations += 1
            t.note = clean(f"escalate -> {ev.get('to', '?')}: {ev.get('why', '')}").strip(": ")
        elif kind == "check":
            t.check_entries.append((ts, t.attempt, clean(ev.get("name", "check")) or "check", str(ev.get("status", "")),
                                    str(ev.get("exit", "")), str(ev.get("dur", "")), str(ev.get("log", ""))))
        elif kind == "exit":
            s = st.stint_of(str(ev.get("agent", "")))
            if s and s.task == str(tid):
                s.exit_code, s.exited = int(ev.get("exit") or 0), ts
        elif kind == "receipt":
            s = st.stint_of(str(ev.get("agent", "")))
            if s and s.task == str(tid):
                s.tokens = parse_tokens(ev.get("tokens")) or s.tokens
                s.calls = int(ev.get("calls") or s.calls)
                s.cost = float(ev.get("cost") or s.cost)
                s.session = str(ev.get("session") or s.session)
        elif kind == "vote":
            kind_, agent_ = str(ev.get("kind") or "approve"), str(ev.get("agent", ""))
            t.vote_entries.append((ts, t.attempt, kind_, agent_, str(ev.get("verdict", "")).lower(), clean(ev.get("why", ""))))
            rnd = ev.get("round")
            t.gate_entries.append((ts, t.attempt, kind_, quorum(str(run.dims.get("review") or ""), t.votes(kind_)) + (f" r{rnd}" if rnd else "")))
            for s in st.stints:
                if s.task == str(tid) and s.agent == agent_ and not s.returned:
                    s.returned, s.status = ts, str(ev.get("verdict", "")).upper()
        elif kind == "done":
            t.candidates.append((ts, seq, "done", clean(ev.get("msg", ""))))
        elif kind == "blocked":
            t.candidates.append((ts, seq, "blocked", clean(ev.get("msg", ""))))
        if ev.get("msg") and kind not in ("escalate", "check"):
            t.note = clean(ev["msg"])
        t.touch_heartbeat(ts)
        s = st.open_stint(str(ev.get("agent", "")), str(tid)) if ev.get("agent") else None
        if s:
            s.heartbeat_ts = max(s.heartbeat_ts, ts)

    # 3. findings files on disk close review stints and carry verdicts (attempt = current at their mtime)
    if ws.exists() and not journal_only:
        for p in sorted(ws.glob("review-task*-r*.md")):
            m = re.match(r"review-task(.+?)-(.+)-r(\d+)\.md$", p.name)
            if not m:
                continue
            t = get(m.group(1))
            ts = p.stat().st_mtime
            attempt = max([s.attempt for s in st.stints if s.task == t.id and s.started <= ts] or [1])
            explicit = any(k == m.group(2) and text.split()[-1] == f"r{m.group(3)}" and not text.startswith("..")
                           for _, _, k, text in t.gate_entries)
            if not explicit:
                t.gate_entries.append((ts, attempt, m.group(2), f"{review_verdict(p)} r{m.group(3)}"))
            t.candidates.append((ts, 0, "review", "findings filed"))
            t.findings.append(p.name)
            t.touch_artifact(ts)
            for s in st.stints:
                if s.task == t.id and not s.returned and s.role.startswith(m.group(2)) and s.started <= ts:
                    s.returned, s.status = ts, review_verdict(p).upper()
                    break

    run.tokens = sum(s.tokens for s in st.stints)   # receipts and returns both feed it; count each stint once
    st.meta = run_meta(ws, run)
    return st


def run_meta(ws: Path, run: Run) -> dict:
    meta: dict[str, str] = {}
    runmd = ws / "run.md"
    if runmd.exists() and not run.dims:  # runs kicked off without `board init` flags: loose parse
        text = runmd.read_text(encoding="utf-8", errors="replace")[:6000]
        for key in ("strategy", "host", "engine", "review", "isolation"):
            tail = r"(?: [A-Za-z0-9]+)?" if key == "host" else ""
            m = re.search(rf"\b{key}\s*[=:]\s*`?([A-Za-z0-9:._/-]+{tail})", text, re.I)
            if m:
                meta[key] = m.group(1).strip("`")
    for key in ("strategy", "host", "engine", "review", "isolation", "trigger", "alias"):
        if run.dims.get(key):
            meta[key] = str(run.dims[key])
    if run.kickoff:
        meta["started"] = str(run.kickoff)
    elif runmd.exists():
        meta["started"] = str(runmd.stat().st_ctime)
    meta["branch"] = run.branch or git("rev-parse", "--abbrev-ref", "HEAD")
    meta["repo"] = ws.parent.name
    return meta


# --- run.md Resolved block -------------------------------------------------------------

OPEN, CLOSE = "<!-- board:resolved -->", "<!-- /board:resolved -->"


def resolved_block(st: State) -> str:
    run = st.run
    d = run.dims

    def kv(*keys: str) -> str:
        return " · ".join(f"{k}: {d.get(k) or '-'}" for k in keys)

    models = " ".join(f"{k}={v}" for k, v in run.models.items()) or "-"
    effort = d.get("effort")
    effort = " ".join(f"{k}={v}" for k, v in effort.items()) if isinstance(effort, dict) else (effort or "-")
    budget = " ".join(f"{k}={v}" for k, v in run.budget.items()) or "-"
    lines = ["## Resolved", f"run: {run.id}" + (f" · branch {run.branch}" if run.branch else "") + (f" · base {run.base[:7]}" if run.base else ""),
             f"goal: {d.get('goal') or '-'}", kv("strategy", "review", "engine", "host"),
             f"models: {models} · effort: {effort}", kv("isolation", "trigger", "workers", "confirm", "alias"),
             f"budget: {budget}"]
    if d.get("lanes"):
        lines.append(f"lanes: {d['lanes']}")
    if run.plan and run.plan != "pending":
        when = dt.datetime.fromtimestamp(run.plan_ts).isoformat(timespec="minutes") if run.plan_ts else ""
        lines.append(f"plan: {run.plan} {when}" + (f" ({run.plan_msg})" if run.plan_msg else ""))
    else:
        lines.append("plan: pending" + (f" ({run.plan_msg})" if run.plan_msg else ""))
    if len(run.plan_trail) > 1:
        lines.append("plan-trail: " + " → ".join(run.plan_trail))
    if run.observed:
        lines.append("observed: " + " ".join(
            f"{role}={obs}" + (f" (requested {run.models[role]})" if run.models.get(role) and run.models[role] != obs else "")
            for role, obs in run.observed.items()))
    for d_ in run.drift:
        lines.append(f"drift: {d_}")
    for rail in run.rails:
        lines.append(f"rails: {rail}")
    if run.finish:
        lines.append(f"finish: final gate {run.finish}" + (f" · evidence {run.finish_evidence}" if run.finish_evidence else "") +
                     (f" · head {run.finish_head[:7]}" if run.finish_head else ""))
    if run.kickoff:
        lines.append("kickoff: " + dt.datetime.fromtimestamp(run.kickoff).isoformat(timespec="seconds"))
    return "\n".join(lines)


def write_resolved(ws: Path) -> None:
    st = load(ws)
    if not st.run.dims:
        return
    block = f"{OPEN}\n{resolved_block(st)}\n{CLOSE}\n"
    runmd = ws / "run.md"
    text = runmd.read_text(encoding="utf-8") if runmd.exists() else ""
    if OPEN in text and CLOSE in text:
        pre, rest = text.split(OPEN, 1)
        _, post = rest.split(CLOSE, 1)
        text = pre + block.rstrip("\n") + post
    else:
        text = block + ("\n" + text if text else "")
    atomic_write(runmd, text)


# --- rendering (raw ANSI, capability-aware palette, stdlib only) ---------------------------

RGB = {"todo": (128, 138, 156), "in_progress": (62, 142, 247), "review": (245, 165, 36),
       "done": (48, 164, 108), "blocked": (180, 85, 232),
       "implement": (62, 142, 247), "verify": (32, 178, 170), "integrate": (120, 130, 250), "advise": (150, 150, 160)}
OK, WARN, BAD = (48, 164, 108), (245, 165, 36), (229, 72, 77)
ANSI16 = {"todo": "90", "in_progress": "34", "review": "33", "done": "32", "blocked": "35",
          "implement": "34", "verify": "36", "integrate": "34", "advise": "37"}
MARGIN = 2  # left/right page margin
# braille "dots" spinner (the cli-spinners default) with a plain |/-\ fallback for ascii/non-utf
# terminals — both are well-worn picks from https://stackoverflow.com/questions/2685435
SPIN_FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
SPIN_FRAMES_ASCII = "|/-\\"
BOLD, DIM, REV, RESET = "\033[1m", "\033[2m", "\033[7m", "\033[0m"
Row = list  # list[tuple[str, str]] — (text, sgr) segments; sgr "" = terminal default


class Style:
    """Palette profile: truecolor / 256 / 16 / none, and box glyphs (unicode or ASCII)."""

    def __init__(self, color: bool = True):
        self.profile = "none"
        if color:
            ct = os.environ.get("COLORTERM", "").lower()
            term = os.environ.get("TERM", "")
            self.profile = "rgb" if ct in ("truecolor", "24bit") else "256" if "256" in term else "16"
        loc = (os.environ.get("LC_ALL") or os.environ.get("LC_CTYPE") or os.environ.get("LANG") or "utf").lower()
        self.ascii = bool(os.environ.get("BOARD_ASCII")) or "utf" not in loc
        g = self.ascii
        self.tl, self.tr, self.bl, self.br = ("+", "+", "+", "+") if g else ("╭", "╮", "╰", "╯")
        self.h, self.v = ("-", "|") if g else ("─", "│")
        self.arrow, self.dot = ("->", "*") if g else ("→", "·")

    def fg(self, rgb: tuple[int, int, int], col: str = "") -> str:
        if self.profile == "rgb":
            return f"\033[38;2;{rgb[0]};{rgb[1]};{rgb[2]}m"
        if self.profile == "256":
            r, g, b = (round(c / 255 * 5) for c in rgb)
            return f"\033[38;5;{16 + 36 * r + 6 * g + b}m"
        if self.profile == "16":
            if col:
                return f"\033[{ANSI16.get(col, '0')}m"
            return "\033[32m" if rgb == OK else "\033[33m" if rgb == WARN else "\033[31m" if rgb == BAD else ""
        return ""

    def col(self, name: str) -> str:
        key = name if name in RGB else LANE_BASE.get(name, "in_progress")
        return self.fg(RGB[key], key)


def cw(ch: str) -> int:
    if unicodedata.combining(ch) or ch in ("‍", "️"):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def dw(text: str) -> int:
    return sum(cw(c) for c in text)


def clip(text: str, width: int) -> str:
    if dw(text) <= width:
        return text
    out, used = [], 0
    for ch in text:
        w = cw(ch)
        if used + w > width - 1:
            break
        out.append(ch)
        used += w
    return "".join(out) + "~"


def pad(text: str, width: int) -> str:
    return text + " " * max(0, width - dw(text))


def fmt_dur(seconds: float) -> str:
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m{seconds % 60:02d}s"
    return f"{seconds // 3600}h{(seconds % 3600) // 60:02d}m"


def hhmm(ts: float) -> str:
    return dt.datetime.fromtimestamp(ts).strftime("%H:%M") if ts else ""


def queued_after(st: "State", t: Task) -> list[str]:
    """The dependencies a gated lane is still sleeping on (its wrapper is waiting; the engine has not started)."""
    for x in st.stints:
        if x.task == t.id and not x.returned and x.after and x.exit_code is None and \
                not all(dep_landed(st, st.tasks[d]) for d in x.after if d in st.tasks):
            return x.after
    return []


def is_stale(t: Task, now: float) -> bool:
    return t.state == "in_progress" and now - t.last_activity > STALE_AFTER


def stint_stale(s: Stint, t: Task | None, now: float) -> bool:
    last = max(s.started, t.artifact_ts if t else 0.0)
    return not s.returned and now - last > STALE_AFTER


def attention(st: State, now: float) -> list[tuple[str, Task, str]]:
    """(marker, task, why) for every card a controller should act on, most urgent first."""
    out = []
    for t in st.ordered():
        s = t.state
        if s == "blocked":
            out.append(("x", t, t.note or t.detail or "blocked — needs owner + next action"))
        elif s != "done" and t.failed_checks:
            c = t.checks[t.failed_checks[0]]
            out.append(("x", t, f"{', '.join(t.failed_checks)} check failed (exit {c['exit'] or '?'}) — fix, re-run"
                        + (f" · {c['log']}" if c["log"] else "")))
        elif s == "in_progress" and any(x.task == t.id and not x.returned and x.exit_code is not None for x in st.stints):
            x = [x for x in st.stints if x.task == t.id and not x.returned and x.exit_code is not None][-1]   # the newest lane
            if x.exit_code == 125:
                out.append(("x", t, f"lane {x.agent} never started — dependency task {', '.join(x.after) or '?'} cannot land; "
                            f"board return {t.id} --agent {x.agent} --status BLOCKED --msg \"dependency failed\", fix it, relaunch"))
            elif x.exit_code == 0 and not (st.ws / f"task-{t.id}-report.md").exists() and not t.report:
                out.append(("!", t, f"lane {x.agent} exited rc=0 but no task-{t.id}-report.md here — a worktree lane writes a RELATIVE report path "
                            f"into its own cwd (observed live); look there, then board return --report <path>; brief report paths must be absolute"))
            else:
                out.append(("!" if x.exit_code == 0 else "x", t, f"lane {x.agent} exited rc={x.exit_code} with no return — read the report, then board return"))
        elif s == "in_progress" and queued_after(st, t):
            pass  # the wrapper is waiting for a dependency; the model has not started — nothing to nudge
        elif s == "in_progress" and is_stale(t, now):
            out.append(("!", t, f"no artifact delta for {fmt_dur(now - t.last_activity)} — disk check, then ONE nudge"))
        elif s == "review":
            pend = [k for k, v in t.gates.items() if v.startswith("..")]
            failed = [k for k, v in t.gates.items() if v.startswith("fail")]
            if failed:
                out.append(("x", t, f"{', '.join(failed)} gate failed — fix wave, then re-review"))
            elif pend:
                rs = [x for x in st.open_stints() if x.task == t.id and x.role.endswith("reviewer")]
                if rs and stint_stale(rs[-1], t, now):
                    out.append(("!", t, f"{pend[0]} reviewer silent {fmt_dur(now - rs[-1].started)} — findings file missing"))
                else:
                    out.append(("?", t, f"{', '.join(pend)} gate pending"))
            elif not t.gates:
                out.append(("?", t, "report landed — dispatch the review"))
        elif s == "in_progress" and t.last_status == "DONE_WITH_CONCERNS":
            out.append(("?", t, "returned with concerns — read the report first"))
        if s != "done" and t.attempt >= 3 and not t.escalations:
            out.append(("!", t, f"attempt {t.attempt} with no escalation — capability before retry (routing rule 4)"))
    for m in st.unread("controller"):
        tid = (st.stint_of(m.sender).task if st.stint_of(m.sender) else "")
        t = st.tasks.get(tid)
        if t is None:
            continue
        if m.ask:
            out.append(("?", t, f"question #{m.seq} from {m.sender}: {m.msg} — answer: board send --from controller --to {m.sender} --re {m.seq} \"…\""))
        else:
            out.append(("?", t, f"mail #{m.seq} from {m.sender}: {m.msg} — board inbox --agent controller"))
    for m in st.mail:   # a subtree's asks are the lead's to answer — until the lead goes quiet on one
        if m.ask and m.to not in ("controller", "all") and st.acks.get(m.to, 0) < m.seq and now - m.ts > STALE_AFTER:
            s_ = st.stint_of(m.sender)
            t = st.tasks.get(s_.task) if s_ else None
            if t is not None:
                out.append(("!", t, f"lead {m.to} has not read question #{m.seq} from {m.sender} for {fmt_dur(now - m.ts)} — nudge the lead, "
                            f"or answer it: board send --from controller --to {m.sender} --re {m.seq} \"…\""))
    order = {"x": 0, "!": 1, "?": 2}
    return sorted(out, key=lambda x: (order[x[0]], natural_key(x[1].id)))


def check_badges(t: Task, S: Style) -> Row:
    """`tests ok 12s · lint fail` — the current attempt's named checks, GitHub-checks style, on the card."""
    segs: Row = []
    for name, c in t.checks.items():
        segs.append((f" {S.dot} ", DIM))
        mark = "ok" if c["status"] == "ok" else "fail" if c["status"] == "fail" else ".."
        colour = S.fg(OK) if mark == "ok" else S.fg(BAD) if mark == "fail" else S.fg(WARN)
        segs += [(f"{name} ", DIM), (mark, colour)]
        if mark == "ok" and c["dur"]:
            segs.append((f" {c['dur']}", DIM))
    return segs


def mail_badge(t: Task, st_: "State", S: Style) -> Row:
    """`m2` — unread mail waiting for the card's open agent."""
    agent = st_.card_agent(t)
    if not agent or t.state == "done":
        return []
    n_ = len(st_.unread(agent))
    return [(f" {S.dot} ", DIM), (f"m{n_}", S.fg(WARN))] if n_ else []


def card_who(t: Task, st: "State") -> tuple[str, list[str]]:
    """(agent, deviations) — the agent responsible right now: the newest open stint, else the last returned one.
    Deviations are the only per-card facts worth a line: a model or engine that differs from the run's defaults."""
    mine = [s for s in st.stints if s.task == t.id]
    if not mine:
        return "", []
    open_ = [s for s in mine if not s.returned]
    s = open_[-1] if open_ else mine[-1]
    dev: list[str] = []
    tier = st.run.models.get(s.role if s.role in st.run.models else role_tier(s.role))
    if s.model and tier and s.model != tier:
        dev.append(s.model)
    eng = str(st.run.dims.get("engine") or "claude")
    if s.engine and (eng == "mixed" or s.engine != eng):
        dev.append(s.engine)
    return s.agent, dev


def children(st: "State", t: Task) -> list[Task]:
    return [x for x in st.ordered() if x.id.startswith(t.id + ".")]


def card_signal(t: Task, st: "State", now: float, S: Style) -> Row:
    """One signal per state, glyph first when the controller must act: ~ queued · > running · ! look · ? decide · x failed."""
    d = f" {S.dot} "
    state = t.state
    badges = (check_badges(t, S) if state in ("todo", "in_progress", "review") else []) + mail_badge(t, st, S)
    if state == "in_progress" and queued_after(st, t):
        return [("~ ", S.fg(WARN) + BOLD), (f"after {', '.join(queued_after(st, t))}", S.fg(WARN))] + badges
    if state == "todo":
        return [(t.detail or "queued", DIM)] + badges
    if state == "in_progress":
        exited = [x for x in st.stints if x.task == t.id and not x.returned and x.exit_code is not None]
        if exited:
            x = exited[-1]
            if x.exit_code == 125:
                return [("x ", S.fg(BAD) + BOLD), (f"never started{d}dependency {', '.join(x.after) or '?'} failed", S.fg(BAD))] + badges
            if x.exit_code == 0:
                has = (st.ws / f"task-{t.id}-report.md").exists() or bool(t.report)
                return [("! ", S.fg(WARN) + BOLD), (f"exited rc=0{d}" + ("report on disk" if has else "no report here"), S.fg(WARN))] + badges
            return [("x ", S.fg(BAD) + BOLD), (f"exited rc={x.exit_code}", S.fg(BAD))] + badges
        agent = st.card_agent(t)
        asked = [m for m in st.unread("controller") if m.ask and m.sender == agent]
        elapsed = fmt_dur(now - t.since) if t.since else ""
        kids = children(st, t)
        lead = f"{sum(1 for k in kids if dep_landed(st, k))}/{len(kids)} landed{d}" if kids else ""
        if asked:
            return [("? ", S.fg(WARN) + BOLD), (f"asked you #{asked[0].seq}{d}{fmt_dur(now - asked[0].ts)}", S.fg(WARN))] + badges
        if is_stale(t, now):
            return [("! ", S.fg(WARN) + BOLD), (f"{lead}stale {fmt_dur(now - t.last_activity)}", S.fg(WARN))] + badges
        return [("> ", S.fg(OK) + BOLD), (f"{lead}{elapsed}", DIM)] + badges
    if state == "review":
        segs: Row = []
        for k, v in t.gates.items():
            if segs:
                segs.append((d, DIM))
            mark, _, rnd = v.partition(" ")
            colour = S.fg(OK) if mark == "ok" else S.fg(BAD) if mark == "fail" else S.fg(WARN) if mark == "warn" else DIM
            segs += [(f"{k} ", DIM), (mark, colour), (f" {rnd}" if rnd else "", DIM)]
        if not t.gates:
            segs = [("? ", S.fg(WARN) + BOLD), ("returned" + (f"{d}concerns" if t.last_status == "DONE_WITH_CONCERNS" else "") + f"{d}dispatch the review", DIM)]
        elif any(v.startswith("fail") for v in t.gates.values()):
            segs = [("x ", S.fg(BAD) + BOLD)] + segs
        else:
            rs = [x for x in st.open_stints() if x.task == t.id and x.role.endswith("reviewer")]
            if rs and stint_stale(rs[-1], t, now):
                segs = [("! ", S.fg(WARN) + BOLD)] + segs + [(f"{d}reviewer silent {fmt_dur(now - rs[-1].started)}", S.fg(WARN))]
        return segs + badges
    if state == "done":
        accepted = next((s for s in reversed(st.stints) if s.task == t.id and s.returned and s.commits), None)
        text_ = accepted.commits if accepted else (t.final_note or t.note or t.detail or "complete")
        concerns = f"{d}concerns" if accepted and accepted.status == "DONE_WITH_CONCERNS" else ""
        return [(text_, DIM), (concerns, DIM)] + mail_badge(t, st, S)
    if state == "blocked":
        return [("x ", S.fg(BAD) + BOLD), ((t.note or t.detail or "blocked"), S.col("blocked"))]
    return [(t.detail or "", DIM)] + badges


def card_meta(t: Task, now: float, S: Style, narrow: bool, st_: "State | None" = None) -> Row:
    """Compatibility: the card's signal column."""
    return card_signal(t, st_, now, S) if st_ is not None else [(t.detail or "", DIM)]


def row_text(row: Row) -> str:
    return "".join(t for t, _ in row)


def row_render(row: Row, color: bool) -> str:
    if not color:
        return row_text(row)
    return "".join((sgr + t + RESET) if sgr else t for t, sgr in row)


def wrap_segs(segs: Row, width: int, dot: str) -> list[Row]:
    """Wrap styled segments at separator boundaries into lines no wider than `width`."""
    sep = f" {dot} "
    pieces: Row = []
    for text, sgr in segs:
        parts = re.split(f"({re.escape(sep)})", text)
        pieces += [(part, sgr) for part in parts if part]
    lines: list[Row] = []
    cur: Row = []
    used = 0
    for text, sgr in pieces:
        w = dw(text)
        if cur and used + w > width:
            if cur[-1][0] == sep:
                cur.pop()
            lines.append(cur)
            cur, used = [], 0
            if text == sep:
                continue
        cur.append((clip(text, width) if w > width else text, sgr))
        used += min(w, width)
    if cur:
        lines.append(cur)
    return lines or [[]]


def card_details(t: Task, st: State, now: float, S: Style) -> list[tuple[str, Row]]:
    """Expanded view: the card's lineage — agents, gates, files, decisions, last note, next action."""
    out: list[tuple[str, Row]] = []
    d = S.dot
    for s in [x for x in st.stints if x.task == t.id]:
        segs: Row = [(s.agent, BOLD), (f" {d} {s.role} {d} ", DIM), (s.model or "-", "")]
        if s.observed and s.observed != s.model:
            segs.append((f" (observed {s.observed} !)", S.fg(WARN)))
        if s.engine and s.engine != "claude":
            segs.append((f" {d} {s.engine}", DIM))
        if s.effort:
            segs.append((f" @ {s.effort}", DIM))
        window = f"{hhmm(s.started)} {S.arrow} {hhmm(s.returned) if s.returned else '…'}"
        segs.append((f" {d} {window} {d} {fmt_dur((s.returned or now) - s.started)}", DIM))
        if s.status:
            colour = S.fg(OK) if s.status in ("DONE", "OK") else S.fg(BAD) if s.status in ("BLOCKED", "FAIL", "REFUSED") else S.fg(WARN)
            segs += [(f" {d} ", DIM), (s.status.lower().replace("_", " "), colour)]
        elif not s.returned:
            stale = stint_stale(s, t, now)
            segs += [(f" {d} ", DIM), ("stale" if stale else "running", S.fg(WARN) if stale else S.fg(OK))]
        if s.tokens:
            segs.append((f" {d} {fmt_tokens(s.tokens)}", DIM))
        if s.nudges:
            segs.append((f" {d} nudged x{s.nudges}", S.fg(WARN)))
        if s.escalated_to:
            segs.append((f" {d} escalated {S.arrow} {s.escalated_to}", S.fg(WARN)))
        if s.worktree:
            segs.append((f" {d} {s.worktree}", DIM))
        if s.owns:
            segs.append((f" {d} owns {s.owns}", DIM))
        if s.calls:
            segs.append((f" {d} {s.calls} calls", DIM))
        if s.cost:
            segs.append((f" {d} ${s.cost:.2f}", DIM))
        if s.exit_code is not None:
            segs.append((f" {d} exit {s.exit_code}", S.fg(OK) if s.exit_code == 0 else S.fg(BAD)))
        out.append(("attempt" if role_tier(s.role) == "worker" else "review", segs))
    for x in [L for L in st.learned if L.task == t.id]:
        out.append(("learned", [(f"[{x.kind}] ", DIM), (x.agent, BOLD), (f" {d} {x.msg}", "")] + ([(f" ({x.path})", DIM)] if x.path else [])))
    if t.gates:
        segs = []
        for k, v in t.gates.items():
            if segs:
                segs.append((f" {d} ", DIM))
            mark, _, rnd = v.partition(" ")
            colour = S.fg(OK) if mark == "ok" else S.fg(BAD) if mark == "fail" else S.fg(WARN) if mark == "warn" else DIM
            segs += [(f"{k} ", DIM), (mark if mark != ".." else "pending", colour), (f" {rnd}" if rnd else "", DIM)]
        if t.attempt > 1:
            segs.append((f" {d} attempt {t.attempt}", DIM))
        out.append(("gates", segs))
    if t.checks:
        segs = []
        for name, c in t.checks.items():
            if segs:
                segs.append((f" {d} ", DIM))
            colour = S.fg(OK) if c["status"] == "ok" else S.fg(BAD) if c["status"] == "fail" else S.fg(WARN)
            segs += [(f"{name} ", DIM), (c["status"], colour)]
            if c["exit"] != "":
                segs.append((f" exit {c['exit']}", DIM))
            if c["dur"]:
                segs.append((f" {c['dur']}", DIM))
            if c["log"]:
                segs.append((f" {c['log']}", DIM))
        out.append(("checks", segs))
    agents_ = {s.agent for s in st.stints if s.task == t.id}
    thread = [m for m in st.mail if m.sender in agents_ or m.to in agents_]
    if thread:
        last = thread[-1]
        segs = [(f"{len(thread)} msg", DIM), (f" {d} last #{last.seq} ", DIM), (f"{last.sender} {S.arrow} {last.to}", ""),
                (" ask" if last.ask else "", S.fg(WARN)), (f": {last.msg}", DIM)]
        out.append(("mail", segs))
    if t.votes("approve") or any(k == "approve" for k in t.gates):
        pass  # votes surface through the gates row (quorum text)
    lanes = [s for s in st.stints if s.task == t.id and (s.session or s.log)]
    if lanes:
        segs = []
        for s in lanes:
            if segs:
                segs.append((f" {d} ", DIM))
            segs += [(s.agent, DIM), (f" session {s.session}" if s.session else "", ""), (f" log {s.log}" if s.log else "", DIM)]
        out.append(("lane", segs))
    files = ([t.report] if t.report else []) + t.findings
    if files:
        out.append(("evidence", [(f" {d} ".join(files), DIM)]))
    decs = [x for x in st.run.decisions if x.get("task") == t.id]
    if decs:
        out.append(("decisions", [(f" {d} ".join(f"{x['id']} {x['msg']}" for x in decs), DIM)]))
    if t.note and t.state != "blocked":
        out.append(("last", [(t.note, DIM)]))
    act = next((why for _, x, why in attention(st, now) if x.id == t.id), "")
    if act:
        out.append(("action", [(act, S.fg(WARN))]))
    return out


def header_rows(st: State, W: int, now: float, S: Style) -> list[Row]:
    run, meta, m, d = st.run, st.meta, " " * MARGIN, S.dot
    rows: list[Row] = [[]]
    counts = {c: 0 for c in COLUMNS}
    for t in st.tasks.values():
        counts[t.state] += 1
    elapsed = fmt_dur(now - float(meta["started"])) if meta.get("started") else ""
    right = f"{counts['done']}/{len(st.tasks)} done" + (f"  {d}  {elapsed}" if elapsed else "")
    here = git("rev-parse", "--abbrev-ref", "HEAD")
    where = meta.get("repo", "") + (f" @ {meta['branch']}" if meta.get("branch") else "") + \
        (f" (you: {here})" if meta.get("branch") and here and here != meta["branch"] else "")
    left = "ORCHESTRATE"
    gap = W - dw(left) - 3 - dw(where) - dw(right)
    rows.append([(m + left, BOLD), ("   " + clip(where, max(0, W - dw(left) - 3 - dw(right) - 2)), ""),
                 (" " * max(2, gap), ""), (right, BOLD)])
    if run.finish:
        invalid = finish_invalid(st)
        if run.finish == "pass":
            colour, label = (S.fg(WARN), "RUN COMPLETE (STALE)") if invalid else (S.fg(OK), "RUN COMPLETE")
        else:
            colour, label = S.fg(BAD), "RUN FAILED"
        done_n = sum(1 for t in st.tasks.values() if t.state == "done")
        per = f"  {d}  {fmt_tokens(run.tokens // done_n)}/accepted task" if run.tokens and done_n else ""
        rows.append([(m + label, colour + BOLD), (f"  {d}  final gate {run.finish}", colour),
                     (f"  {d}  {run.finish_evidence}" if run.finish_evidence else "", DIM),
                     (per, DIM), (f"  {d}  {invalid}" if invalid else "", S.fg(WARN))])
    lab = 11

    def line(label: str, segs: Row) -> None:
        rows.append([(m + pad(label, lab), DIM)] + segs)

    dims = run.dims
    if dims.get("goal"):
        line("goal", [(clip(clean(dims["goal"]), W - lab), "")])
    ctx = f"  {d}  ".join(x for x in (
        meta.get("strategy", ""),
        f"review {meta['review']}" if meta.get("review") else "",
        f"engine {meta['engine']}" if meta.get("engine") else "",
        f"isolation {meta['isolation']}" if meta.get("isolation") else "",
        f"trigger {meta['trigger']}" if meta.get("trigger") and meta["trigger"] != "once" else "",
        f"host {meta['host']}" if meta.get("host") else "") if x)
    if ctx:
        line("run", [(clip(ctx, W - lab), DIM)])
    if run.models:
        segs: Row = []
        for role, tier in run.models.items():
            if segs:
                segs.append((f"  {d}  ", DIM))
            segs += [(f"{role} ", DIM), (tier, "")]
            obs = run.observed.get(role)
            if obs and obs != tier:
                segs += [(f" (observed {obs} !)", S.fg(WARN))]
        eff = dims.get("effort")
        if eff:
            eff_s = " ".join(f"{k}={v}" for k, v in eff.items()) if isinstance(eff, dict) else str(eff)
            segs += [(f"  @ {eff_s}", DIM)]
        line("models", segs)
    b = run.budget
    if b or st.stints or run.tokens:
        parts: Row = []

        def used(label: str, n: int | str, cap: str | None) -> None:
            if parts:
                parts.append((f"  {d}  ", DIM))
            over = cap and str(cap).isdigit() and isinstance(n, int) and n > int(cap)
            parts.append((f"{label} ", DIM))
            parts.append((f"{n}" + (f"/{cap}" if cap else ""), S.fg(WARN) if over else ""))

        used("agents", len(st.stints), b.get("agents"))
        if b.get("cycles") or run.cycles:
            used("cycles", run.cycles, b.get("cycles"))
        if b.get("tokens") or run.tokens:
            used("tokens", fmt_tokens(run.tokens) if run.tokens else "0", b.get("tokens"))
        line("budget", parts)
    chk = [c for t in st.tasks.values() for c in t.checks.values()] + list(st.run_checks.values())
    if chk:
        cnt = {k: sum(1 for c in chk if c["status"] == k) for k in ("ok", "fail", "running")}
        segs = [(f"{cnt['ok']}/{len(chk)} ok", S.fg(OK) if not cnt["fail"] else "")]
        if cnt["fail"]:
            segs += [(f"  {d}  ", DIM), (f"{cnt['fail']} failed", S.fg(BAD))]
        if cnt["running"]:
            segs += [(f"  {d}  ", DIM), (f"{cnt['running']} running", S.fg(WARN))]
        for name, c in st.run_checks.items():
            colour = S.fg(OK) if c["status"] == "ok" else S.fg(BAD) if c["status"] == "fail" else S.fg(WARN)
            segs += [(f"  {d}  run: {name} ", DIM), (c["status"], colour), (f" {c['dur']}" if c["dur"] else "", DIM)]
        line("checks", segs)
    if run.plan or dims.get("alias") or dims.get("confirm"):
        segs = []
        if run.plan:
            colour = S.fg(OK) if run.plan == "approved" else S.fg(WARN)
            segs += [(run.plan, colour), (f" {hhmm(run.plan_ts)}" if run.plan_ts and run.plan != "pending" else "", DIM)]
            if run.plan == "pending" and run.plan_msg:
                segs.append((f" ({run.plan_msg})", DIM))
        if dims.get("alias"):
            segs += [(f"  {d}  alias ", DIM), (str(dims["alias"]), "")]
        if dims.get("confirm"):
            segs += [(f"  {d}  confirm {dims['confirm']}", DIM)]
        line("plan", segs)
    for rail in run.rails + st.derived_rails():
        line("rails", [(clip(rail, W - lab), S.fg(WARN))])
    if run.decisions:
        last = run.decisions[-1]
        line("decisions", [(f"{len(run.decisions)}", ""), (f"  {d}  latest {last['id']} ", DIM), (clip(last["msg"], W - lab - 20), "")])
    att = attention(st, now)
    if att:
        cnt = {k: sum(1 for mk, _, _ in att if mk == k) for k in ("x", "!", "?")}
        segs = []
        for mk, word, colour in (("x", "blocked/failed", S.fg(BAD)), ("!", "stale", S.fg(WARN)), ("?", "pending", DIM)):
            if cnt[mk]:
                if segs:
                    segs.append((f"  {d}  ", DIM))
                segs += [(f"{mk} {cnt[mk]} ", colour + BOLD), (word, DIM)]
        line("attention", segs)
    if st.mail or st.learned:
        segs = []
        if st.mail:
            agents_ = {s.agent for s in st.open_stints()} | {"controller"}
            unread_all = sum(len(st.unread(a)) for a in agents_)
            mine = st.unread("controller")
            asks = [m for m in mine if m.ask]
            segs = [(f"{len(st.mail)} sent", DIM), (f"  {d}  {unread_all} unread", S.fg(WARN) if unread_all else DIM)]
            if mine:
                segs += [(f"  {d}  {len(mine)} for you", S.fg(WARN) + BOLD)]
            if asks:
                segs += [(f"  {d}  {len(asks)} question{'s' if len(asks) != 1 else ''}", S.fg(WARN) + BOLD)]
        if st.learned:
            new = len(st.unread_learn("controller"))
            segs += [(f"  {d}  " if segs else "", DIM), (f"learn {len(st.learned)}", DIM)]
            if new:
                segs += [(f"  {d}  {new} new for you", S.fg(WARN) + BOLD)]
        line("mail", segs)
    if st.problems:
        line("journal", [(f"! {len(st.problems)} integrity problem(s) — board check", S.fg(BAD))])
    rows.append([])
    return rows


def lane_label(lane: str) -> str:
    return LABELS.get(lane) or lane.upper().replace("_", " ")


class View:
    """Rendering options shared by show/watch."""

    def __init__(self, expanded: bool = False, focus: str = "", attention_only: bool = False, S: Style | None = None):
        self.expanded, self.focus, self.attention_only = expanded, focus, attention_only
        self.open = ""  # the one card opened with enter
        self.S = S or Style(False)


def build_rows(st: State, width: int, view: View) -> tuple[list[Row], list[tuple[int, str]]]:
    """Returns rows and the (row index, task id) anchors of every rendered card (for focus/scroll).
    Every card is three columns — task · who · signal — with widths computed per lane, so the eye scans columns, not prose."""
    now = time.time()
    S = view.S
    W = max(40, width) - 2 * MARGIN          # usable width
    inner = W - 6                            # inside a box: "│  " … "  │"
    narrow = W < 64
    m = " " * MARGIN
    rows = header_rows(st, W, now, S)
    anchors: list[tuple[int, str]] = []
    ordered = st.ordered()
    idw = max([len(t.id) for t in ordered] + [1])
    att_ids = {t.id for _, t, _ in attention(st, now)}
    has_kids = {t.id for t in ordered if children(st, t)}
    for col in st.lanes:
        cards = [t for t in ordered if st.lane_of(t) == col]
        if view.attention_only:
            cards = [t for t in cards if t.id in att_ids]
        c = S.col(col)
        edge = [(m + S.v + "  ", c)]
        tail = [("  " + S.v, c)]
        if not cards:
            if col == "blocked" or view.attention_only:
                continue
            rows.append([(m + f"{lane_label(col)}  0", c + DIM)])
            rows.append([])
            continue
        hidden = 0
        if col == "done" and not view.expanded and len(cards) > DONE_SHOW:
            # collapse whole families (a parent with its subtasks), oldest first; a parent with children is never hidden
            fams: list[str] = []
            for t in cards:
                root = t.id.split(".")[0]
                if root not in fams:
                    fams.append(root)
            keep = set(fams[-DONE_SHOW:])
            shown = [t for t in cards if t.id.split(".")[0] in keep or t.id in has_kids]
            hidden, cards = len(cards) - len(shown), shown
        title = f" {lane_label(col)} "
        count = f" {len(cards) + hidden} "
        fill = W - 2 - dw(title) - 1 - dw(count) - 1
        rows.append([(m + S.tl + S.h, c), (title, c + BOLD), (S.h * max(1, fill), c), (count, c + BOLD), (S.h + S.tr, c)])
        visible = {t.id for t in cards}
        whos = {t.id: card_who(t, st) for t in cards}
        who_txt = {tid: (a + "".join(f" {S.dot}{x}" for x in dev) if a else "") for tid, (a, dev) in whos.items()}
        whow = max([dw(x) for x in who_txt.values()] + [0])
        sigs = {t.id: card_signal(t, st, now, S) for t in cards}

        def ttl_of(t: Task) -> str:
            parent = t.id.rsplit(".", 1)[0] if "." in t.id else ""
            return ("  " if parent in visible else "") + (t.title or "(untitled)")

        head_w = idw + 2
        avail = inner - head_w - (whow + 2 if whow else 0)
        tw_want = max([dw(ttl_of(t)) for t in cards] + [8])
        sw_want = max([dw(row_text(sigs[t.id])) for t in cards] + [0])
        tw = tw_want if tw_want + 2 + sw_want <= avail else max(12, min(tw_want, avail - 2 - min(sw_want, avail // 2)))
        sig_w = max(0, avail - tw - 2)
        for t in cards:
            focused = view.focus == t.id
            head = f"{t.id.rjust(idw)}  "
            head_sgr = REV if focused else BOLD
            anchors.append((len(rows), t.id))
            who = who_txt[t.id]
            sig = sigs[t.id]
            if narrow:   # stack who and signal under the title
                rows.append(edge + [(head, head_sgr), (pad(clip(ttl_of(t), inner - head_w), inner - head_w), ""), *tail])
                under = ([(who, DIM), (f" {S.dot} ", DIM)] if who else []) + sig
                for line_ in wrap_segs(under, inner - head_w, S.dot):
                    rows.append(edge + [(" " * head_w, "")] + line_ + [(" " * (inner - head_w - dw(row_text(line_))), ""), *tail])
            else:
                line: Row = [(head, head_sgr), (pad(clip(ttl_of(t), tw), tw), ""), ("  ", "")]
                if whow:
                    line += [(pad(who, whow), DIM if not who else ""), ("  ", "")]
                if dw(row_text(sig)) <= sig_w:
                    rows.append(edge + line + sig + [(" " * (sig_w - dw(row_text(sig))), ""), *tail])
                else:   # a long signal continues under itself
                    parts = wrap_segs(sig, sig_w, S.dot)
                    rows.append(edge + line + parts[0] + [(" " * (sig_w - dw(row_text(parts[0]))), ""), *tail])
                    for line_ in parts[1:]:
                        rows.append(edge + [(" " * (inner - sig_w), "")] + line_ + [(" " * (sig_w - dw(row_text(line_))), ""), *tail])
            if view.expanded or view.open == t.id:
                details = card_details(t, st, now, S)
                lab = 10
                for label, segs in details:
                    avail_ = inner - head_w - lab
                    for i, line_ in enumerate(wrap_segs(segs, avail_, S.dot)):
                        rows.append(edge + [(" " * head_w, ""), (pad(label if i == 0 else "", lab), DIM)] + line_ +
                                    [(" " * (avail_ - dw(row_text(line_))), ""), *tail])
                if details and t is not cards[-1]:
                    rows.append(edge + [(" " * inner, ""), *tail])
        if hidden:
            rows.append(edge + [(pad(f"+{hidden} more (e to expand)", inner), DIM), *tail])
        rows.append([(m + S.bl + S.h * (W - 2) + S.br, c)])
        rows.append([])

    last = next((e for e in reversed(st.events) if e.get("msg") and e.get("ev") in ("note", "return", "escalate", "blocked", "dispatch")), None)
    if last:
        ts = str(last.get("ts", ""))[11:16]
        who = clean(last.get("agent") or f"task {last.get('task')}")
        rows.append([(m + ts + "  ", DIM), (who, BOLD + DIM), (clip(clean(f": {last['msg']}"), W - dw(ts) - dw(who) - 2), DIM)])
    return rows, anchors


def signature(ws: Path) -> tuple:
    """Change detector for watch: top-level files + raw/, never the archive."""
    if not ws.exists():
        return ()
    sig = []
    entries = list(ws.iterdir()) + (list((ws / "raw").iterdir()) if (ws / "raw").is_dir() else [])
    for p in entries:
        if p.name == "archive":
            continue
        try:
            s = p.stat()
            sig.append((p.name, s.st_mtime_ns, s.st_size))
        except OSError:
            continue
    return tuple(sorted(sig))


def term_size() -> tuple[int, int]:
    size = shutil.get_terminal_size((100, 30))
    return size.columns, size.lines


def cmd_watch(ws: Path) -> None:
    import select
    import termios
    import tty

    global GIT_CWD
    GIT_CWD = ws.resolve().parent

    if not sys.stdin.isatty() or not sys.stdout.isatty():
        sys.exit("board: watch needs a terminal (use `board show` when piping)")
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    resized = {"flag": True}
    signal.signal(signal.SIGWINCH, lambda *_: resized.__setitem__("flag", True))
    out = sys.stdout
    script = Path(sys.argv[0]).resolve()
    script_mtime = script.stat().st_mtime if script.exists() else 0.0
    view = View(S=Style(not os.environ.get("NO_COLOR")))
    offset = 0
    reloaded_at = 0.0
    others: list[dict] = []   # other registered runs (for `n` and the "newer run" hint)
    carried = os.environ.pop("BOARD_VIEW", "")  # state carried across a reload (r key / script update)
    if carried:
        try:
            st_ = json.loads(carried)
            view.expanded, view.focus, view.open = bool(st_.get("expanded")), str(st_.get("focus", "")), str(st_.get("open", ""))
            view.attention_only, offset = bool(st_.get("attention")), int(st_.get("offset", 0))
            reloaded_at = float(st_.get("reloaded", 0.0))
        except (ValueError, TypeError):
            pass

    def restore() -> None:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        out.write("\033[?25h\033[?1049l")
        out.flush()

    def reload(reason: str) -> None:
        """Re-execute the script from disk — a real restart that keeps the view where it was."""
        frames = SPIN_FRAMES_ASCII if view.S.ascii else SPIN_FRAMES
        label = f"reloading ({reason})…" if not view.S.ascii else f"reloading ({reason})..."
        col = view.S.fg(OK)
        for i in range(9):  # ~9 frames @ 75ms ≈ 0.67s total — seen, but still feels instant
            text = clip(f"  {frames[i % len(frames)]} {label}", max(1, cols - MARGIN))
            out.write(f"\033[{lines};1H" + col + text + RESET + "\033[K")
            out.flush()
            time.sleep(0.075)
        restore()
        os.environ["BOARD_VIEW"] = json.dumps({"expanded": view.expanded, "focus": view.focus, "open": view.open,
                                               "attention": view.attention_only, "offset": offset, "reloaded": time.time()})
        os.execv(sys.executable, [sys.executable, str(script), "watch"])

    def switch(to: Path, reason: str) -> None:
        os.environ["ORCHESTRATE_WS"] = str(to)
        reload(reason)

    out.write("\033[?1049h\033[?25l")  # alt screen, hide cursor
    out.flush()
    try:
        tty.setcbreak(fd)
        last_sig, rows, anchors, tick = None, [], [], 0
        updated_at = 0.0
        cols, lines = term_size()
        while True:
            if resized["flag"]:
                cols, lines = term_size()
                resized["flag"] = False
                last_sig = None
            try:  # the installed script changed (reinstall) → run the new code, not the old one in memory
                if script.exists() and script.stat().st_mtime != script_mtime:
                    reload("script updated")
            except OSError:
                pass
            sig = signature(ws)
            tick += 1
            if sig != last_sig or tick % 4 == 0:  # on change, plus every ~2s for the timers
                if last_sig is not None and sig != last_sig:
                    updated_at = time.time()
                st_now = load(ws)
                rows, anchors = build_rows(st_now, cols, view)
                last_sig = sig
                others = [r for r in registry_runs() if Path(r["ws"]).resolve() != ws.resolve()]
                mine = (ws / JOURNAL).stat().st_mtime if (ws / JOURNAL).exists() else 0.0
                newer = [r for r in others if float(r.get("last", 0)) > mine and time.time() - float(r.get("last", 0)) < 30]
                if newer and st_now.run.finish and not os.environ.get("BOARD_PINNED"):
                    switch(Path(newer[0]["ws"]), f"following {newer[0]['repo']}")  # this run is over; another one is live
            body = max(1, lines - 1)
            offset = max(0, min(offset, max(0, len(rows) - body)))
            frame = ["\033[H"]
            for row in rows[offset: offset + body]:
                frame.append(row_render(row, True) + "\033[K\n")
            for _ in range(body - min(body, len(rows) - offset)):
                frame.append("\033[K\n")
            below = len(rows) - offset - body
            dot = view.S.dot
            now = time.time()
            status = ""
            if now - reloaded_at < 4:
                status = f"reloaded {dt.datetime.fromtimestamp(reloaded_at).strftime('%H:%M:%S')}"
            elif now - updated_at < 3:
                spin = SPIN_FRAMES_ASCII if view.S.ascii else SPIN_FRAMES
                status = spin[tick % len(spin)] + " " + f"updated {dt.datetime.fromtimestamp(updated_at).strftime('%H:%M:%S')}"
            live = [r for r in others if time.time() - float(r.get("last", 0)) < 30]
            hint = (f"q quit  {dot}  j/k focus  {dot}  enter card  {dot}  " +
                    ("e contract" if view.expanded else "e expand") + f"  {dot}  " +
                    ("a all" if view.attention_only else "a attention") + f"  {dot}  r reload" +
                    (f"  {dot}  n next run" + (f" ({live[0]['repo']} is live)" if live else f" ({len(others)} more)") if others else "") +
                    (f"  {dot}  +{below} below" if below > 0 else ""))
            left = (" " * MARGIN + (view.S.fg(OK) if status else "") + status + RESET) if status else ""
            frame.append(left + DIM + " " * max(1, cols - dw(hint) - dw(status) - 2 * MARGIN) + hint + RESET + "\033[K")
            out.write("".join(frame))
            out.flush()
            r, _, _ = select.select([fd], [], [], 0.5)
            if not r:
                continue
            buf = os.read(fd, 64).decode("utf-8", "ignore")
            ids = [tid for _, tid in anchors]
            for key in re.findall(r"\x1b\[[A-Za-z]|.", buf, re.S):  # arrow sequences or single keys
                if key in ("q", "\x03"):
                    return
                if key in ("j", "k") and ids:
                    i = ids.index(view.focus) if view.focus in ids else (-1 if key == "j" else len(ids))
                    i = max(0, min(len(ids) - 1, i + (1 if key == "j" else -1)))
                    view.focus, last_sig = ids[i], None
                    rows, anchors = build_rows(load(ws), cols, view)
                    row_i = next((ri for ri, tid in anchors if tid == view.focus), 0)
                    if row_i < offset or row_i >= offset + body - 2:
                        offset = max(0, row_i - 3)
                elif key in ("\r", "\n"):
                    if view.focus:
                        view.open = "" if view.open == view.focus else view.focus
                        last_sig = None
                elif key == "\x1b[B":
                    offset += 1
                elif key == "\x1b[A":
                    offset -= 1
                elif key == "G":
                    offset = len(rows)
                elif key == "g":
                    offset = 0
                elif key in ("e", "x", "\t"):
                    view.expanded, last_sig = not view.expanded, None
                elif key == "a":
                    view.attention_only, last_sig = not view.attention_only, None
                elif key == "r":
                    reload("r")
                elif key == "n" and others:
                    switch(Path(others[0]["ws"]), f"→ {others[0]['repo']}")
    finally:
        restore()


# --- flight plan --------------------------------------------------------------------------

def gate_names(review: str) -> list[str]:
    review = (review or "dual").lower()
    if review == "off":
        return []
    if review in ("dual", ""):
        return ["spec", "quality"]
    m = re.match(r"(panel|consensus):(\d+)", review)
    if m:
        return [f"{m.group(1)} lens {i + 1}" for i in range(int(m.group(2)))]
    return [review]


def render_plan(st: State, why: str = "") -> str:
    run, d = st.run, st.run.dims
    if not d:
        return "board: no `run` record yet — `board init PLAN --strategy ...` first"
    strategy = str(d.get("strategy") or "staged")
    models = run.models
    eff = d.get("effort")
    eff_map = eff if isinstance(eff, dict) else {}
    eff_default = "" if isinstance(eff, dict) else (str(eff) if eff else "")

    def tier(role: str) -> str:
        return models.get(role) or TIER_DEFAULT.get(role, "session model")

    def at(role: str) -> str:
        e = eff_map.get(role) or eff_default
        return f" @ {e}" if e else ""

    engine = str(d.get("engine") or "claude")
    iso = str(d.get("isolation") or ("worktree" if strategy == "parallel" else "shared tree"))
    tasks = st.ordered()
    n = len(tasks)
    gates = gate_names(str(d.get("review") or "dual"))
    agents = 0
    counts: dict[str, int] = {}  # tier -> nodes in the tree (drives the cost band)

    def count(tier_: str, k: int = 1) -> None:
        counts[tier_] = counts.get(tier_, 0) + k

    lines: list[str] = []
    lines.append(f"strategy={strategy}" + (f" — {why}" if why else ""))
    lines.append(f"goal: {d.get('goal') or '(not recorded)'}")
    lines.append("")
    lines.append(f"controller · orchestrator {tier('orchestrator')}{at('orchestrator')} · {st.meta.get('host', 'host?')}")
    worker_line = f"{tier('worker')}{at('worker')}" + (f" · engine {engine}" if engine != "claude" else "")
    extra_roles = [r for r in models if r not in ("orchestrator", "worker", "reviewer", "reasoner", "peer", "advisor")]

    def gate_lines(prefix: str) -> None:
        nonlocal agents
        for i, g in enumerate(gates):
            last = i == len(gates) - 1
            lines.append(f"{prefix}{'└─' if last else '├─'} {g} reviewer · {tier('reviewer')}{at('reviewer')}")
            agents += 1
            count("reviewer")

    if strategy in ("staged", "xcli", "advisor"):
        if strategy == "advisor":
            lines.append(f"├─ advisor lane · {tier('advisor')} · consults only, out of the hot path")
            agents += 1
            count("advisor")
        unit = "worker" if strategy == "xcli" else "implementer"
        lines.append(f"├─ ×{n} tasks ({strategy}), the repeating unit:")
        lines.append(f"│  ├─ {unit} · task N · {worker_line} · {iso}")
        agents += n
        count("worker", n)
        gate_lines("│  │  ")
        agents += len(gates) * max(0, n - 1)  # gates repeat per task
        count("reviewer", len(gates) * max(0, n - 1))
        if gates:
            lines.append("│  └─ fix wave (same contract) → re-review, cap 2–3 rounds per gate")
    elif strategy == "parallel":
        cap = int(d.get("workers") or 0) or n
        for t in tasks[:cap]:
            where_ = f"worktree wt-{t.id}" if iso not in ("off", "none", "shared tree") else "shared tree (isolation off)"
            lines.append(f"├─ worker · card {t.id} {t.title} · {worker_line} · {where_}")
            agents += 1
        count("worker", n)
        if n > cap:
            lines.append(f"├─ … {n - cap} more cards queued behind workers={cap}")
        for g in gates:
            lines.append(f"│  └─ {g} reviewer per card · {tier('reviewer')}{at('reviewer')}")
        agents += len(gates) * n
        count("reviewer", len(gates) * n)
        lines.append(f"├─ integrator · {tier('orchestrator')} · merge gates decide readiness")
        agents += 1
        count("worker")
    elif strategy == "loop":
        cycles = run.budget.get("cycles") or "?"
        lines.append(f"├─ ×≤{cycles} cycles · trigger {d.get('trigger') or 'goal'}:")
        lines.append(f"│  ├─ executor · {worker_line} · {iso}")
        lines.append(f"│  ├─ verifier · {tier('reviewer')}{at('reviewer')} · fresh per round")
        lines.append(f"│  └─ evolve pass every N cycles · {tier('orchestrator')}")
        agents += 3
        count("worker", int(cycles) if str(cycles).isdigit() else 1)
        count("reviewer", int(cycles) if str(cycles).isdigit() else 1)
    elif strategy == "hierarchical":
        for t in tasks:
            lines.append(f"├─ sub-orchestrator · {t.title or t.id} · {tier('orchestrator')}{at('orchestrator')}")
            lines.append(f"│  ├─ workers ×? · {worker_line}")
            agents += 2
        gate_lines("│  ")
    elif strategy == "team":
        lines.append(f"├─ lead · {tier('orchestrator')}")
        for t in tasks:
            lines.append(f"├─ teammate · {t.title or t.id} · {worker_line} · shared context, messages")
            agents += 1
        gate_lines("│  ")
    elif strategy == "adversarial":
        lines.append(f"├─ planner A · {tier('reasoner')} vs counter-planner B · {tier('peer')} · round cap 2")
        lines.append(f"├─ synthesis · {tier('orchestrator')} → hardened plan")
        agents += 3
        lines.append(f"├─ then ×{n} tasks staged: implementer · {worker_line}")
        agents += n
        gate_lines("│  ")
    elif strategy == "workflow":
        lines.append(f"├─ pilot slice · task {tasks[0].id if tasks else '?'} · {worker_line}")
        lines.append(f"├─ phases ×{n} · find/verify workers per phase · {worker_line}")
        agents += n + 1
        gate_lines("│  ")
    else:
        for role, t_ in models.items():
            lines.append(f"├─ {role} · {t_}{at(role)}")
            agents += 1
    for role in extra_roles:  # roles the strategy shape does not know (e.g. researcher subagents)
        lines.append(f"├─ {role} · {models[role]}{at(role)} · nested/delegated — counted by the lane, not this tree")
    lines.append(f"└─ final-deliverable gate · {models.get('reasoner') or models.get('orchestrator') or 'strongest'} · fresh context, judges the goal verbatim")
    agents += 1
    count("reviewer")
    lines.append("")
    gate_txt = " → ".join(gates) if gates else "off"
    lines.append(f"gates   {gate_txt} per unit · final gate once · fan-in: {n} dispatches → {n} returns expected")
    rails = [f"branch {st.meta.get('branch', '?')}", f"isolation {iso}", f"confirm {d.get('confirm') or 'on'}"] + run.rails + st.derived_rails()
    lines.append("rails   " + " · ".join(rails))
    if engine not in ("claude", "mixed") and engine in LAUNCH_CMD:
        eff = eff_map.get("worker") or eff_default or "high"
        lines.append("lane    " + LAUNCH_CMD[engine].format(model=tier("worker"), effort=eff) + "  (spec file per lane · empty-diff check · session id journaled)")
    b = run.budget
    tok = b.get("tokens")
    est = cost_band(st.ws, counts)
    lines.append(f"budget  ~{agents} agents (from the tree; nested lanes add their own)" + (f" · cap {b['agents']}" if b.get("agents") else "") +
                 (f" · tokens cap {tok}" if tok else "") +
                 (f" · tokens est {est}" if est else " · tokens: no receipts yet — state a range, never a precision you don't have"))
    if st.lanes != COLUMNS:
        lines.append("lanes   " + " → ".join(st.lanes))
    if strategy in ("parallel", "team", "hierarchical", "workflow"):
        lines.append("mail    checkpoint delivery (board inbox at start / after tests / before commit / before report) · "
                     "board peers shows who else is working and what they own · asks rendezvous via board wait")
    lines.append("board   open a pane and run  board  (or .orchestrate/board)")
    lines.append("tweak   [1] strategy [2] models [3] effort [4] engine [5] review [6] isolation [7] budget [8] lanes  —  `board set key=value` re-resolves")
    return "\n".join(lines)


def receipts(ws: Path) -> tuple[dict[str, list[int]], int]:
    """Token receipts per tier from ARCHIVED runs (past evidence only): {tier: [tokens…]}, run count."""
    out: dict[str, list[int]] = {}
    runs = 0
    for jp in sorted(ws.glob("archive/*/journal.jsonl")):
        try:
            past = load(jp.parent, journal_only=True)
        except Exception:  # a damaged archive must not break the flight plan
            continue
        got = False
        for s in past.stints:
            if s.tokens:
                out.setdefault(role_tier(s.role), []).append(s.tokens)
                got = True
        runs += got
    return out, runs


def quantile(xs: list[int], q: float) -> int:
    if not xs:
        return 0
    xs = sorted(xs)
    return xs[min(len(xs) - 1, int(round(q * (len(xs) - 1))))]


def cost_band(ws: Path, counts: dict[str, int]) -> str:
    """p50–p90 token band for the planned tree, from past receipts — the pre-flight number, honestly sourced."""
    rc, runs = receipts(ws)
    if not rc:
        return ""
    pooled = [x for xs in rc.values() for x in xs]
    low = high = 0
    for tier_, k in counts.items():
        xs = rc.get(tier_) or pooled
        low += k * quantile(xs, 0.5)
        high += k * quantile(xs, 0.9)
    thin = " — thin evidence, treat as a floor" if len(pooled) < 3 else ""
    return f"{fmt_tokens(low)}–{fmt_tokens(high)} (p50–p90 of {len(pooled)} receipt{'s' if len(pooled) != 1 else ''}, {runs} past run{'s' if runs != 1 else ''}{thin})"


# --- roster · timeline · check · resume ------------------------------------------------------

def table(headers: list[str], rows: list[list[str]]) -> str:
    widths = [max(dw(h), *(dw(r[i]) for r in rows)) if rows else dw(h) for i, h in enumerate(headers)]
    fmt = lambda r: "  ".join(pad(c, widths[i]) for i, c in enumerate(r)).rstrip()
    return "\n".join([fmt(headers), fmt(["─" * w for w in widths])] + [fmt(r) for r in rows])


def render_agents(st: State) -> str:
    if not st.stints:
        return "board: no agents dispatched yet"
    now = time.time()
    rows = []
    for s in st.stints:
        model = s.model or "-"
        if s.observed and s.observed != s.model:
            model = f"{s.model or '?'} -> {s.observed} !"
        end = hhmm(s.returned) if s.returned else "…"
        dur = fmt_dur((s.returned or now) - s.started)
        t = st.tasks.get(s.task)
        status = s.status or ("stale" if stint_stale(s, t, now) else "running")
        extra = " · ".join(x for x in (f"nudged x{s.nudges}" if s.nudges else "", f"escalated -> {s.escalated_to}" if s.escalated_to else "",
                                       s.worktree) if x)
        rows.append([s.agent, s.role, s.task, str(s.attempt), model, s.engine or "-", s.effort or "-", f"{hhmm(s.started)} → {end}", dur, status,
                     fmt_tokens(s.tokens) if s.tokens else "-", s.session or "-", extra])
    return table(["agent", "role", "task", "att", "model", "engine", "effort", "window", "dur", "status", "tokens", "session", ""], rows)


def render_log(events: list[dict]) -> str:
    out = []
    for ev in events:
        kind = str(ev.get("ev", ""))
        ts = str(ev.get("ts", ""))[11:19]
        task = str(ev.get("task", ""))
        agent = clean(ev.get("agent", ""))
        skip = {"schema", "run", "seq", "ts", "ts_utc", "actor", "prev", "hash", "ev", "task", "agent", "title"}
        detail = " ".join(f"{k}={v}" if k not in ("msg", "why", "goal") else str(v)
                          for k, v in ev.items() if k not in skip and v not in ("", None, False))
        if kind in ("todo", "title"):
            detail = str(ev.get("title", ""))
        out.append(clean(f"{ev.get('seq', '?'):>3} {ts}  {pad(kind, 9)} {pad(task, 4)} {pad(agent, 16)} {detail}").rstrip())
    return "\n".join(out) if out else "board: journal is empty"


def commit_exists(ref: str) -> bool:
    try:
        return subprocess.run(["git", "cat-file", "-e", f"{ref}^{{commit}}"], capture_output=True, cwd=GIT_CWD).returncode == 0
    except (FileNotFoundError, OSError):
        return True


def finish_invalid(st: State) -> str:
    """Why a recorded `finish` no longer stands, or ''."""
    run = st.run
    if not run.finish:
        return ""
    later = [e for e in st.events if int(e.get("seq", 0)) > run.finish_seq and e.get("ev") in TASK_EVENTS - {"note", "title", "todo"}]   # a retitle is not work
    if later:
        return f"{len(later)} work event(s) after finish"
    head = git("rev-parse", "HEAD")
    if run.finish_head and head and head != run.finish_head:
        return f"HEAD moved {run.finish_head[:7]} → {head[:7]}"
    if run.finish_goal and sha(str(run.dims.get("goal", ""))) != run.finish_goal:
        return "goal changed since finish"
    return ""


def check(st: State, finish_mode: bool = False) -> list[str]:
    findings: list[str] = list(st.problems)
    now = time.time()
    ws = st.ws
    review_mode = str(st.run.dims.get("review") or "dual")
    shape, summary = workspace_shape(ws, st)
    if shape == "pre-journal":
        findings.append(f"workspace predates the journal ({summary}) — adopt it: `board init PLAN --resume --strategy … --goal …` (never a bare init: that archives the ledger)")
    copy_ = ws / "board"
    try:
        me = Path(__file__).resolve()
        if copy_.exists() and copy_.resolve() != me and copy_.read_bytes() != me.read_bytes() and me.stat().st_mtime > copy_.stat().st_mtime:
            findings.append("`.orchestrate/board` is older than the installed skill — run scripts/workspace to refresh the zero-install copy")
    except OSError:
        pass
    for t in st.ordered():
        s = t.state
        if is_stale(t, now):
            findings.append(f"task {t.id}: in progress, no artifact delta for {fmt_dur(now - t.last_activity)} — disk check, then ONE nudge")
        if t.dispatched and not t.returned and s not in ("in_progress", "done"):
            findings.append(f"task {t.id}: dispatched, never returned (state {s}) — silence is not success")
        if t.report and s == "review" and not t.gates and now - t.last_activity > STALE_AFTER:
            findings.append(f"task {t.id}: report landed {fmt_dur(now - t.last_activity)} ago, no review dispatched")
        if s == "done":
            for rng in re.findall(r"\b([0-9a-f]{7,40})\.\.([0-9a-f]{7,40})\b", t.final_note):
                for ref in rng:
                    if not commit_exists(ref):
                        findings.append(f"task {t.id}: ledger names commit {ref} that git cannot find")
            for p in re.findall(r"(?:evidence|report|raw)/[\w./-]+", t.final_note):
                p = p.rstrip(".,;)")
                if not (ws / p).exists() and not Path(p).exists():
                    findings.append(f"task {t.id}: ledger names artifact {p} that nobody can ls")
            failed = [k for k, v in t.gates.items() if v.startswith("fail")]
            if failed:
                findings.append(f"task {t.id}: done, but the current attempt's {', '.join(failed)} gate is a fail — ledger outran the gate")
            if t.failed_checks:
                findings.append(f"task {t.id}: done, but check(s) {', '.join(t.failed_checks)} failed on the current attempt — ledger outran the check")
            if st.run.dims and review_mode != "off" and t.dispatched and not t.gate_entries:
                findings.append(f"task {t.id}: done with no review gate ever opened (review={review_mode}) — the receipt has no reviewer")
        if "quality" in t.gates and "spec" in t.gates and not t.gates["spec"].startswith("ok"):
            findings.append(f"task {t.id}: quality gate opened while spec is {t.gates['spec']} — gates are ordered, spec first")
        if s != "done" and t.attempt >= 3 and not t.escalations:
            findings.append(f"task {t.id}: attempt {t.attempt} with no escalation — capability before retry (routing rule 4)")
        if s == "blocked" and not (t.note or t.detail):
            findings.append(f"task {t.id}: blocked without owner + next action — that is abandoned, not blocked")
    for s in st.open_stints():
        t = st.tasks.get(s.task)
        if s.role.endswith("reviewer") and stint_stale(s, t, now):
            findings.append(f"task {s.task}: {s.role} {s.agent} open {fmt_dur(now - s.started)} with no findings file — reviewer silence")
    for s in [x for x in st.stints if x.returned]:
        if s.status == "DONE" and s.engine and s.engine != "claude" and not s.commits and role_tier(s.role) == "worker":
            findings.append(f"task {s.task}: xcli {s.engine} return DONE with no commits — run the empty-diff check (REFUSED?)")
        if s.status in ("DONE", "DONE_WITH_CONCERNS") and s.engine and (s.engine != "claude" or s.log) and not s.tokens:
            findings.append(f"task {s.task}: xcli {s.engine} return with no usage receipt (--tokens) — budgets need receipts")
    done_ids = [t.id for t in st.ordered() if t.state == "done"]
    if done_ids:
        last_done = max(natural_key(i) for i in done_ids)
        for t in st.ordered():
            if t.state == "todo" and not t.dispatched and natural_key(t.id) < last_done and t.id.isdigit():
                findings.append(f"task {t.id}: never dispatched while later tasks are done — skipped or mis-ordered?")
    for s in st.open_stints():
        old = [m for m in st.unread(s.agent) if now - m.ts > STALE_AFTER]
        if old:
            findings.append(f"{s.agent} (task {s.task}): {len(old)} mail unread for {fmt_dur(now - old[0].ts)} — checkpoint reads missing (brief defect)")
        if s.sent >= MAIL_CAP:
            findings.append(f"{s.agent} (task {s.task}): {s.sent} mails this stint — chatter; the answer belongs in the report")
        if s.learned >= LEARN_CAP:
            findings.append(f"{s.agent} (task {s.task}): learnings at the cap ({LEARN_CAP}) — the report carries the rest; curate what landed")
    for m in st.mail:
        if m.to not in ("controller", "all") and st.acks.get(m.to, 0) < m.seq:
            s = st.stint_of(m.to)
            if s and s.returned and s.returned > m.ts:
                findings.append(f"mail #{m.seq} to {m.to} was never read — the stint returned first (undeliverable)")
    for m in st.mail:
        if m.ask and m.to != "all" and st.acks.get(m.to, 0) < m.seq and now - m.ts > STALE_AFTER:
            who = "you" if m.to == "controller" else f"lead {m.to}"
            findings.append(f"question #{m.seq} from {m.sender} to {who} unread for {fmt_dur(now - m.ts)} — the worker may be waiting"
                            + ("" if m.to == "controller" else " (nudge the lead, or answer it yourself)"))
    for d_ in st.run.drift:
        findings.append(f"model drift: {d_} — record the posture or re-pin")
    cap = st.run.budget.get("agents")
    if cap and str(cap).isdigit() and len(st.stints) > int(cap):
        findings.append(f"budget: {len(st.stints)} agents dispatched against a cap of {cap}")
    if st.run.dims and st.run.plan in ("", "pending") and st.stints:
        findings.append("flight plan never approved (or re-resolved since) yet agents were dispatched — no silent launch")
    if st.run.finish:
        open_ = [t.id for t in st.ordered() if t.state != "done"]
        if open_:
            findings.append(f"finish recorded with non-terminal tasks: {', '.join(open_)}")
        inv = finish_invalid(st)
        if inv:
            findings.append(f"finish invalidated: {inv} — re-run the final gate")
    if finish_mode:
        open_ = [t.id for t in st.ordered() if t.state != "done"]
        if open_:
            findings.append(f"finish gate: non-terminal tasks {', '.join(open_)}")
        if st.open_stints():
            findings.append("finish gate: open stints " + ", ".join(f"{s.agent} (task {s.task})" for s in st.open_stints()))
        for t in st.ordered():
            pend = [k for k, v in t.gates.items() if v.startswith("..")]
            if pend:
                findings.append(f"finish gate: task {t.id} gate(s) pending: {', '.join(pend)}")
        if st.run.drift and not any("posture" in r for r in st.run.rails):
            findings.append("finish gate: model drift observed and no cost-posture rail recorded")
    return findings


def replay(st: State) -> list[str]:
    """Cold replay: derive every card from the journal ALONE and diff it against the disk-backed view.
    A mismatch whose pointers are gone is `inconclusive`, never a false failure."""
    cold = load(st.ws, journal_only=True)
    out: list[str] = []
    for t in st.ordered():
        c = cold.tasks.get(t.id)
        cs = c.state if c else "absent"
        if cs == t.state:
            continue
        ptrs = ([t.report] if t.report else []) + t.findings
        missing = [p for p in ptrs if not (st.ws / p).exists()]
        journaled = [e for e in st.events if str(e.get("task")) == t.id and e.get("ev") not in ("todo", "title")]
        if st.run.adopted and not journaled:
            out.append(f"replay: task {t.id} — journal alone derives {cs}, disk view says {t.state}: inconclusive (pre-journal history, adopted)")
            continue
        if missing:
            out.append(f"replay: task {t.id} — journal alone derives {cs}, disk view says {t.state}: inconclusive ({', '.join(missing)} missing)")
        else:
            out.append(f"replay: task {t.id} — journal alone derives {cs}, disk view says {t.state} — a fact reached the disk without its journal line")
    for tid, c in cold.tasks.items():
        if tid not in st.tasks:
            out.append(f"replay: task {tid} exists in the journal only ({c.state})")
    return out


def render_mail(st: State, task: str = "") -> str:
    if not st.mail:
        return "board: no mail yet"
    agents_ = {s.agent for s in st.stints if not task or s.task == task}
    by_seq = {m.seq: m for m in st.mail}
    L = []
    for m in st.mail:
        if task and not (m.sender in agents_ or m.to in agents_):
            continue
        depth = 0
        cur = m
        while cur.re and cur.re in by_seq and depth < 8:
            cur, depth = by_seq[cur.re], depth + 1
        read = "read" if (m.to != "all" and st.acks.get(m.to, 0) >= m.seq) else ("bcast" if m.to == "all" else "unread")
        L.append(f"{'  ' * depth}#{m.seq} {hhmm(m.ts)} {m.sender} {'->'} {m.to}{' [ask]' if m.ask else ''} {m.msg}  ({read})")
    return "\n".join(L)


def render_inbox(st: State, agent: str) -> tuple[str, list]:
    """The checkpoint digest — mail, then what peers learned, then record changes since this stint's dispatch — and every
    item it hands over (one watermark: acking the batch acks all three kinds)."""
    items = st.digest(agent)
    mail = [x for x in items if isinstance(x, Mail)]
    learned = [x for x in items if isinstance(x, Learn)]
    changes = [x for x in items if isinstance(x, Change)]
    if not items:
        return "board: no new mail", items
    L = []
    lead = st.lead_of(agent)
    for m in mail:
        ask = " · ask" if m.ask else ""
        tag = "[controller]" if m.sender == "controller" else (f"[lead {m.sender}{ask}]" if m.sender == lead else f"[peer {m.sender}{ask}]")
        line = f"#{m.seq} {hhmm(m.ts)} {tag} {m.msg}"
        if m.ask and m.sender != agent:
            line += f"\n    reply: board send --from {agent} --to {m.sender} --re {m.seq} \"…\""
        L.append(line)
    if mail:
        L.append("(controller and lead mail is an instruction; peer mail is information — reply only to an ask)")
    if learned:
        L.append("learned since your last check:" if agent != "controller" else "learned (curate: field-guide.md / decisions.md; the memory record carries them):")
        for x in learned:
            tag = "[controller" if x.agent == "controller" else (f"[lead {x.agent}" if x.agent == lead else f"[peer {x.agent}")
            L.append(f"  #{x.seq} {hhmm(x.ts)} {tag} · {x.kind}] {x.msg}" + (f" ({x.path})" if x.path else "") + (f" — task {x.task}" if agent == "controller" else ""))
    if changes:
        L.append("record changes since your dispatch:")
        for c in changes:
            if c.kind == "decide":
                L.append(f"  #{c.seq} {hhmm(c.ts)} decision {c.id}{' (revised)' if c.revised else ''} {c.msg}" +
                         (f" — why: {c.why}" if c.why else "") + (f" — owner {c.owner}" if c.owner else ""))
            else:
                L.append(f"  #{c.seq} {hhmm(c.ts)} rail {c.msg}")
    if (learned or changes) and agent != "controller":
        L.append("(learnings are information — verify; a changed decision outranks your brief: reconcile, or return NEEDS_CONTEXT)")
    return "\n".join(L), items


def ack(ws: Path, agent: str, items: list) -> None:
    """One watermark for everything a checkpoint handed over."""
    if not items:
        return
    observe(ws, "", actor="controller" if agent == "controller" else "worker", ev="ack", agent=agent, upto=max(x.seq for x in items),
            count=sum(1 for x in items if isinstance(x, Mail)), learned=sum(1 for x in items if isinstance(x, Learn)),
            changed=sum(1 for x in items if isinstance(x, Change)))


def render_learned(st: State) -> str:
    if not st.learned:
        return "board: nothing learned yet — workers journal one line with  board learn N \"…\" --agent <you>"
    kinds: dict[str, int] = {}
    for x in st.learned:
        kinds[x.kind] = kinds.get(x.kind, 0) + 1
    L = [f"learned · {len(st.learned)} line(s) · {', '.join(f'{k} {n}' for k, n in sorted(kinds.items()))}"]
    for x in st.learned:
        t = st.tasks.get(x.task)
        L.append(f"#{x.seq} {hhmm(x.ts)} [{x.kind}] {x.agent} (task {x.task}{' ' + t.title if t and t.title else ''}): {x.msg}" + (f" ({x.path})" if x.path else ""))
    return "\n".join(L)


def render_peers(st: State, agent: str) -> str:
    me = st.stint_of(agent)
    others = [s for s in st.open_stints() if s.agent != agent]
    if not others and not any(s.agent != agent and (s.returned and s.status or s.exit_code is not None) for s in st.stints):
        return "board: no other agents are open right now — the controller is your only peer"
    lead = st.lead_of(agent)
    mine = me.by if me else "controller"
    team = [s for s in others if s.by == mine and s.agent != lead]
    elsewhere = [s for s in others if s not in team]
    L = [f"peers of {agent}" + (f" (task {me.task})" if me else "") + f" — your lead: {lead}" + (" (dispatched you; its mail is an instruction)" if lead != "controller" else "") + " — open right now:"]

    def line(s: Stint) -> str:
        t = st.tasks.get(s.task)
        return (f"- task {s.task} {t.title if t else ''} · {s.agent} · {s.role} · {s.model or '?'}" +
                (f" · {s.engine}" if s.engine and s.engine != "claude" else "") + (f" · owns {s.owns}" if s.owns else " · owns (undeclared)"))
    for s in team:
        L.append(line(s))
    if elsewhere:
        L.append("elsewhere in the run" + (" (other subtrees — their lead, not you, coordinates them):" if lead != "controller" or any(s.by != "controller" for s in elsewhere) else ":"))
        for s in elsewhere:
            L.append(line(s))
    done = [s for s in st.stints if s.agent != agent and (s.returned and s.status or (s.exit_code is not None and (st.ws / f"task-{s.task}-report.md").exists()))]
    if done:
        L.append("returned (their work is on disk — read it, don't ask for it):")
        for s in done[-6:]:
            t = st.tasks.get(s.task)
            state = s.status.lower().replace("_", " ") if s.status else f"lane exited rc={s.exit_code}, report on disk"
            L.append(f"- task {s.task} {t.title if t else ''} · {s.agent} · {state}" +
                     (f" · commits {s.commits}" if s.commits else "") + f" · report {(rp if rp.startswith('/') else '.orchestrate/' + rp) if (rp := s.report or f'task-{s.task}-report.md') else ''}")
    L.append("before touching a peer's area: board send --from <you> --to <peer> \"<what changes, which files>\" · "
             "an input not on disk yet: board wait --agent <you> --task N")
    return "\n".join(L)


def render_postmortem(st: State) -> str:
    """Per-tier evidence for the evolve pass: routing suggestions are recommended, never applied (one change, repeated evidence)."""
    if not st.stints:
        return "board: no agents dispatched yet — nothing to learn"
    tiers: dict[str, list[Stint]] = {}
    for s in st.stints:
        tiers.setdefault(role_tier(s.role), []).append(s)
    L = [f"# POSTMORTEM · run {st.run.id or '?'} · {sum(1 for t in st.tasks.values() if t.state == 'done')}/{len(st.tasks)} accepted"]
    rows = []
    for tier_, ss in tiers.items():
        tasks = sorted({s.task for s in ss}, key=natural_key)
        tok = sum(s.tokens for s in ss)
        drift = sum(1 for s in ss if s.observed and s.observed != s.model)
        calls = sum(s.calls for s in ss)
        cost = sum(s.cost for s in ss)
        rows.append([tier_, str(len(ss)), str(len(tasks)), ", ".join(sorted({s.model for s in ss if s.model})) or "-",
                     str(drift), str(sum(s.nudges for s in ss)), str(sum(1 for s in ss if s.escalated_to)),
                     fmt_tokens(tok) if tok else "-", fmt_tokens(tok // len(ss)) if tok else "-",
                     str(calls) if calls else "-", f"${cost:.2f}" if cost else "-"])
    L.append(table(["tier", "dispatches", "tasks", "models", "drift", "nudges", "escalations", "tokens", "per dispatch", "calls", "cost"], rows))
    dis = [s for s in st.stints if s.reported and s.reported != s.status]
    if dis:
        L.append("report ≠ return: " + ", ".join(f"{s.agent} said {s.reported}, controller recorded {s.status}" for s in dis))
    done = [t for t in st.tasks.values() if t.state == "done"]
    first = [t for t in done if t.attempt <= 1]
    chk = [c for t in st.tasks.values() for c in t.check_entries if c[3] in ("ok", "fail")]
    L.append(f"first-attempt clean: {len(first)}/{len(done)} accepted tasks · gate rounds: " +
             (", ".join(f"task {t.id} ×{len(t.gate_entries)}" for t in done) or "-") +
             (f" · checks {sum(1 for c in chk if c[3] == 'ok')}/{len(chk)} ok" if chk else ""))
    if st.run.tokens and done:
        L.append(f"cost per accepted task: {fmt_tokens(st.run.tokens // len(done))} ({fmt_tokens(st.run.tokens)} / {len(done)})")
    L.append("## Routing (recommend only — never applied here; one change, and only on repeated evidence)")
    workers = tiers.get("worker", [])
    esc = sum(1 for s in workers if s.escalated_to)
    if esc >= 2:
        L.append(f"- worker tier escalated {esc}× — consider one tier UP for judgment-heavy tasks (evidence: {esc} escalations)")
    elif len(done) >= 3 and len(first) == len(done) and not any(s.observed and s.observed != s.model for s in workers):
        L.append(f"- worker tier: {len(first)}/{len(done)} first-attempt clean, no drift — consider one tier DOWN on mechanical tasks only")
    else:
        L.append("- no routing change: evidence insufficient (needs repeated, stable-scope outcomes — never off one success)")
    return "\n".join(L)


def project_memory(ws: Path) -> tuple[Path | None, int]:
    """Whether the repo keeps project memory (the two files `ctx init` creates) — the board only DETECTS it; it never
    runs `ctx`. Returns (repo root, entry count of the default ledger; 0 when the ledger lives elsewhere)."""
    root = ws.resolve().parent
    cfg, log = root / ".agent" / "project-context.json", root / ".agent" / "PROJECT_CONTEXT.jsonl"
    if not (cfg.exists() or log.exists()):
        return None, 0
    n = 0
    if log.exists():
        try:
            n = sum(1 for ln in log.read_text(encoding="utf-8", errors="replace").splitlines() if ln.strip())
        except OSError:
            n = 0
    return root, n


def memory_hint(ws: Path, st: State, when: str) -> str:
    """The command the controller can run — printed, never executed — when the repo keeps project memory."""
    root, n = project_memory(ws)
    if root is None:
        return ""
    if when == "init":
        return (f"project memory: {n} entr{'y' if n == 1 else 'ies'} in .agent/PROJECT_CONTEXT.jsonl — "
                "ctx context --scope <scope> --budget 1500 > .orchestrate/memory-<scope>.md  (and ctx attempts --outcome failed) · "
                "pin the packet in briefs: read: .orchestrate/memory-<scope>.md — project memory")
    kind = "append" if (when == "finish" and st.run.finish == "pass") else "handoff"
    return (f"project memory: board memory --out .orchestrate/memory.json && "
            f"ctx {kind} --agent orchestrate --session-id {st.run.id or 'RUN'} --input .orchestrate/memory.json  "
            "(the run's decisions, learnings, attempts and verification, for the next run and the next tool)")


def _strip(v):  # empty sections never reach the record
    if isinstance(v, dict):
        return {k: _strip(x) for k, x in v.items() if x not in (None, "", [], {})}
    if isinstance(v, list):
        return [_strip(x) for x in v]
    return v


def render_memory(st: State, kind: str, scopes: list[str]) -> dict:
    """The run as ONE project-context record (observation when the final gate passed, else a handoff): what the next run
    or the next tool needs — decisions with their why, attempts that failed, learnings, commits, verification, the frontier.
    Paths only, never report bodies or raw logs. The board prints it; `ctx append --input` records it."""
    run, d, ws = st.run, st.run.dims, st.ws
    if not d:
        sys.exit("board: memory needs a run record (board init) — a pre-journal workspace has no run to describe")
    now = time.time()
    tasks = st.ordered()
    done = [t for t in tasks if t.state == "done"]
    inv = finish_invalid(st)
    finished = run.finish == "pass" and not inv
    kind = kind or ("observation" if finished else "handoff")
    goal = str(d.get("goal") or "")
    ledger = []
    if (ws / "progress.md").exists():
        ledger = [ln.strip() for ln in (ws / "progress.md").read_text(encoding="utf-8", errors="replace").splitlines() if ln.strip()]
    ctx = [f"Orchestrated run {run.id or '?'} ({d.get('strategy') or '?'}" + (f", engine {d['engine']}" if d.get("engine") else "") +
           f", review {d.get('review') or 'off'}) on branch {run.branch or '?'} from {run.base[:12] or '?'}. Goal: {goal or '(not recorded)'}. "
           f"{len(done)}/{len(tasks)} task(s) accepted" +
           (f"; final gate {run.finish}" + (f" (invalidated: {inv})" if inv else "") if run.finish else "; no final gate recorded") + "."]
    if run.rails:
        ctx.append("Rails: " + "; ".join(run.rails) + ".")
    if ledger:
        ctx.append("Ledger: " + " | ".join(ledger))
    rec: dict = {"record_type": kind, "importance": "high", "scope": scopes,
                 "task": {"id": run.id, "title": goal[:80], "status": "finished" if finished else "open"}, "context": "\n".join(ctx)}
    rec["decisions"] = [{"decision": f"{x['id']}: {x['msg']}",
                         "rationale": x.get("why") or ("rationale not recorded during the run (board decide --why)" +
                                                        (f"; journal seq {x['seq']}" if x.get("seq") else "; from decisions.md")),
                         "owner": x.get("owner") or ""} for x in run.decisions]
    returns = {(str(e.get("task")), str(e.get("agent"))): clean(e.get("msg", "")) for e in st.events if e.get("ev") == "return"}
    attempts = [{"approach": x.msg, "outcome": "failed", "evidence": f"task {x.task} by {x.agent}, journal #{x.seq}" + (f", {x.path}" if x.path else "")}
                for x in st.learned if x.kind == "failed"]
    for s in st.stints:
        if s.status in ("BLOCKED", "NEEDS_CONTEXT", "REFUSED"):
            t = st.tasks.get(s.task)
            attempts.append({"approach": f"task {s.task} {t.title if t else ''} by {s.agent} ({s.model or '?'}" + (f", {s.engine}" if s.engine else "") + ")",
                             "outcome": "abandoned" if s.status == "REFUSED" else "failed",
                             "reason": returns.get((s.task, s.agent)) or s.status.lower().replace("_", " ")})
    rec["attempts"] = attempts
    learnings = [{"type": "open_question" if x.kind == "question" else x.kind, "statement": x.msg + (f" ({x.path})" if x.path else ""), "confidence": "likely"}
                 for x in st.learned if x.kind != "failed"]
    fg = ws / "field-guide.md"
    if fg.exists():
        for ln in fg.read_text(encoding="utf-8", errors="replace").splitlines():
            ln = ln.strip()
            if ln and not ln.startswith("#"):
                learnings.append({"type": "gotcha", "statement": clean(ln.lstrip("-* ")), "confidence": "confirmed"})
    rec["learnings"] = learnings
    accepted = {t.id for t in done}
    commits = [s.commits for s in st.stints if s.commits and s.task in accepted and s.status in ("DONE", "DONE_WITH_CONCERNS")]
    artifacts = [{"path": f".orchestrate/{JOURNAL}", "type": "journal",
                  "purpose": f"hash-chained run journal; archived to .orchestrate/archive/{run.id or '<run-id>'}/ by the next kickoff"}]
    for t in tasks:
        for p in ([t.report] if t.report else []) + t.findings:
            artifacts.append({"path": p if p.startswith("/") else f".orchestrate/{p}", "type": "findings" if p.startswith("review-") else "report", "purpose": f"task {t.id} {t.title}"})
    rec["changes"] = {"capture": "agent-authored", "commits": sorted(set(commits)), "artifacts": artifacts}
    out_map = {"ok": "passed", "fail": "failed"}
    ver = [{"check": f"task {t.id} {name}", "outcome": out_map.get(c["status"], "inconclusive"), "details": c.get("log") or ""}
           for t in tasks for name, c in t.checks.items()]
    ver += [{"check": name, "outcome": out_map.get(c["status"], "inconclusive"), "details": c.get("log") or ""} for name, c in st.run_checks.items()]
    if run.finish:
        ver.append({"check": "final-deliverable gate", "outcome": "passed" if finished else "failed", "details": run.finish_evidence + (f" — {inv}" if inv else "")})
    rec["verification"] = ver
    replied = {m.re for m in st.mail if m.re}
    rec["current_state"] = {
        "status": "finished" if finished else "in_progress",
        "working": [f"task {t.id} {t.title}" + (f" — {t.final_note}" if t.final_note else "") for t in done],
        "remaining": [f"task {t.id} {t.title} ({t.state.replace('_', ' ')})" for t in tasks if t.state not in ("done", "blocked")],
        "blockers": [f"task {t.id} {t.title}: {t.note or t.detail}" for t in tasks if t.state == "blocked"],
        "open_questions": [f"#{m.seq} {m.sender} -> {m.to}: {m.msg}" for m in st.mail if m.ask and m.seq not in replied]
                          + [x.msg for x in st.learned if x.kind == "question"],
        "next_steps": [f"{mk} task {t.id}: {why}" for mk, t, why in attention(st, now)],
    }
    rec["tags"] = [x for x in ("orchestrate", str(d.get("strategy") or ""), str(d.get("engine") or "")) if x]
    out = _strip(rec)
    out["scope"] = scopes   # required by the schema; [] means project-wide
    return out


def render_resume(st: State, probe: bool = True) -> str:
    now = time.time()
    run, d = st.run, st.run.dims
    ws = st.ws
    head = git("rev-parse", "HEAD")
    L: list[str] = []
    L.append(f"# RESUME · {st.meta.get('repo', '')} @ {st.meta.get('branch', '?')} · run {run.id or '?'}")
    L.append("## Goal")
    L.append(str(d.get("goal") or "(not recorded — read run.md)"))
    L.append("## Current state")
    inv = finish_invalid(st)
    ctx = " · ".join(x for x in (d.get("strategy", ""), f"review {d['review']}" if d.get("review") else "",
                                  f"plan {run.plan or 'pending'}",
                                  (f"final gate {run.finish}" + (f" (INVALID: {inv})" if inv else "")) if run.finish else "") if x)
    L.append(ctx)
    b = run.budget
    if b or st.stints:
        L.append(f"budget: agents {len(st.stints)}" + (f"/{b['agents']}" if b.get("agents") else "") +
                 (f" · tokens {fmt_tokens(run.tokens)}" + (f"/{b['tokens']}" if b.get("tokens") else "") if run.tokens or b.get("tokens") else ""))
    for col in ("done", "in_progress", "review", "blocked", "todo"):
        cards = [t for t in st.ordered() if t.state == col]
        if not cards:
            continue
        L.append(f"- {LABELS[col].lower()} ({len(cards)}):")
        for t in cards:
            extra = ""
            if col == "in_progress":
                extra = f" — {t.agent or 'dispatched'}{' · ' + t.model if t.model else ''} · {fmt_dur(now - t.since)}"
                if is_stale(t, now):
                    extra += f" · STALE {fmt_dur(now - t.last_activity)} (NOT_PROVEN alive)"
            elif col == "review":
                extra = " — " + (" · ".join(f"{k} {v if not v.startswith('..') else 'NOT_PROVEN'}" for k, v in t.gates.items()) or "awaiting review")
            if col in ("in_progress", "review") and t.checks:
                extra += " · checks: " + ", ".join(f"{k} {v['status']}" for k, v in t.checks.items())
            elif col == "blocked":
                extra = f" — {t.note or t.detail}"
            elif col == "done":
                extra = f" — {t.final_note}"
            L.append(f"  - task {t.id} {t.title}{extra}")
    if st.open_stints():
        L.append("## Open stints (locators — verify, never assume alive)")
        for s in st.open_stints():
            L.append(f"- {s.agent} · {s.role} · task {s.task} · {s.model or '?'}" + (f" · {s.engine}" if s.engine else "") +
                     (f" · worktree {s.worktree}" if s.worktree else "") + (f" · session {s.session}" if s.session else "") +
                     (f" · log {s.log}" if s.log else "") + f" · since {hhmm(s.started)} · heartbeat {hhmm(s.heartbeat_ts)}")
            if s.session and (s.engine or "claude") in RESUME_CMD:
                L.append(f"  resume: {RESUME_CMD[s.engine or 'claude'].format(id=s.session)}")
            elif s.engine and s.engine != "claude":
                L.append(f"  resume: NOT_PROVEN — no session id journaled; find it in the engine's store, never resume \"last\"")
    mine = st.unread("controller")
    if mine or any(m.ask for m in st.mail):
        L.append("## Mail")
        for m in mine:
            L.append(f"- #{m.seq} from {m.sender}{' [ask]' if m.ask else ''}: {m.msg}")
        if not mine:
            L.append("- nothing unread for the controller")
    if st.learned:
        L.append("## Learned (workers' one-liners — promote to field-guide.md / decisions.md, or let the memory record carry them)")
        for x in st.learned[-12:]:
            L.append(f"- [{x.kind}] {x.agent} · task {x.task}: {x.msg}" + (f" ({x.path})" if x.path else ""))
        if len(st.learned) > 12:
            L.append(f"- … {len(st.learned) - 12} more: board learn")
    if run.decisions:
        L.append("## Key decisions")
        for dec in run.decisions[-8:]:
            owner = f" ({dec['owner']})" if dec.get("owner") else ""
            L.append(f"- {dec['id']}{owner}: {dec['msg']}" + (f" — why: {dec['why']}" if dec.get("why") else ""))
        if len(run.decisions) > 8:
            L.append(f"- … {len(run.decisions) - 8} more in .orchestrate/decisions.md")
    L.append("## Files & pointers" + (" (probed)" if probe else ""))
    L.append(f"- ledger: .orchestrate/progress.md · journal: .orchestrate/{JOURNAL} · run: .orchestrate/run.md")

    def mark(p: str) -> str:
        if not probe:
            return p
        return p if (ws / p).exists() else f"{p} [MISSING]"

    for t in st.ordered():
        ptrs = ([t.report] if t.report else []) + t.findings
        if ptrs:
            L.append(f"- task {t.id}: " + " · ".join(mark(p) for p in ptrs))
    L.append("## Open work (in order)")
    nxt = [t for t in st.ordered() if t.state in ("blocked", "review", "in_progress", "todo")]
    if not nxt:
        L.append("- none — every task is terminal" + ("; final gate pending" if not run.finish else ""))
    for t in nxt:
        L.append(f"- task {t.id} {t.title}: {t.state.replace('_', ' ')}" +
                 (f" — {t.note or t.detail}" if t.state == "blocked" else ""))
    wts = sorted({s.worktree for s in st.stints if s.worktree})
    if wts:
        L.append("## Cleanup")
        L.append("- worktrees to account for: " + ", ".join(wts))
    L.append("## Receipt")
    done_n = sum(1 for t in st.tasks.values() if t.state == "done")
    if run.tokens:
        L.append(f"- tokens {fmt_tokens(run.tokens)} · accepted tasks {done_n}" +
                 (f" · per accepted task {fmt_tokens(run.tokens // done_n)}" if done_n else ""))
    receipt = f"head {head[:12] or '?'} · journal seq {run.last_seq} hash {run.last_hash[:12] or '-'} · generated {now_utc()}"
    L.append(f"- {receipt}")
    L.append(f"- receipt-hash {sha(receipt)[:16]}  (a resume whose head or journal cursor differs is stale — regenerate)")
    L.append("## Handoff rule")
    L.append("State above is generated; NOT_PROVEN marks claims no artifact backs. Add the WHY — decisions' reasons, traps & "
             "dead ends — then probe-test it (shared-handoff.md). Trust the ledger + git log over any summary, this one included.")
    hint = memory_hint(ws, st, "handoff")
    if hint:
        L.append("## Project memory")
        L.append(f"- {hint}")
    return "\n".join(L)


def render_task(st: State, tid: str, S: Style) -> str:
    t = st.tasks.get(tid)
    if not t:
        return f"board: no task {tid}"
    now = time.time()
    lines = [f"task {t.id}  {t.title}  [{t.state.replace('_', ' ')}]"]
    for label, segs in card_details(t, st, now, S):
        lines.append(f"  {pad(label, 10)}{row_text(segs)}")
    return "\n".join(lines)


def render_attention(st: State) -> str:
    att = attention(st, time.time())
    if not att:
        return "board: nothing needs attention"
    return "\n".join(f"{mk} task {t.id} {t.title}: {why}" for mk, t, why in att)


def to_json(st: State) -> dict:
    now = time.time()
    return {
        "run": {"id": st.run.id, "dims": st.run.dims, "plan": st.run.plan, "finish": st.run.finish, "branch": st.run.branch,
                "base": st.run.base, "tokens": st.run.tokens, "agents": len(st.stints), "last_seq": st.run.last_seq},
        "lanes": st.lanes,
        "tasks": [{"id": t.id, "title": t.title, "state": t.state, "lane": st.lane_of(t), "agent": t.agent, "model": t.model,
                   "gates": t.gates, "checks": t.checks, "attempt": t.attempt, "stale": is_stale(t, now), "report": t.report,
                   "findings": t.findings, "note": t.note}
                  for t in st.ordered()],
        "stints": [vars(s) for s in st.stints],
        "mail": [vars(m) for m in st.mail], "learn": [vars(x) for x in st.learned], "acks": st.acks,
        "attention": [{"mark": mk, "task": t.id, "why": why} for mk, t, why in attention(st, now)],
        "problems": st.problems,
    }


# --- lanes: launch · lane-exit · receipt -------------------------------------------------------------

def render_wrapper(ws: Path, task: str, agent: str, engine: str, model: str, effort: str, session: str, spec: Path,
                   cwd: Path, extra: list[str], after: list[str] | None = None) -> tuple[str, str, str]:
    """The lane's wrapper script text plus its log and usage paths (relative to .orchestrate/)."""
    tpl = ENGINES[engine]
    log = f"raw/lane-{task}-{agent}.jsonl"
    usage = f"raw/lane-{task}-{agent}.usage.json"
    out = f"raw/lane-{task}-{agent}.out.md"
    fill = {"repo": str(cwd), "model": model, "effort": effort or "high", "session": session, "spec": str(spec),
            "out": str(ws / out), "usage": str(ws / usage)}
    parts = []
    for a in tpl["argv"]:
        if a == "{spec_text}":
            parts.append(f'"$(cat {shlex.quote(str(spec))})"')
        else:
            parts.append(shlex.quote(a.format(**fill)))
    parts += [shlex.quote(x) for x in extra]
    stdin = f"< {shlex.quote(str(spec))}" if tpl["prompt"] == "stdin" else "</dev/null"
    me = Path(__file__).resolve()
    me_q, agent_q, task_q = shlex.quote(str(me)), shlex.quote(agent), shlex.quote(task)
    gate = ""
    if after:
        deps = " ".join(f"--task {shlex.quote(x)}" for x in after)
        # exit 3 (a dependency cannot land) / 2 (unknown task) → 125: the engine never starts; 124 stays a timeout
        gate = (f"{me_q} wait --agent {agent_q} {deps} --timeout 0 --peek > {shlex.quote(str(ws / (log[:-6] + '.wait')))} 2>&1 "
                f"|| {{ rc=$?; [ \"$rc\" = 124 ] || rc=125; {me_q} lane-exit {task_q} --agent {agent_q} --exit \"$rc\"; exit \"$rc\"; }}")
    script = "\n".join([
        "#!/bin/sh",
        f"# board launch · task {task} · {agent} · {engine} {model} @ {effort or 'high'}" + (f" · session {session}" if session else "") +
        (f" · after task {', '.join(after)}" if after else ""),
        f"cd {shlex.quote(str(cwd))}",
        f"export ORCHESTRATE_WS={shlex.quote(str(ws.resolve()))}   # every board call inside the lane resolves THIS run, worktree or not",
        f"export PATH={shlex.quote(str(me.parent))}:$PATH",
        f"export BOARD_AGENT={agent_q}   # a lane that dispatches its own workers is their lead: --by defaults to this"] + ([gate] if gate else []) + [
        f"{' '.join(parts)} {stdin} > {shlex.quote(str(ws / log))} 2> {shlex.quote(str(ws / (log[:-6] + '.err')))}",
        "rc=$?",
        f"{shlex.quote(str(me))} lane-exit {shlex.quote(task)} --agent {shlex.quote(agent)} --exit \"$rc\"",
        "exit $rc", ""])
    return script, log, usage


def _json_lines(path: Path) -> list[dict]:
    out = []
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if line.startswith("{"):
                try:
                    out.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
    except OSError:
        pass
    return out


def fetch_receipt(ws: Path, s: Stint) -> dict:
    """Usage after a lane exits, per engine: {tokens, calls, cost, session, source} — empty when the engine has none."""
    method = ENGINES.get(s.engine, {}).get("receipt", "none")
    log = ws / s.log if s.log else None
    try:
        if method == "grok-usage" and s.session:
            cp = subprocess.run(["grok", "usage", s.session], capture_output=True, text=True, timeout=30)
            d = json.loads(cp.stdout or "{}").get("session", {})
            if d:
                return {"tokens": int(d.get("totalTokens") or 0), "calls": int(d.get("modelCalls") or 0), "source": "grok usage"}
        elif method == "codex-log" and log:
            evs = _json_lines(log)
            session = next((e.get("thread_id") for e in evs if e.get("type") == "thread.started"), "")
            done = [e for e in evs if e.get("type") == "turn.completed"]
            u = (done[-1].get("usage") or {}) if done else {}
            tok = int(u.get("input_tokens") or 0) + int(u.get("output_tokens") or 0)
            if tok or session:
                return {"tokens": tok, "calls": len(done), "session": session, "source": "turn.completed.usage"}
        elif method == "claude-log" and log:
            res = [e for e in _json_lines(log) if e.get("type") == "result"]
            if res:
                u = res[-1].get("usage") or {}
                tok = sum(int(u.get(k) or 0) for k in ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
                return {"tokens": tok, "calls": int(res[-1].get("num_turns") or 0), "cost": float(res[-1].get("total_cost_usd") or 0),
                        "session": str(res[-1].get("session_id") or ""), "source": "result event"}
        elif method == "hermes-usage":
            up = ws / f"raw/lane-{s.task}-{s.agent}.usage.json"
            if up.exists():
                d = json.loads(up.read_text(encoding="utf-8"))
                flat = {k.lower(): v for k, v in (d.items() if isinstance(d, dict) else [])}
                tok = next((int(v) for k, v in flat.items() if "total" in k and "token" in k and str(v).isdigit()), 0) or \
                    sum(int(v) for k, v in flat.items() if k.endswith("_tokens") and str(v).isdigit())
                cost = next((float(v) for k, v in flat.items() if "cost" in k and isinstance(v, (int, float))), 0.0)
                calls = next((int(v) for k, v in flat.items() if "call" in k and str(v).isdigit()), 0)
                if tok or cost:
                    return {"tokens": tok, "calls": calls, "cost": cost, "source": "--usage-file"}
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return {}


def dep_landed(st: "State", d: Task) -> bool:
    """A dependency has landed when its work is on disk: returned, done, or its lane exited with a report written.
    Waiting on the controller's return alone would make every waiter pay for the controller's latency."""
    if d.returned or d.state == "done":
        return True
    exited = [s for s in st.stints if s.task == d.id and s.exit_code is not None and not s.returned]
    return bool(exited) and (st.ws / f"task-{d.id}-report.md").exists()


def dep_failed(st: "State", d: Task) -> str:
    """Why a dependency can never land (empty = it still can): returned BLOCKED/NEEDS_CONTEXT/REFUSED, blocked by
    the controller, or its latest lane died with no report. A waiter that keeps waiting for it would wait forever;
    a gated wrapper that started its engine on it would pay for a lane with a missing input."""
    if d.state == "done":
        return ""
    if d.returned and d.last_status in ("BLOCKED", "NEEDS_CONTEXT", "REFUSED"):
        return f"returned {d.last_status}"
    if d.state == "blocked":
        return d.detail or d.note or "blocked"
    mine = [s for s in st.stints if s.task == d.id]
    if mine and not mine[-1].returned and mine[-1].exit_code not in (None, 0) and not (st.ws / f"task-{d.id}-report.md").exists():
        return f"lane {mine[-1].agent} exited rc={mine[-1].exit_code} with no report"
    return ""


def observe(ws: Path, fallback: str = "", actor: str = "worker", **fields: object) -> dict | None:
    """A worker-side journal write. In a read-only lane (codex --sandbox read-only, claude --restricted) it degrades
    to a printed line the worker can carry in its inline return — never a traceback in the model's context."""
    try:
        return append_event(ws, actor=actor, **fields)
    except OSError as exc:
        print(f"board: journal not writable from this lane ({exc.__class__.__name__}: {exc}) — "
              + (f"put this line in your inline return so the controller records it: {fallback}" if fallback else "nothing recorded"))
        return None


def deliver(ws: Path, agent: str) -> None:
    """Piggyback delivery: any board call a worker makes also hands over its digest — unread mail, peers' learnings,
    record changes since its dispatch — and acks the batch."""
    if not agent or agent == "controller":
        return
    st = load(ws)
    text, items = render_inbox(st, agent)
    if not items:
        return
    if any(isinstance(x, Mail) for x in items):
        print(f"mail for {agent}:")
    print(text)
    ack(ws, agent, items)


def follow(ws: Path, since: int, kinds: set[str] | None, for_: str, timeout: int) -> int:
    """A filtered journal tail for controllers and hooks: one line per new event; ends on `finish` (0) or timeout (124)."""
    deadline = time.time() + timeout if timeout else None
    seen = since
    while True:
        evs, _ = read_events(ws)
        for e in evs:
            seq = int(e.get("seq", 0))
            if seq <= seen:
                continue
            seen = seq
            ev = str(e.get("ev", ""))
            if kinds and ev not in kinds:
                continue
            if for_ and not ((ev == "mail" and str(e.get("to")) in (for_, "all")) or ev in ("return", "exit", "blocked", "gate", "vote", "done", "finish", "escalate")
                             or (ev == "check" and e.get("status") == "fail")):
                continue
            print(render_log([e]), flush=True)
            if ev == "finish":
                return 0
        if deadline and time.time() >= deadline:
            return 124
        time.sleep(0.5)


# --- commands ------------------------------------------------------------------------

def workspace_shape(ws: Path, st: State) -> tuple[str, str]:
    """(shape, summary) — `empty` · `pre-journal` (artifacts, no run record) · `open` (unfinished run) · `finished`."""
    artifacts = [p.name for p in ws.glob("task-*") if ws.exists()] + (["progress.md"] if (ws / "progress.md").exists() else [])
    counts = {c: sum(1 for x in st.tasks.values() if x.state == c) for c in COLUMNS}
    summary = " · ".join(f"{n} {c.replace('_', ' ')}" for c, n in counts.items() if n)
    if not st.run.dims and (artifacts or st.tasks):
        return "pre-journal", summary or f"{len(artifacts)} artifact(s)"
    if not st.run.dims:
        return "empty", ""
    open_ = [x for x in st.tasks.values() if x.state != "done"]
    if st.run.finish and not open_:
        return "finished", summary
    return "open", summary


def archive_previous_run(ws: Path, run_id: str) -> Path | None:
    """A new run gets a fresh workspace; the old one moves to archive/<run_id>/ (journal included)."""
    if not ws.exists():
        return None
    dest = ws / "archive" / (run_id or "unknown")
    moved = False
    for p in list(ws.iterdir()):
        if p.name in KEEP_ON_ARCHIVE or p.name.endswith(".bak") or p.name.endswith(".tmp"):
            continue
        dest.mkdir(parents=True, exist_ok=True)
        shutil.move(str(p), str(dest / p.name))
        moved = True
    return dest if moved else None


def cmd_init(ws: Path, args: argparse.Namespace) -> None:
    dims: dict[str, object] = {}
    for key in DIMS:
        val = getattr(args, key, None)
        if val in (None, ""):
            continue
        if key in ("models", "budget"):
            dims[key] = parse_kv(val)
        elif key == "effort" and re.search(r"[=:]", val):
            dims[key] = parse_kv(val)
        else:
            dims[key] = val
    prev = load(ws)
    shape, summary = workspace_shape(ws, prev)
    archived = None
    adopting = args.resume and shape == "pre-journal"
    if not args.resume and shape in ("open", "pre-journal") and not args.fresh:
        layout = "no run record — a workspace from before the journal" if shape == "pre-journal" else f"run {prev.run.id} unfinished"
        sys.exit(f"board: .orchestrate/ already holds work ({summary}; {layout}).\n"
                 f"       adopt it:    board init PLAN --resume --strategy … --goal \"…\"   (journal started, ledger/reports kept, Resolved block above run.md's prose)\n"
                 f"       start over:  board init PLAN --fresh …                          (archives it to .orchestrate/archive/<run-id>/ first)")
    if (prev.events or shape == "pre-journal") and not args.resume:
        archived = archive_previous_run(ws, prev.run.id or f"legacy-{dt.datetime.now().strftime('%Y%m%d-%H%M%S')}")
    if dims or not args.resume:
        run_id = prev.run.id if args.resume and prev.run.id else new_run_id()
        append_event(ws, ev="run", run_id=run_id, branch=git("rev-parse", "--abbrev-ref", "HEAD"), base=git("rev-parse", "HEAD"),
                     cli=f"board schema {SCHEMA}", **dims)
    if adopting:
        append_event(ws, ev="adopt", msg=f"pre-journal workspace adopted ({summary}); history before this line lives on disk only")
    st = load(ws)
    added = 0
    if args.plan:
        text = Path(args.plan).read_text(encoding="utf-8", errors="replace")
        fence = False
        for line in text.splitlines():
            if line.startswith("```"):
                fence = not fence
                continue
            if fence:
                continue
            m = re.match(r"^#+\s+Task\s+(\S+?)\s*(?:[:—–-]\s*(.+))?$", line)
            if m:
                tid, title = m.group(1), clean((m.group(2) or "").strip())
                if tid not in st.tasks:
                    append_event(ws, task=tid, ev="todo", title=title)
                    added += 1
                elif title and st.tasks[tid].title != title:   # a plan heading outranks a brief's first line
                    append_event(ws, task=tid, ev="title", title=title)
    else:
        seen = {str(e.get("task")) for e in st.events if e.get("task") is not None}
        for t in st.tasks.values():
            if t.id not in seen:
                append_event(ws, task=t.id, ev="todo", title=t.title)
                added += 1
    write_resolved(ws)
    if archived:
        print(f"board: previous run archived -> {archived}")
    if adopting:
        print(f"board: adopted a pre-journal workspace ({summary}) — ledger and reports kept, journal started here; "
              "`board check --replay` marks pre-journal history inconclusive, not wrong")
    print(f"board: {added} task(s) queued -> {journal_path(ws)}")
    if dims:
        print("board: run.md Resolved block written; next: `board plan` → gate → `board plan approved`")
    print("board: open a pane and run  board  (or .orchestrate/board) to watch")
    hint = memory_hint(ws, load(ws), "init")
    if hint:
        print(f"board: {hint}")


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="board", add_help=True, description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--selftest", action="store_true", help=argparse.SUPPRESS)
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("watch"); p.add_argument("--here", action="store_true", help="this repo's run only — never follow another active run")
    sub.add_parser("runs", help="every run this machine knows about, newest activity first")
    p = sub.add_parser("show"); p.add_argument("--no-color", action="store_true")
    p.add_argument("-x", "--expanded", action="store_true", help="every card's lineage: agents, gates, evidence, decisions, action")
    p.add_argument("--attention", action="store_true", help="only cards that need action")
    p.add_argument("--json", action="store_true")
    sub.add_parser("path")
    p = sub.add_parser("agents"); p.add_argument("--json", action="store_true")
    p = sub.add_parser("check"); p.add_argument("--finish", action="store_true", help="the pre-finish gate: strict"); p.add_argument("--json", action="store_true")
    p.add_argument("--replay", action="store_true", help="cold replay: derive from the journal alone and diff against the disk view")
    sub.add_parser("postmortem")
    me = os.environ.get("BOARD_AGENT") or None   # inside a launched lane the worker's own name — no worker-side call needs --agent
    p = sub.add_parser("send", help="mail: information between agents, never a transition")
    p.add_argument("msg"); p.add_argument("--from", dest="sender", default=me, required=me is None); p.add_argument("--to", required=True)
    p.add_argument("--re", type=int, help="seq of the mail this answers"); p.add_argument("--ask", action="store_true", help="a question — the recipient owes ONE reply")
    p.add_argument("--push", action="store_true", help="print the host's native push binding for the recipient (never run)")
    p = sub.add_parser("inbox"); p.add_argument("--agent", default=me, required=me is None); p.add_argument("--peek", action="store_true"); p.add_argument("--json", action="store_true")
    p = sub.add_parser("wait", help="rendezvous: block until mail arrives, or until --task N's work is on disk (exit 3: it cannot land, 124: timeout)")
    p.add_argument("--agent", default=me or "controller"); p.add_argument("--timeout", type=int, default=WAIT_SLICE, help="seconds; 0 = no deadline")
    p.add_argument("--task", action="append", help="wait for this task's work instead of for mail (repeatable: all must have landed)")
    p.add_argument("--or-mail", action="store_true", help="with --task: return 5 as soon as mail for --agent arrives (a lead waiting on its workers must answer their asks)")
    p.add_argument("--peek", action="store_true", help="never ack: a wrapper waiting on behalf of an engine that has not started must not consume its digest")
    p = sub.add_parser("mail"); p.add_argument("--task"); p.add_argument("--json", action="store_true")
    p = sub.add_parser("peers"); p.add_argument("--agent", default=me, required=me is None)
    p = sub.add_parser("vote", help="one reviewer's verdict; the gate is derived by quorum (panel = majority, consensus = any-deny)")
    p.add_argument("task"); p.add_argument("--kind", required=True); p.add_argument("--agent", default=me, required=me is None)
    p.add_argument("--verdict", choices=["ok", "fail", "warn"], required=True); p.add_argument("--why"); p.add_argument("--round", type=int)
    p = sub.add_parser("learn", help="a worker's one-line discovery, handed to its team at their next board call — information, never a transition; no args: list the run's learnings")
    p.add_argument("task", nargs="?"); p.add_argument("msg", nargs="?"); p.add_argument("--agent", default=me)
    p.add_argument("--kind", choices=LEARN_KINDS, default="gotcha"); p.add_argument("--path", help="the file or area it is about"); p.add_argument("--json", action="store_true")
    p = sub.add_parser("memory", help="the run as one project-context record (JSON for `ctx append --input` / `ctx handoff --input`) — printed, never appended")
    g = p.add_mutually_exclusive_group(); g.add_argument("--observation", action="store_true"); g.add_argument("--handoff", action="store_true")
    p.add_argument("--scope", help="comma list of project-context scopes ([] = project-wide)"); p.add_argument("--out", help="write the JSON here instead of stdout")
    p = sub.add_parser("launch", help="the lane as one command: wrapper written, session pinned, dispatch journaled, started, receipt on exit")
    p.add_argument("task"); p.add_argument("--agent", help="<role>-<task>[-tag]; omitted = derived from --role and the task"); p.add_argument("--engine", required=True, choices=sorted(ENGINES))
    p.add_argument("--model", required=True); p.add_argument("--effort"); p.add_argument("--role"); p.add_argument("--owns")
    p.add_argument("--by", default=os.environ.get("BOARD_AGENT", ""), help="the lead launching this lane (default: the controller, or $BOARD_AGENT inside a lane)")
    p.add_argument("--worktree"); p.add_argument("--cwd", help="the lane's working directory (default: the repo root)")
    p.add_argument("--extra", default="", help="engine flags appended verbatim, knowingly (approval, sandbox, network): --extra='--always-approve'")
    p.add_argument("--after", help="comma list of tasks whose work must be on disk before the engine starts — the wrapper waits, the model never does")
    p.add_argument("--fg", action="store_true", help="run in the foreground (blocks; exit code passes through)")
    p.add_argument("--dry-run", action="store_true", help="print the wrapper, journal nothing, launch nothing")
    p.add_argument("--msg"); p.add_argument("spec", nargs="*", help="the brief/spec file (after --)")
    p = sub.add_parser("lane-exit"); p.add_argument("task"); p.add_argument("--agent", required=True); p.add_argument("--exit", type=int, required=True)
    p = sub.add_parser("receipt", help="journal a lane's usage: fetched per engine, or given explicitly")
    p.add_argument("task"); p.add_argument("--agent", required=True); p.add_argument("--tokens"); p.add_argument("--calls", type=int)
    p.add_argument("--cost", type=float); p.add_argument("--session")
    p = sub.add_parser("follow", help="filtered journal tail: one line per new event; ends on finish")
    p.add_argument("--kinds", help="comma list: mail,return,exit,check,vote,note,…"); p.add_argument("--for", dest="for_", help="controller: only what needs you")
    p.add_argument("--since", type=int, help="journal seq to start after (default: now)"); p.add_argument("--timeout", type=int, default=0)
    p = sub.add_parser("exec", help="run a check THROUGH the journal: board exec N --name tests [--agent you] -- npm test")
    p.add_argument("task"); p.add_argument("--name", required=True); p.add_argument("--agent", default=me, help="a worker running its own check")
    p.add_argument("command", nargs="*")
    p = sub.add_parser("result", help="journal a check that ran elsewhere")
    p.add_argument("task"); p.add_argument("--name", required=True); p.add_argument("--exit", type=int, required=True)
    p.add_argument("--dur"); p.add_argument("--log"); p.add_argument("--msg"); p.add_argument("--agent", default=me)
    p = sub.add_parser("resume"); p.add_argument("--no-probe", action="store_true")
    p = sub.add_parser("task"); p.add_argument("task")
    sub.add_parser("attention")
    p = sub.add_parser("log"); p.add_argument("-n", type=int, default=40); p.add_argument("--json", action="store_true")
    p = sub.add_parser("init"); p.add_argument("plan", nargs="?")
    p.add_argument("--resume", action="store_true", help="adopt/continue the workspace that is there (journal kept or started; nothing archived)")
    p.add_argument("--fresh", action="store_true", help="archive unfinished work on purpose and start a new run")
    for key in DIMS:
        p.add_argument(f"--{key}")
    p = sub.add_parser("set"); p.add_argument("pairs", nargs="+", metavar="key=value")
    p = sub.add_parser("plan"); p.add_argument("outcome", nargs="?", choices=["approved", "changed", "skipped"])
    p.add_argument("--msg"); p.add_argument("--why")
    p = sub.add_parser("todo"); p.add_argument("task"); p.add_argument("title", nargs="?")
    for name in ("dispatch", "return", "review", "gate", "done", "blocked", "note", "nudge", "escalate"):
        p = sub.add_parser(name)
        p.add_argument("task")
        if name == "note":
            p.add_argument("msg")
        else:
            p.add_argument("--msg")
        p.add_argument("--agent", default=me if name == "note" else None)
        p.add_argument("--model")
        p.add_argument("--engine")
        if name == "dispatch":
            p.add_argument("--role"); p.add_argument("--effort"); p.add_argument("--worktree")
            p.add_argument("--session", help="the engine's session id (pre-pinned where the engine allows)")
            p.add_argument("--owns", help="exclusive files/areas (globs) — what peers must ask before touching")
            p.add_argument("--by", default=os.environ.get("BOARD_AGENT", ""), help="who dispatches this stint — a lead (sub-orchestrator) names itself; default: the controller (or $BOARD_AGENT inside a lane)")
            p.add_argument("--log", help="captured event stream, relative to .orchestrate/"); p.add_argument("--cmd-file", help="the wrapper script")
            p.add_argument("--reset-gates", action="store_true", help="(implicit: every implementer dispatch is a new attempt)")
        if name == "return":
            p.add_argument("--status", choices=STATUSES, required=True)
            p.add_argument("--commits"); p.add_argument("--report"); p.add_argument("--observed-model"); p.add_argument("--tokens")
            p.add_argument("--session", help="the engine's session id, if only known after the launch")
        if name in ("review", "gate"):
            p.add_argument("--kind", required=True); p.add_argument("--round", type=int)
        if name == "gate":
            p.add_argument("--verdict", choices=["ok", "fail", "warn"], required=True); p.add_argument("--findings")
        if name == "escalate":
            p.add_argument("--to", required=True); p.add_argument("--why", required=True)
    p = sub.add_parser("decide"); p.add_argument("id"); p.add_argument("msg"); p.add_argument("--why", help="the rationale — the least recoverable fact; the memory record carries it")
    p.add_argument("--owner"); p.add_argument("--task")
    p = sub.add_parser("rail"); p.add_argument("msg")
    p = sub.add_parser("finish"); p.add_argument("--gate", choices=["pass", "fail"], required=True)
    p.add_argument("--evidence"); p.add_argument("--msg"); p.add_argument("--force", action="store_true"); p.add_argument("--reason")
    return ap


def main(argv: list[str]) -> int:
    tail: list[str] = []
    if argv and argv[0] in ("exec", "launch") and "--" in argv:  # everything after -- is verbatim
        tail, argv = argv[argv.index("--") + 1:], argv[:argv.index("--")]
    args = build_parser().parse_args(argv)
    if tail and argv and argv[0] == "exec":
        args.command = tail
    elif tail:
        args.spec = tail
    if args.selftest:
        return selftest()
    cmd = args.cmd
    if cmd in (None, "watch", "runs"):
        # The pane follows the machine's most recently active run (any repo) unless pinned with --here.
        here = workspace_or_none()
        pinned = bool(getattr(args, "here", False))
        if pinned:
            os.environ["BOARD_PINNED"] = "1"
        ws_ = here if pinned else latest_run_ws(here)
        if cmd == "runs":
            rows_ = []
            for r in registry_runs():
                age = fmt_dur(time.time() - float(r.get("last", 0)))
                rows_.append([r.get("repo", "?"), str(r.get("run", ""))[:22], f"{age} ago", "← here" if here and Path(r["ws"]).resolve() == here.resolve() else "", r["ws"]])
            print(table(["repo", "run", "last activity", "", "workspace"], rows_) if rows_ else "board: no runs registered yet")
            return 0
        if ws_ is None:
            sys.exit("board: not inside a git repository and no run is registered yet")
        if cmd is None and not sys.stdout.isatty():
            ws, cmd, args.no_color, args.expanded, args.attention, args.json = workspace(), "show", True, False, False, False
        else:
            cmd_watch(ws_)
            return 0
    else:
        ws = workspace()
    global GIT_CWD
    GIT_CWD = ws.resolve().parent if ws.exists() or ws.parent.exists() else None
    if cmd == "watch":
        cmd_watch(ws)
    elif cmd == "show":
        st = load(ws)
        if args.json:
            print(json.dumps(to_json(st), ensure_ascii=False, indent=1, default=str))
            return 0
        try:
            width = int(os.environ.get("BOARD_WIDTH") or os.get_terminal_size().columns)
        except (OSError, ValueError):
            width = 100
        color = sys.stdout.isatty() and not args.no_color and not os.environ.get("NO_COLOR")
        rows, _ = build_rows(st, width, View(args.expanded, "", args.attention, Style(color)))
        print("\n".join(row_render(r, color) for r in rows))
    elif cmd == "path":
        print(journal_path(ws))
    elif cmd == "agents":
        st = load(ws)
        print(json.dumps([vars(s) for s in st.stints], indent=1, default=str) if args.json else render_agents(st))
    elif cmd == "task":
        print(render_task(load(ws), args.task, Style(False)))
    elif cmd == "attention":
        print(render_attention(load(ws)))
    elif cmd == "log":
        evs, _ = read_events(ws)
        evs = evs[-args.n:]
        print("\n".join(json.dumps(e, ensure_ascii=False) for e in evs) if args.json else render_log(evs))
    elif cmd == "check":
        st = load(ws)
        findings = check(st, args.finish) + (replay(st) if args.replay else [])
        if args.json:
            print(json.dumps({"ok": not findings, "findings": findings}, indent=1))
        else:
            for f in findings:
                print(f"check: {f}")
            print("board: check OK — journal and disk agree" if not findings else f"board: {len(findings)} finding(s)")
        return 1 if findings else 0
    elif cmd == "resume":
        print(render_resume(load(ws), probe=not args.no_probe))
    elif cmd == "postmortem":
        print(render_postmortem(load(ws)))
    elif cmd == "launch":
        spec_args = [a for a in (args.spec or []) if a != "--"]
        if len(spec_args) != 1:
            sys.exit("board: launch needs exactly one spec file after --  (board launch N --agent A --engine grok --model M -- .orchestrate/task-N-brief.md)")
        spec = Path(spec_args[0]).resolve()
        if not spec.exists():
            sys.exit(f"board: spec {spec} does not exist")
        cwd = Path(args.cwd).resolve() if args.cwd else Path(git("rev-parse", "--show-toplevel") or os.getcwd())
        tpl = ENGINES[args.engine]
        session = str(__import__("uuid").uuid4()) if tpl["session"] == "pin" else ""
        st0 = load(ws)
        agent = check_agent(clean(args.agent), st0, str(args.task), args.role or "") if args.agent else agent_name(st0, str(args.task), args.role or "")
        after = [x.strip() for x in (args.after or "").split(",") if x.strip()]
        script, log, usage = render_wrapper(ws, str(args.task), agent, args.engine, args.model, args.effort or "", session, spec, cwd,
                                            shlex.split(args.extra or ""), after)
        if args.dry_run:
            print(script, end="")
            return 0
        (ws / "raw").mkdir(parents=True, exist_ok=True)
        cmd_file = f"raw/lane-{args.task}-{agent}.sh"
        (ws / cmd_file).write_text(script, encoding="utf-8")
        (ws / cmd_file).chmod(0o755)
        if args.fg:
            append_event(ws, actor=args.by or "controller", task=args.task, ev="dispatch", agent=agent, role=args.role, model=args.model, engine=args.engine,
                         effort=args.effort, worktree=args.worktree, session=session, log=log, cmd_file=cmd_file, owns=args.owns,
                         after=",".join(after), by=args.by, msg=args.msg)
            rc = subprocess.run(["/bin/sh", str(ws / cmd_file)]).returncode
            print(f"board: lane {agent} finished rc={rc} — read .orchestrate/task-{args.task}-report.md, then board return")
            return rc
        proc = subprocess.Popen(["/bin/sh", str(ws / cmd_file)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL, start_new_session=True)
        append_event(ws, actor=args.by or "controller", task=args.task, ev="dispatch", agent=agent, role=args.role, model=args.model, engine=args.engine,
                     effort=args.effort, worktree=args.worktree, session=session, log=log, cmd_file=cmd_file, owns=args.owns,
                     pid=proc.pid, after=",".join(after), by=args.by, msg=args.msg)
        print(f"board: lane {agent} launched (pid {proc.pid}, {args.engine} {args.model} @ {args.effort or 'high'})" +
              (f" · queued after task {', '.join(after)} — the engine starts when their work is on disk" if after else "") +
              (f" · session {session}" if session else "") + f"\n       log .orchestrate/{log} · wrapper .orchestrate/{cmd_file} · exit and receipt are journaled when it ends")
    elif cmd == "lane-exit":
        agent = clean(args.agent)
        append_event(ws, task=args.task, ev="exit", agent=agent, exit=args.exit)
        st = load(ws)
        s = st.stint_of(agent)
        r = fetch_receipt(ws, s) if s and args.exit not in (124, 125) else {}   # a gate exit: the engine never ran, nothing to bill
        if r:
            append_event(ws, task=args.task, ev="receipt", agent=agent, tokens=r.get("tokens"), calls=r.get("calls"),
                         cost=r.get("cost"), session=r.get("session"), source=r.get("source"))
        print(f"board: lane {agent} exit {args.exit}" + (f" · receipt {fmt_tokens(int(r.get('tokens') or 0))} via {r.get('source')}" if r else
              (" · engine never started (dependency gate)" if args.exit in (124, 125) else " · receipt NOT_PROVEN (engine offers none, or fetch failed)")))
    elif cmd == "receipt":
        agent = clean(args.agent)
        st = load(ws)
        s = st.stint_of(agent)
        if not s:
            sys.exit(f"board: {agent} has no stint")
        r = {"tokens": args.tokens, "calls": args.calls, "cost": args.cost, "session": args.session, "source": "controller"} if \
            (args.tokens or args.calls or args.cost or args.session) else fetch_receipt(ws, s)
        if not r:
            sys.exit(f"board: no receipt for {agent} — the engine offers none here; pass --tokens explicitly")
        append_event(ws, task=args.task, ev="receipt", agent=agent, tokens=r.get("tokens"), calls=r.get("calls"),
                     cost=r.get("cost"), session=r.get("session"), source=r.get("source"))
        print(f"board: receipt for {agent}: {r.get('tokens') or '?'} tokens" + (f", {r['calls']} calls" if r.get("calls") else "") + f" ({r.get('source')})")
    elif cmd == "follow":
        kinds = {k.strip() for k in args.kinds.split(",") if k.strip()} if args.kinds else None
        since = args.since if args.since is not None else load(ws).run.last_seq
        return follow(ws, since, kinds, args.for_ or "", args.timeout)
    elif cmd == "send":
        st = load(ws)
        sender, to, msg = clean(args.sender), clean(args.to), clean(args.msg)
        if not msg.strip():
            sys.exit("board: send needs a message")
        to, routed = st.resolve_to(sender, to)
        if to not in ("controller", "all"):
            s_to = st.stint_of(to)
            if not s_to or s_to.returned:
                sys.exit(f"board: {to} has no open stint — mail the controller instead (--to controller)")
        if sender != "controller":
            s_me = st.open_stint(sender, "")
            if s_me and s_me.sent >= MAIL_CAP:
                sys.exit(f"board: {sender} has sent {s_me.sent} mails this stint (cap {MAIL_CAP}) — put it in your report, or return NEEDS_CONTEXT")
        if args.re:
            by_seq = {m.seq: m for m in st.mail}
            if args.re not in by_seq:
                sys.exit(f"board: --re {args.re} is not a mail")
            depth, cur = 1, by_seq[args.re]
            while cur.re and cur.re in by_seq:
                cur, depth = by_seq[cur.re], depth + 1
            if depth > THREAD_CAP:
                sys.exit(f"board: thread #{args.re} is {depth} deep (cap {THREAD_CAP}) — this is a meeting, not a message: decide, or escalate to the controller")
        if any(m.sender == sender and m.to == to and m.msg == msg for m in st.mail):
            sys.exit("board: identical mail already sent — the recipient reads at its next checkpoint")
        ev = observe(ws, f"board send {shlex.quote(msg)} --from {sender} --to {to}" + (" --ask" if args.ask else "") + (f" --re {args.re}" if args.re else ""),
                     actor="controller" if sender == "controller" else "worker", ev="mail", **{"from": sender},
                     to=to, msg=msg, re=args.re, ask=bool(args.ask))
        if not ev:
            return 0
        print(f"board: mail #{ev['seq']} {sender} -> {to}" + (" [ask — the recipient owes one reply]" if args.ask else "") +
              " · delivered at the recipient's next checkpoint" + (f" · {routed}" if routed else ""))
        if args.push and to not in ("controller", "all"):
            s_to = st.stint_of(to)
            if s_to and s_to.engine in ("", "claude") and not s_to.session:
                print(f"push: SendMessage to:{to} \"mail #{ev['seq']} waiting — board inbox --agent {to}\"  (Claude Code teams/subagents)")
            elif s_to and s_to.session and (s_to.engine or "claude") in RESUME_CMD:
                print(f"push: {RESUME_CMD[s_to.engine or 'claude'].format(id=s_to.session)}   (between turns only — never `codex queue`)")
            else:
                print("push: NOT_PROVEN — no session id journaled for the recipient; it reads at its next checkpoint")
        deliver(ws, sender)
    elif cmd == "inbox":
        st = load(ws)
        agent = clean(args.agent)
        out, items = render_inbox(st, agent)
        if args.json:
            print(json.dumps([vars(m) for m in items if isinstance(m, Mail)], ensure_ascii=False, indent=1, default=str))
        else:
            print(out)
        if items and not args.peek:
            ack(ws, agent, items)
    elif cmd == "wait":
        agent = clean(args.agent)
        deadline = (time.time() + args.timeout) if args.timeout > 0 else float("inf")   # 0 = forever (wrappers)

        def idle() -> None:  # sleep until the workspace changes (or ~2 s), never a hot re-read of the journal
            sig = signature(ws)
            for _ in range(4):
                time.sleep(0.5)
                if signature(ws) != sig or time.time() >= deadline:
                    return

        while True:
            st = load(ws)
            if args.task:
                deps = [st.tasks.get(str(x)) for x in args.task]
                unknown = [x for x, d in zip(args.task, deps) if d is None]
                if unknown:
                    print(f"board: no such task {', '.join(unknown)} — nothing to wait for (planned tasks: {', '.join(t.id for t in st.ordered()) or 'none'})")
                    return 2
                if args.or_mail and st.unread(agent):   # a lead waiting on its workers wakes for their questions
                    text, items = render_inbox(st, agent)
                    print(text)
                    if not args.peek:
                        ack(ws, agent, items)
                    print("board: mail arrived while you waited — answer it (reply ONLY to an ask), then wait again")
                    return 5
                failed = [(d, dep_failed(st, d)) for d in deps if dep_failed(st, d)]
                if failed:
                    for d, why in failed:
                        print(f"board: task {d.id} {d.title} cannot land — {why}; this input will not arrive "
                              f"(return NEEDS_CONTEXT naming it, or the controller re-dispatches task {d.id})")
                    if not args.peek:
                        deliver(ws, agent)
                    return 3
                landed = [d for d in deps if dep_landed(st, d)]
                if len(landed) == len(deps):
                    for d in landed:
                        s = next((x for x in reversed(st.stints) if x.task == d.id and (x.returned or x.exit_code is not None)), None)
                        state = (s.status.lower().replace("_", " ") if s and s.status else
                                 f"lane exited rc={s.exit_code}, report on disk (not yet returned by the controller)" if s else d.state)
                        print(f"task {d.id} {d.title}: {state}" + (f" · commits {s.commits}" if s and s.commits else "")
                              + (f" · report {rp if rp.startswith('/') else '.orchestrate/' + rp}" if (rp := d.report or (f'task-{d.id}-report.md' if (ws / f'task-{d.id}-report.md').exists() else '')) else ""))
                    if not args.peek:
                        deliver(ws, agent)
                    return 0
                if time.time() >= deadline:
                    open_ = ", ".join(f"task {x}" for x, d in zip(args.task, deps) if not (d and dep_landed(st, d)))
                    print(f"board: {open_} not returned after {args.timeout}s — wait again, or return NEEDS_CONTEXT naming the dependency")
                    return 124
                idle()
                continue
            if st.unread(agent):   # wakes on MAIL; the digest (learnings, record changes) rides along
                text, items = render_inbox(st, agent)
                print(text)
                if not args.peek:
                    ack(ws, agent, items)
                return 0
            if time.time() >= deadline:
                print(f"board: no mail for {agent} in {args.timeout}s — continue with your brief, or return NEEDS_CONTEXT if you cannot")
                return 124
            idle()
    elif cmd == "mail":
        st = load(ws)
        print(json.dumps([vars(m) for m in st.mail], ensure_ascii=False, indent=1, default=str) if args.json else render_mail(st, args.task or ""))
    elif cmd == "peers":
        print(render_peers(load(ws), clean(args.agent)))
        deliver(ws, clean(args.agent))
    elif cmd == "vote":
        ev = observe(ws, f"board vote {args.task} --kind {args.kind} --agent {args.agent} --verdict {args.verdict}" + (f" --why {shlex.quote(args.why)}" if args.why else ""),
                     task=args.task, ev="vote", kind=args.kind, agent=args.agent, verdict=args.verdict, why=args.why, round=args.round)
        if not ev:
            return 0
        st = load(ws)
        t = st.tasks.get(str(args.task))
        print(f"board: vote {args.verdict} by {args.agent} on task {args.task} {args.kind} — gate now: {t.gates.get(args.kind, '?') if t else '?'}")
        deliver(ws, clean(args.agent))
    elif cmd == "exec":
        argv_cmd = [a for a in args.command if a != "--"] if args.command else []
        if not argv_cmd:
            sys.exit("board: exec needs a command after --  (board exec N --name tests -- npm test)")
        name = re.sub(r"[^\w.-]+", "-", args.name).strip("-") or "check"
        actor = "worker" if args.agent else "controller"
        fallback = f"board result {args.task} --name {name} --exit <rc>" + (f" --agent {args.agent}" if args.agent else "")
        ev = observe(ws, fallback, actor=actor, task=args.task, ev="check", name=name, status="running", cmd=" ".join(argv_cmd), agent=args.agent)
        rel = f"raw/check-task{args.task}-{name}-{ev['seq'] if ev else int(time.time())}.log"   # one log per run: re-runs never erase evidence
        try:
            (ws / "raw").mkdir(parents=True, exist_ok=True)
            fh = (ws / rel).open("w", encoding="utf-8")
        except OSError:   # read-only lane: the log goes to a temp file and the journal line names it absolutely
            rel = tempfile.mkstemp(prefix=f"check-task{args.task}-{name}-", suffix=".log")[1]
            fh = open(rel, "w", encoding="utf-8")
        t0 = time.time()
        with fh:
            try:
                rc = subprocess.run(argv_cmd, stdout=fh, stderr=subprocess.STDOUT).returncode
            except OSError as exc:
                fh.write(f"board: could not launch {argv_cmd[0]}: {exc}\n")
                rc = 127
        dur = fmt_dur(time.time() - t0)
        observe(ws, fallback.replace("<rc>", str(rc)), actor=actor, task=args.task, ev="check", name=name,
                status="ok" if rc == 0 else "fail", exit=rc, dur=dur, log=rel, agent=args.agent)
        print(f"board: check {name} {'ok' if rc == 0 else 'FAIL'} (exit {rc}, {dur}) -> {rel if rel.startswith('/') else '.orchestrate/' + rel}")
        deliver(ws, clean(args.agent or ""))
        return rc
    elif cmd == "result":
        observe(ws, f"board result {args.task} --name {args.name} --exit {args.exit}" + (f" --agent {args.agent}" if args.agent else ""),
                actor="worker" if args.agent else "controller", task=args.task, ev="check",
                name=re.sub(r"[^\w.-]+", "-", args.name).strip("-") or "check", status="ok" if args.exit == 0 else "fail",
                exit=args.exit, dur=args.dur, log=args.log, msg=args.msg, agent=args.agent)
        print(f"board: check {args.name} {'ok' if args.exit == 0 else 'FAIL'} (exit {args.exit}) journaled")
        deliver(ws, clean(args.agent or ""))
    elif cmd == "init":
        cmd_init(ws, args)
    elif cmd == "set":
        dims: dict[str, object] = {}
        for pair in args.pairs:
            k, _, v = pair.partition("=")
            if k not in DIMS or not v:
                sys.exit(f"board: set expects key=value with key in {', '.join(DIMS)}")
            dims[k] = parse_kv(v) if k in ("models", "budget") or (k == "effort" and re.search(r"[=:]", v)) else v
        append_event(ws, ev="set", dims=dims)
        write_resolved(ws)
        print(f"board: re-resolved {', '.join(dims)} — plan is pending again: `board plan` → gate → `board plan approved`")
    elif cmd == "plan":
        if args.outcome:
            append_event(ws, ev="plan", outcome=args.outcome, msg=args.msg)
            write_resolved(ws)
            print(f"board: flight plan {args.outcome}")
        else:
            print(render_plan(load(ws), args.why or ""))
    elif cmd == "todo":
        append_event(ws, task=args.task, ev="todo", title=args.title)
    elif cmd == "dispatch":
        if not args.model:
            sys.exit("board: dispatch needs --model — pin a model on every dispatch (SKILL.md rule 3)")
        st = load(ws)
        args.agent = check_agent(clean(args.agent), st, str(args.task), args.role or "") if args.agent else agent_name(st, str(args.task), args.role or "")
        print(f"board: task {args.task} → {args.agent} ({args.role or 'implementer'} · {args.model})")
        append_event(ws, actor=args.by or "controller", task=args.task, ev="dispatch", agent=args.agent, role=args.role, model=args.model,
                     engine=args.engine, effort=args.effort, worktree=args.worktree, session=args.session, log=args.log,
                     cmd_file=args.cmd_file, owns=args.owns, by=args.by, msg=args.msg)
    elif cmd == "return":
        if not args.agent:
            sys.exit("board: return needs --agent")
        reported = ""
        if args.report:
            rp = ws / args.report if not Path(args.report).is_absolute() else Path(args.report)
            if rp.exists():
                reported, _ = report_status(rp)
                if reported and reported != args.status:
                    print(f"board: note — the report says Status: {reported}, you are recording {args.status} (your call; journaled as reported={reported})")
            else:
                print(f"board: warning — report {args.report} does not exist (recorded anyway; board check will name it)")
        append_event(ws, task=args.task, ev="return", agent=args.agent, status=args.status, commits=args.commits,
                     report=args.report, reported=reported, observed_model=args.observed_model, tokens=args.tokens,
                     session=args.session, msg=args.msg)
        if args.observed_model:
            write_resolved(ws)
    elif cmd == "review":
        if args.agent:
            check_agent(clean(args.agent), load(ws), str(args.task), f"{args.kind} reviewer")
        append_event(ws, task=args.task, ev="review", kind=args.kind, round=args.round, agent=args.agent,
                     model=args.model, engine=args.engine, msg=args.msg)
    elif cmd == "gate":
        append_event(ws, task=args.task, ev="gate", kind=args.kind, verdict=args.verdict, round=args.round,
                     findings=args.findings, agent=args.agent, msg=args.msg)
    elif cmd == "nudge":
        append_event(ws, task=args.task, ev="nudge", agent=args.agent, msg=args.msg)
    elif cmd == "escalate":
        append_event(ws, task=args.task, ev="escalate", agent=args.agent, to=args.to, why=args.why)
    elif cmd == "done":
        st = load(ws)
        t = st.tasks.get(str(args.task))
        failed = [k for k, v in (t.gates if t else {}).items() if v.startswith("fail")]
        if failed:
            sys.exit(f"board: task {args.task} has a failed gate ({', '.join(failed)}) — fix wave + re-review first")
        if t and t.failed_checks:
            sys.exit(f"board: task {args.task} has a failed check ({', '.join(t.failed_checks)}) — fix, re-run it first")
        line = f"Task {args.task}: complete" + (f" ({clean(args.msg)})" if args.msg else "")
        ws.mkdir(parents=True, exist_ok=True)
        with (ws / "progress.md").open("a", encoding="utf-8") as fh:
            fh.write(line + "\n")
        append_event(ws, task=args.task, ev="done", msg=args.msg, agent=args.agent, ledger=line)
        print(f"board: ledger ← {line}")
    elif cmd == "blocked":
        if not args.msg:
            sys.exit("board: blocked needs --msg (owner + next action, or it's abandoned, not blocked)")
        append_event(ws, task=args.task, ev="blocked", msg=args.msg, agent=args.agent)
    elif cmd == "note":
        observe(ws, f"board note {args.task} {shlex.quote(args.msg)}" + (f" --agent {args.agent}" if args.agent else ""),
                actor=args.agent or "worker", task=args.task, ev="note", msg=args.msg, agent=args.agent)
        deliver(ws, clean(args.agent or ""))
    elif cmd == "decide":
        prior = any(x["id"] == args.id and x.get("src") == "journal" for x in load(ws).run.decisions)
        append_event(ws, ev="decide", id=args.id, msg=args.msg, why=args.why, owner=args.owner, task=args.task)
        ws.mkdir(parents=True, exist_ok=True)
        with (ws / "decisions.md").open("a", encoding="utf-8") as fh:
            fh.write(f"- {args.id} — {clean(args.msg)}" + (f" · why: {clean(args.why)}" if args.why else "") + (f" (owner: {args.owner})" if args.owner else "") +
                     (f" [task {args.task}]" if args.task else "") + (" (supersedes the earlier " + args.id + ")" if prior else "") + "\n")
        if prior:
            print(f"board: {args.id} revised — open workers see it at their next board call; a worker whose brief cites it may return NEEDS_CONTEXT")
    elif cmd == "rail":
        append_event(ws, ev="rail", msg=args.msg)
        write_resolved(ws)
    elif cmd == "finish":
        st = load(ws)
        if args.gate == "pass":
            strict = check(st, finish_mode=True)
            if strict and not args.force:
                for f in strict:
                    print(f"check: {f}")
                sys.exit("board: finish --gate pass refused — resolve the findings above, or --force --reason \"…\"")
            if args.force and not args.reason:
                sys.exit("board: --force needs --reason")
            if not args.evidence:
                sys.exit("board: finish --gate pass needs --evidence PATH (the final-deliverable gate's findings)")
        ev_path = args.evidence or ""
        if ev_path and not (ws / ev_path).exists() and not Path(ev_path).exists():
            sys.exit(f"board: evidence {ev_path} does not exist")
        append_event(ws, ev="finish", gate=args.gate, evidence=ev_path, msg=args.msg, head=git("rev-parse", "HEAD"),
                     goal_hash=sha(str(st.run.dims.get("goal", ""))), forced=bool(args.force), reason=args.reason)
        write_resolved(ws)
        print(f"board: finish recorded — final gate {args.gate}" + (" (forced)" if args.force else ""))
        hint = memory_hint(ws, load(ws), "finish")
        if hint:
            print(f"board: {hint}")
    elif cmd == "learn":
        st = load(ws)
        if not args.task:   # the read view
            print(json.dumps([vars(x) for x in st.learned], ensure_ascii=False, indent=1, default=str) if args.json else render_learned(st))
            return 0
        agent = clean(args.agent or "")
        msg = " ".join(clean(args.msg or "").split())
        if not msg:
            sys.exit("board: learn needs one line — board learn N \"what the next worker would re-pay\" --agent <you>")
        if not agent:
            sys.exit("board: learn needs --agent <you> (set automatically as BOARD_AGENT inside a launched lane)")
        if len(msg) > LEARN_LEN:
            sys.exit(f"board: a learning is one line (≤{LEARN_LEN} chars) — depth goes in your report")
        s = st.open_stint(agent, "") if agent != "controller" else None
        if agent != "controller" and not s:
            sys.exit(f"board: {agent} has no open stint — a returned agent's learnings belong in its report")
        if s and s.learned >= LEARN_CAP:
            sys.exit(f"board: {agent} has journaled {s.learned} learnings this stint (cap {LEARN_CAP}) — the rest goes in your report's surprise: line")
        key = " ".join(msg.casefold().split())
        dup = next((x for x in st.learned if x.key() == key), None)
        if dup:
            sys.exit(f"board: already learned by {dup.agent} at #{dup.seq} — nothing to add")
        fallback = f"board learn {args.task} {shlex.quote(msg)} --agent {agent} --kind {args.kind}" + (f" --path {shlex.quote(args.path)}" if args.path else "")
        ev = observe(ws, fallback, actor=agent if agent != "controller" else "controller", task=args.task, ev="learn", agent=agent,
                     kind=args.kind, msg=msg, path=args.path, by=st.lead_of(agent))
        if not ev:
            return 0
        L = Learn(ev, time.time())
        who = sorted({x.agent for x in st.open_stints() if st.receives(x.agent, L)})
        print(f"board: learned #{ev['seq']} [{args.kind}] — reaches " + (", ".join(who) if who else "no open peer yet (later workers get it at their first checkpoint)")
              + " and the controller, each at its next board call")
        deliver(ws, agent)
    elif cmd == "memory":
        st = load(ws)
        kind = "observation" if args.observation else ("handoff" if args.handoff else "")
        scopes = [x.strip() for x in (args.scope or "").split(",") if x.strip()]
        rec = render_memory(st, kind, scopes)
        text = json.dumps(rec, ensure_ascii=False, indent=1)
        if args.out:
            Path(args.out).write_text(text + "\n", encoding="utf-8")
            verb = "append" if rec["record_type"] == "observation" else "handoff"
            print(f"board: {rec['record_type']} written -> {args.out} · record it: ctx {verb} --agent orchestrate --session-id {st.run.id or 'RUN'} --input {args.out}")
        else:
            print(text)
    return 0


# --- selftest (temp repo replay; run by scripts/check-sync) --------------------------------

def selftest() -> int:
    import contextlib
    import io

    def run(*argv: str, expect_fail: bool = False) -> str:
        buf, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(err):
            try:
                rc = main(list(argv))
            except SystemExit as exc:
                rc = exc.code if isinstance(exc.code, int) else 1
                if not isinstance(exc.code, int) and exc.code:
                    err.write(str(exc.code))
        if expect_fail:
            assert rc not in (0, None), f"{argv}: expected failure, got exit {rc}"
        else:
            assert rc in (0, None), f"{argv}: exit {rc}\n{buf.getvalue()}\n{err.getvalue()}"
        return buf.getvalue()

    # every subcommand the parser knows is in the help, grouped by role — the help can never go stale again
    names = list(build_parser()._subparsers._group_actions[0].choices)  # type: ignore[union-attr]
    missing = [x for x in names if not re.search(rf"(?m)^\s+.*\b{re.escape(x)}\b", __doc__ or "")]
    assert not missing, f"subcommands missing from the help: {missing}"

    cwd = os.getcwd()
    env_ws = os.environ.pop("ORCHESTRATE_WS", None)
    env_home = os.environ.get("ORCHESTRATE_HOME")
    saved_env = {k: os.environ.get(k) for k in ("COLORTERM", "TERM", "NO_COLOR", "BOARD_ASCII")}
    os.environ["COLORTERM"] = "truecolor"
    tmp = tempfile.mkdtemp(prefix="board-selftest-")
    os.environ["ORCHESTRATE_HOME"] = str(Path(tmp) / "home")   # never touch the user's real registry
    try:
        os.chdir(tmp)
        subprocess.run(["git", "init", "-q", "-b", "main"], check=True)
        gitc = ["git", "-c", "user.email=t@t", "-c", "user.name=t"]
        subprocess.run([*gitc, "commit", "-q", "--allow-empty", "-m", "base"], check=True)
        base = subprocess.run(["git", "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
        Path("plan.md").write_text("# P\n## Task 1: Scaffold\n## Task 2: Auth\n```\n## Task 9: fenced\n```\n## Task 3: Docs\n")
        ws = Path(tmp) / ".orchestrate"

        # --- lens1-4 migration + legacy name -------------------------------------------------
        ws.mkdir()
        (ws / LEGACY_JOURNAL).write_text('{"ts":"2026-09-15T10:00:00","task":"7","ev":"todo","title":"Legacy"}\n'
                                         '{"ts":"2026-09-15T10:01:00","task":"7","ev":"dispatch","agent":"old","model":"x"}\n')
        st = load(ws)
        assert (ws / JOURNAL).exists() and (ws / (LEGACY_JOURNAL + ".bak")).exists() and (ws / "journal.jsonl.v1.bak").exists()
        assert st.tasks["7"].state == "in_progress" and not st.problems and st.events[0]["schema"] == SCHEMA and st.run.id.startswith("legacy-")

        # --- kickoff refuses to archive live work; --fresh archives it on purpose ---------------
        run("init", "plan.md", "--strategy", "staged", "--goal", "Ship the thing", expect_fail=True)
        assert not (ws / "archive").exists(), "a bare init over unfinished work must refuse, not archive"
        out = run("init", "plan.md", "--fresh", "--strategy", "staged", "--review", "dual", "--host", "Claude Code",
                  "--models", "worker=sonnet,reviewer=opus", "--budget", "agents=6", "--goal", "Ship the thing")
        assert "archived" in out and list((ws / "archive").iterdir()), "previous run must be archived on --fresh"
        st = load(ws)
        assert [t.id for t in st.ordered()] == ["1", "2", "3"], "plan headings → todo (fence ignored, legacy gone)"
        assert st.run.branch == "main" and len(st.run.base) == 40 and st.run.id and not st.run.id.startswith("legacy")
        runmd = (ws / "run.md").read_text()
        assert "goal: Ship the thing" in runmd and OPEN in runmd and f"run: {st.run.id}" in runmd

        # --- plan, set, approve ----------------------------------------------------------
        plan = run("plan", "--why", "independent tasks")
        assert "strategy=staged — independent tasks" in plan and "spec reviewer" in plan and "tweak" in plan
        run("plan", "approved")
        run("set", "effort=high")
        st = load(ws)
        assert st.run.plan == "pending" and st.run.dims["effort"] == "high"
        run("plan", "approved", "--msg", "after effort change")
        assert "plan: approved" in (ws / "run.md").read_text() and "plan-trail" in (ws / "run.md").read_text()

        # --- dispatch requires a model; same-second dispatch beats todo --------------------
        run("dispatch", "1", "--agent", "impl-1", expect_fail=True)
        run("dispatch", "1", "--agent", "impl-1", "--model", "sonnet", "--worktree", "wt-1")
        assert load(ws).tasks["1"].state == "in_progress"
        run("note", "1", "tests green \x1b[31mINJECT\x1b[0m", "--agent", "impl-1")
        show = run("show", "--no-color")
        assert "\x1b" not in show and "INJECT" in show, "control sequences from notes never reach the terminal"
        st = load(ws)
        assert st.tasks["1"].heartbeat_ts > 0 and st.tasks["1"].artifact_ts == 0, "notes are heartbeats, not liveness"
        run("return", "1", "--agent", "impl-1", "--status", "DONE", "--commits", f"{base}..{base}",
            "--report", "task-1-report.md", "--observed-model", "haiku", "--tokens", "84k")
        st = load(ws)
        assert st.tasks["1"].state == "review" and st.run.tokens == 84000 and st.run.observed["worker"] == "haiku"
        assert st.run.drift and "drift:" in (ws / "run.md").read_text()

        # --- gates: text-order verdict, explicit gate events, attempts ---------------------
        run("review", "1", "--kind", "spec", "--round", "1", "--agent", "spec-1", "--model", "opus")
        (ws / "review-task1-spec-r1.md").write_text("❌ 1 Critical — later note: ✅ tests pass\n")
        assert load(ws).tasks["1"].gates["spec"].startswith("fail"), "first mark in text order wins"
        run("gate", "1", "--kind", "spec", "--verdict", "ok", "--round", "1", "--findings", "review-task1-spec-r1.md")
        assert load(ws).tasks["1"].gates["spec"] == "ok r1", "explicit gate event outranks the file parse"
        run("review", "1", "--kind", "quality", "--round", "1", "--agent", "quality-1")
        (ws / "review-task1-quality-r1.md").write_text("❌ 2 important\n")
        assert load(ws).tasks["1"].gates["quality"].startswith("fail")
        run("done", "1", expect_fail=True)  # failed gate blocks the ledger
        run("dispatch", "1", "--agent", "fix-1", "--model", "sonnet", "--msg", "fix wave")
        st = load(ws)
        assert st.tasks["1"].attempt == 2 and st.tasks["1"].gates == {}, "new implementer attempt resets the review cycle"
        run("return", "1", "--agent", "fix-1", "--status", "DONE", "--commits", f"{base}..{base}")
        run("review", "1", "--kind", "quality", "--round", "2")
        (ws / "review-task1-quality-r2.md").write_text("✅ clean r2\n")
        assert load(ws).tasks["1"].gates == {"quality": "ok r2"}
        out = run("done", "1", "--msg", f"commits {base}..{base}, review clean")
        assert "ledger" in out and "Task 1: complete" in (ws / "progress.md").read_text()

        # --- xcli lane: REFUSED, escalation, decisions, rails ------------------------------
        run("dispatch", "2", "--agent", "impl-2", "--model", "sonnet", "--engine", "codex")
        run("escalate", "2", "--agent", "impl-2", "--to", "opus", "--why", "same error x3")
        run("return", "2", "--agent", "impl-2", "--status", "REFUSED", "--msg", "empty diff: AGENTS.md rule; owner: controller")
        run("decide", "D-01", "cookie auth, not header", "--owner", "controller", "--task", "2")
        run("rail", "single-flight: npm publish -> impl-2")
        st = load(ws)
        assert st.tasks["1"].state == "done" and st.tasks["2"].state == "blocked" and st.tasks["3"].state == "todo"
        assert st.run.decisions[-1]["id"] == "D-01" and "D-01" in (ws / "decisions.md").read_text()
        assert len(st.stints) == 5 and any(s.escalated_to == "opus" for s in st.stints)
        roster = run("agents")
        assert "impl-1" in roster and "sonnet -> haiku !" in roster and "spec reviewer" in roster and "wt-1" in roster
        show = run("show", "--no-color")
        for needle in ("goal       Ship the thing", "agents 5/6", "worker sonnet (observed haiku !)", "approved", "rails",
                       "D-01", "1  Scaffold", "2  Auth", "single-flight", "attention", "x 1", "IN PROGRESS  0", "REVIEW  0"):
            assert needle in show, f"show lacks {needle!r}\n{show}"
        wide = run("show", "--no-color", "--expanded")
        assert "attempt   impl-1" in wide and "escalated → opus" in wide and "evidence  task-1-report.md" in wide, wide
        assert "action" in wide
        att = run("attention")
        assert "x task 2" in att
        assert "task 2" in run("task", "2") and "refused" in run("task", "2")
        log = run("log")
        assert "dispatch" in log and "escalate" in log and "gate" in log
        js = json.loads(run("show", "--json"))
        assert js["run"]["id"] == st.run.id and js["tasks"][0]["state"] == "done" and js["attention"]
        os.environ["BOARD_ASCII"] = "1"
        ascii_show = run("show", "--no-color")
        assert "+-" in ascii_show and "│" not in ascii_show
        os.environ.pop("BOARD_ASCII")
        findings = check(load(ws))
        assert any("drift" in f for f in findings) and not any("journal line" in f for f in findings), findings
        res = run("resume")
        for needle in ("## Goal", "task 2 Auth", "D-01", "Open work", "## Receipt", "receipt-hash", "Cleanup", "wt-1", "per accepted task"):
            assert needle in res, needle

        # --- checks: exec runs THROUGH the journal, badges render, done is refused over a failure ----
        out = run("exec", "3", "--name", "tests", "--", sys.executable, "-c", "print('ok')")
        logs = sorted((ws / "raw").glob("check-task3-tests-*.log"))
        assert "tests ok" in out and len(logs) == 1 and logs[0].read_text().strip() == "ok", out
        run("exec", "3", "--name", "tests", "--", sys.executable, "-c", "print('again')")
        assert len(list((ws / "raw").glob("check-task3-tests-*.log"))) == 2, "a re-run never erases the previous run's log"
        run("exec", "3", "--name", "lint", "--", sys.executable, "-c", "import sys; sys.exit(2)", expect_fail=True)
        st = load(ws)
        assert st.tasks["3"].checks["tests"]["status"] == "ok" and st.tasks["3"].checks["lint"]["exit"] == "2"
        show = run("show", "--no-color")
        assert "lint fail" in show and "checks" in show and "1 failed" in show, show
        assert "x task 3" in run("attention")
        run("done", "3", expect_fail=True)  # a failed check blocks the ledger like a failed gate
        run("result", "3", "--name", "lint", "--exit", "0", "--dur", "3s")
        st = load(ws)
        assert st.tasks["3"].checks["lint"]["status"] == "ok" and not st.tasks["3"].failed_checks
        assert not any("outran the check" in f for f in check(st))
        run("exec", "run", "--name", "integration", "--", sys.executable, "-c", "pass")
        run("exec", "77", "--name", "orphan", "--", sys.executable, "-c", "pass")   # nobody planned task 77 → run-level
        st = load(ws)
        assert "integration" in st.run_checks and "orphan" in st.run_checks and "77" not in st.tasks, st.run_checks
        assert "run: integration ok" in run("show", "--no-color")
        run("exec", "3", "--name", "unit", "--agent", "impl-3", "--", sys.executable, "-c", "pass")
        assert load(ws).events[-1]["actor"] == "worker", "a worker's own check is attributed to the worker"
        # parallel workers must not race the chain: 12 concurrent notes, one journal, no problems
        procs = [subprocess.Popen([sys.executable, __file__, "note", "3", f"beat {i}", "--agent", f"w{i}"],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) for i in range(12)]
        assert all(p.wait() == 0 for p in procs)
        st = load(ws)
        seqs = [int(e["seq"]) for e in st.events]
        assert not st.problems and seqs == list(range(1, len(seqs) + 1)), (st.problems, seqs[-14:])

        # --- lanes are a projection of state × role; sessions travel with the stint ---------------
        run("set", "lanes=todo,implement,verify,review,integrate,done,blocked")
        run("plan", "approved")
        run("dispatch", "3", "--agent", "verify-3", "--model", "haiku", "--role", "verifier", "--engine", "codex",
            "--session", "sess-3", "--log", "raw/lane-3.jsonl")
        st = load(ws)
        assert st.lanes[1] == "implement" and st.lane_of(st.tasks["3"]) == "verify" and st.lane_of(st.tasks["1"]) == "done"
        show = run("show", "--no-color")
        assert "VERIFY" in show and "3  Docs" in show.split("VERIFY", 1)[1].split("REVIEW", 1)[0], show
        res = run("resume")
        assert "session sess-3" in res and "codex exec resume sess-3" in res, res
        assert "sess-3" in run("agents") and "lanes   todo → implement" in run("plan")
        assert "lane" in run("task", "3") and json.loads(run("show", "--json"))["tasks"][2]["lane"] == "verify"
        run("return", "3", "--agent", "verify-3", "--status", "DONE")
        assert "no usage receipt" in "\n".join(check(load(ws)))
        before = len(load(ws).stints)
        run("return", "3", "--agent", "verify-3", "--status", "DONE", "--tokens", "12k")   # receipt amendment
        st = load(ws)
        assert len(st.stints) == before and st.stint_of("verify-3").tokens == 12000 and "no usage receipt" not in "\n".join(check(st))

        # --- replay: the journal alone must derive the same board -----------------------------------
        assert not replay(load(ws)), replay(load(ws))
        with (ws / "progress.md").open("a") as fh:
            fh.write("Task 3: complete (by hand)\n")
        rp = replay(load(ws))
        assert rp and "task 3" in rp[0] and "without its journal line" in rp[0], rp
        assert "replay:" in run("check", "--replay", expect_fail=True)
        (ws / "progress.md").write_text("\n".join(l for l in (ws / "progress.md").read_text().splitlines() if "by hand" not in l) + "\n")
        assert not replay(load(ws))
        pm = run("postmortem")
        assert "worker" in pm and "recommend" in pm and "cost per accepted task" in pm, pm

        # --- mail: information between agents, delivered at checkpoints, loop-proof ---------------------
        run("todo", "4", "Integrate")
        run("dispatch", "3", "--agent", "impl-3-b", "--model", "sonnet", "--owns", "src/ui/**")
        run("dispatch", "4", "--agent", "impl-4", "--model", "sonnet", "--owns", "src/api/**")
        peers = run("peers", "--agent", "impl-3-b")
        assert "task 4" in peers and "impl-4" in peers and "owns src/api/**" in peers and "impl-3-b" not in peers.split("\n")[1], peers
        run("send", "will rename src/api/auth.ts — import path changes", "--from", "impl-4", "--to", "impl-3-b")
        st = load(ws)
        assert len(st.unread("impl-3-b")) == 1 and not st.unread("impl-4") and st.stint_of("impl-4").sent == 1
        show = run("show", "--no-color")
        assert "mail" in show and "1 unread" in show and "m1" in show, show
        inbox = run("inbox", "--agent", "impl-3-b")
        assert "[peer impl-4]" in inbox and "rename src/api" in inbox and "information" in inbox, inbox
        assert not load(ws).unread("impl-3-b"), "reading acks"
        assert "no new mail" in run("inbox", "--agent", "impl-3-b")
        run("send", "which auth header do I use?", "--from", "impl-4", "--to", "controller", "--ask")
        att = run("attention")
        assert "question #" in att and "impl-4" in att and "--re" in att, att
        assert "1 for you" in run("show", "--no-color") and "1 question" in run("show", "--no-color")
        ctrl = run("inbox", "--agent", "controller")
        assert "[peer impl-4 · ask]" in ctrl and "reply: board send --from controller --to impl-4 --re" in ctrl, ctrl
        seq_q = max(m.seq for m in load(ws).mail)
        run("send", "cookie, not header (D-01)", "--from", "controller", "--to", "impl-4", "--re", str(seq_q))
        waited = run("wait", "--agent", "impl-4", "--timeout", "3")
        assert "[controller] cookie, not header" in waited, waited
        run("wait", "--agent", "impl-4", "--timeout", "1", expect_fail=True)   # nothing new → 124
        run("send", "all: base branch rebased", "--from", "controller", "--to", "all")
        assert len(load(ws).unread("impl-3-b")) == 1 and len(load(ws).unread("impl-4")) == 1, "broadcast reaches every open agent"
        thread = run("mail")
        assert "[ask]" in thread and "(read)" in thread and "bcast" in thread, thread
        # loop guards: duplicate, thread depth, cap, closed recipient
        run("send", "will rename src/api/auth.ts — import path changes", "--from", "impl-4", "--to", "impl-3-b", expect_fail=True)
        last = max(m.seq for m in load(ws).mail)
        run("send", "r1", "--from", "impl-3-b", "--to", "impl-4", "--re", str(seq_q))
        r1 = max(m.seq for m in load(ws).mail)
        run("send", "r2", "--from", "impl-4", "--to", "impl-3-b", "--re", str(r1))
        r2 = max(m.seq for m in load(ws).mail)
        run("send", "r3", "--from", "impl-3-b", "--to", "impl-4", "--re", str(r2))
        r3 = max(m.seq for m in load(ws).mail)
        run("send", "r4", "--from", "impl-4", "--to", "impl-3-b", "--re", str(r3), expect_fail=True)   # thread cap
        for i in range(MAIL_CAP):
            run("send", f"fyi {i}", "--from", "impl-3-b", "--to", "impl-4") if load(ws).stint_of("impl-3-b").sent < MAIL_CAP else None
        run("send", "one more", "--from", "impl-3-b", "--to", "impl-4", expect_fail=True)   # per-stint cap
        assert any("chatter" in f for f in check(load(ws)))
        run("send", "before you go: CLI order is greeting then farewell", "--from", "impl-4", "--to", "impl-3-b")   # piggyback delivers on the RECIPIENT's calls; a return does not read
        run("return", "3", "--agent", "impl-3-b", "--status", "DONE")
        run("send", "late", "--from", "impl-4", "--to", "impl-3-b", expect_fail=True)       # returned → closed
        assert any("never read" in f for f in check(load(ws))), check(load(ws))
        assert "## Mail" in run("resume") or True
        js = json.loads(run("show", "--json"))
        assert js["mail"] and js["acks"]["impl-3-b"] >= 1

        # --- votes: panel = majority, consensus = any-deny, explicit gate outranks -----------------------------
        run("set", "review=panel:3")
        run("plan", "approved")
        run("vote", "4", "--kind", "approve", "--agent", "lens1-4", "--verdict", "ok")
        assert load(ws).tasks["4"].gates["approve"].startswith(".. 1/3")
        run("vote", "4", "--kind", "approve", "--agent", "lens2-4", "--verdict", "fail", "--why", "missing test")
        run("vote", "4", "--kind", "approve", "--agent", "lens3-4", "--verdict", "warn")
        st = load(ws)
        assert st.tasks["4"].gates["approve"].startswith("ok 2/3"), st.tasks["4"].gates
        run("set", "review=consensus:3")   # rules in force at vote time govern that vote — a later set never flips a gate
        run("plan", "approved")
        assert load(ws).tasks["4"].gates["approve"].startswith("ok 2/3")
        run("vote", "4", "--kind", "quality", "--agent", "lens1-4", "--verdict", "ok")
        run("vote", "4", "--kind", "quality", "--agent", "lens2-4", "--verdict", "fail", "--why", "leaks a handle")
        st = load(ws)
        assert st.tasks["4"].gates["quality"].startswith("fail") and "deny: lens2-4" in st.tasks["4"].gates["quality"], st.tasks["4"].gates
        run("return", "4", "--agent", "impl-4", "--status", "DONE", "--commits", f"{base}..{base}")
        run("done", "4", expect_fail=True)                                   # any-deny fails the gate
        run("gate", "4", "--kind", "quality", "--verdict", "ok")               # the controller closes it explicitly
        assert load(ws).tasks["4"].gates["quality"] == "ok"
        run("done", "4", "--msg", "consensus deny resolved; controller closed the gate")
        assert load(ws).tasks["4"].state == "done"

        # --- finish is gated and bound --------------------------------------------------
        run("finish", "--gate", "pass", "--evidence", "task-1-report.md", expect_fail=True)  # task 2/3 open
        (ws / "raw").mkdir(exist_ok=True)
        (ws / "raw" / "final.md").write_text("fail\n")
        run("finish", "--gate", "fail", "--evidence", "raw/final.md", "--msg", "task 2 open")
        st = load(ws)
        assert st.run.finish == "fail" and st.run.finish_head and any("non-terminal" in f for f in check(st))
        assert "RUN FAILED" in run("show", "--no-color")
        run("finish", "--gate", "pass", "--evidence", "raw/final.md", "--force", "--reason", "selftest", "--msg", "forced")
        assert "RUN COMPLETE" in run("show", "--no-color")
        run("note", "3", "poke")  # a note is not work → still valid
        assert not finish_invalid(load(ws))
        run("dispatch", "3", "--agent", "impl-3-docs", "--model", "haiku")
        assert "work event" in finish_invalid(load(ws)) and "RUN COMPLETE (STALE)" in run("show", "--no-color")
        subprocess.run([*gitc, "commit", "-q", "--allow-empty", "-m", "after"], check=True)
        assert any("finish invalidated" in f for f in check(load(ws)))

        # --- chain integrity: an in-place edit is detected --------------------------------
        lines = (ws / JOURNAL).read_text().splitlines()
        ev = json.loads(lines[3])
        ev["msg"] = "tampered"
        lines[3] = json.dumps(ev, ensure_ascii=False)
        (ws / JOURNAL).write_text("\n".join(lines) + "\n")
        st = load(ws)
        assert any("hash mismatch" in p for p in st.problems) and any("prev-hash" in p for p in st.problems), st.problems
        assert "integrity" in run("show", "--no-color")
        run("check", expect_fail=True)

        # --- second init archives the run; --resume does not --------------------------------
        run("init", "--resume")
        assert (ws / "progress.md").exists()
        run("init", "plan.md", "--strategy", "loop", "--goal", "Round two", expect_fail=True)  # tasks 2/3 still open
        out = run("init", "plan.md", "--fresh", "--strategy", "loop", "--goal", "Round two")
        st = load(ws)
        assert "archived" in out and st.run.dims["strategy"] == "loop" and not st.problems and st.tasks["1"].state == "todo"
        assert len(list((ws / "archive").iterdir())) == 2 and not (ws / "progress.md").exists()
        assert st.lanes == COLUMNS, "a new run starts with the canonical lanes"
        plan = run("plan")
        assert "tokens est" in plan and "past run" in plan, plan  # the cost band comes from archived receipts
        run("init", "plan.md", "--resume", "--engine", "codex", "--effort", "high", "--lanes", "todo,implement,verify,review,done,blocked")
        plan = run("plan")
        assert "lane    codex exec" in plan and "[8] lanes" in plan and "lanes   todo → implement → verify" in plan, plan
        run("set", "strategy=parallel", "isolation=off")
        assert "shared tree (isolation off)" in run("plan") and "wt-1" not in run("plan")
        assert "never -A" in run("plan") and "never -A" in run("show", "--no-color"), "the shared-tree rail is derived, not journaled"

        # --- launch: the lane as one command, receipt on exit (fake grok on PATH) -------------------------
        shim = Path(tmp) / "bin"
        shim.mkdir(exist_ok=True)
        (shim / "grok").write_text("#!/bin/sh\nif [ \"$1\" = usage ]; then echo '{\"session\":{\"totalTokens\":12345,\"modelCalls\":7}}'; exit 0; fi\n"
                                   "echo x >> \"$(dirname \"$0\")/grok.calls\"; [ -n \"$ORCHESTRATE_WS\" ] || exit 9\n"
                                   "cat >/dev/null; echo '{\"text\":\"done\",\"stopReason\":\"end_turn\"}'\n")
        (shim / "grok").chmod(0o755)
        old_path = os.environ.get("PATH", "")
        os.environ["PATH"] = f"{shim}:{old_path}"
        try:
            dry = run("launch", "3", "--agent", "impl-3-lane", "--engine", "codex", "--model", "gpt-5.6-terra", "--dry-run", "--", "plan.md")
            assert "codex exec" in dry and "lane-exit 3" in dry and "< " in dry and not (ws / "raw" / "lane-3-task3-lane.sh").exists(), dry
            dry = run("launch", "3", "--agent", "impl-3-gated", "--engine", "grok", "--model", "grok-4.6", "--after", "1,2", "--dry-run", "--", "plan.md")
            assert "wait --agent impl-3-gated --task 1 --task 2 --timeout 0" in dry and dry.index("wait --agent") < dry.index("grok --cwd"), dry
            out = run("launch", "3", "--agent", "impl-3-lane", "--engine", "grok", "--model", "grok-4.6", "--effort", "high",
                      "--owns", "app.py", "--extra=--always-approve", "--fg", "--", "plan.md")
            assert "finished rc=0" in out, out
            st = load(ws)
            s = st.stint_of("impl-3-lane")
            assert s and s.session and s.cmd_file and s.exit_code == 0 and s.tokens == 12345 and s.calls == 7 and s.owns == "app.py", vars(s)
            assert "--always-approve" in (ws / s.cmd_file).read_text() and (ws / s.log).exists()
            run("done", "1", "--msg", "round two: landed")                                  # task 1 landed → the gate opens at once
            out = run("launch", "3", "--agent", "impl-3-after", "--engine", "grok", "--model", "grok-4.6", "--after", "1", "--fg", "--", "plan.md")
            assert "finished rc=0" in out and load(ws).stint_of("impl-3-after").after == ["1"], out
            assert any("exited rc=0 but no task-3-report.md" in why for _, _, why in attention(st, time.time())), "the worktree-report hint"
            assert "export ORCHESTRATE_WS=" in (ws / load(ws).stint_of("impl-3-after").cmd_file).read_text(), "the lane's env carries the run"
            # a dependency that cannot land: the waiter is released with exit 3; a gated lane exits 125 and NEVER starts its engine
            run("blocked", "2", "--msg", "owner: controller · plan wrong")
            out = run("wait", "--agent", "impl-3-after", "--task", "2", "--timeout", "1", expect_fail=True)   # task 2 is blocked
            assert "cannot land" in out and "plan wrong" in out, out
            assert "no such task" in run("wait", "--task", "99", "--timeout", "1", expect_fail=True)         # --agent defaults to controller
            calls = (shim / "grok.calls").read_text().count("x")
            run("launch", "3", "--agent", "impl-3-doomed", "--engine", "grok", "--model", "grok-4.6", "--after", "2", "--fg", "--", "plan.md", expect_fail=True)
            s = load(ws).stint_of("impl-3-doomed")
            assert s and s.exit_code == 125 and s.tokens == 0 and (shim / "grok.calls").read_text().count("x") == calls, "a doomed lane never starts its engine"
            assert any("never started" in why and "impl-3-doomed" in why for _, _, why in attention(load(ws), time.time()))
            assert not queued_after(load(ws), load(ws).tasks["3"]), "an exited gate is not 'queued'"
            run("return", "3", "--agent", "impl-3-doomed", "--status", "BLOCKED", "--msg", "dependency task 2 failed")
            # a queued lane sits in the todo lane (nothing runs, nothing to nudge) until its dependency lands or fails
            run("todo", "6", "late input")
            run("launch", "3", "--agent", "impl-3-queued", "--engine", "grok", "--model", "grok-4.6", "--after", "6", "--", "plan.md")
            time.sleep(0.6)
            show = run("show", "--no-color")
            todo_box = show.split(lane_label("todo"), 1)[1].split(lane_label("in_progress"), 1)[0]
            assert "impl-3-queued" in todo_box and "~ after 6" in todo_box, todo_box
            run("blocked", "6", "--msg", "owner: controller · cancelled")
            for _ in range(30):
                time.sleep(0.2)
                if load(ws).stint_of("impl-3-queued").exit_code == 125:
                    break
            assert load(ws).stint_of("impl-3-queued").exit_code == 125, "a blocked dependency releases the queued wrapper with 125"
            run("return", "3", "--agent", "impl-3-queued", "--status", "BLOCKED", "--msg", "dependency task 6 cancelled")
            run("return", "3", "--agent", "impl-3-lane", "--status", "DONE")   # no --tokens: the receipt already landed
            st = load(ws)
            assert "no usage receipt" not in "\n".join(check(st)) and st.run.tokens >= 12345
            assert "7 calls" in run("task", "3") and "calls" in run("postmortem")
        finally:
            os.environ["PATH"] = old_path

        # --- lineage: a lead's subtree — relative controller, instruction tags, team peers, dotted subtasks -----------
        assert [natural_key(x) for x in ("3", "3.1", "3.10", "4", "x")] == sorted(natural_key(x) for x in ("3.10", "x", "4", "3.1", "3")), "dotted ids sort under their parent"
        run("return", "3", "--agent", "impl-3-after", "--status", "DONE")   # close the exited lane: an exit without a return outranks any other signal
        run("dispatch", "3", "--agent", "lead-3", "--model", "opus", "--role", "sub-orchestrator")
        run("todo", "3.1", "auth worker slice")
        run("dispatch", "3.1", "--agent", "impl-3.1", "--model", "sonnet", "--by", "lead-3", "--owns", "src/auth/**")
        run("dispatch", "4", "--agent", "impl-4-other", "--model", "sonnet")
        st = load(ws)
        assert st.stint_of("impl-3.1").by == "lead-3" and st.lead_of("impl-3.1") == "lead-3" and st.lead_of("lead-3") == "controller"
        assert "0/1 landed" in run("show", "--no-color"), "a lead's card counts its subtasks instead of showing elapsed time"
        assert st.events[-2]["actor"] == "lead-3", "a lead's dispatch is attributed to the lead"
        out = run("send", "which hash for the auth token?", "--from", "impl-3.1", "--to", "controller", "--ask")
        assert "impl-3.1 -> lead-3" in out and "routed to your lead" in out, out
        assert not load(ws).unread("controller") or all(m.sender != "impl-3.1" for m in load(ws).unread("controller")), "the controller is not asked"
        inbox = run("inbox", "--agent", "lead-3")
        assert "[peer impl-3.1 · ask]" in inbox and "--to impl-3.1 --re" in inbox, inbox
        run("send", "sha256, salted", "--from", "lead-3", "--to", "impl-3.1", "--re", str(load(ws).mail[-1].seq))
        run("send", "freeze the API by 17:00", "--from", "controller", "--to", "impl-3.1")
        inbox = run("inbox", "--agent", "impl-3.1")
        assert "[lead lead-3]" in inbox and "[controller]" in inbox and "controller and lead mail is an instruction" in inbox, inbox
        peers = run("peers", "--agent", "impl-3.1")
        assert "your lead: lead-3" in peers and "elsewhere in the run" in peers and peers.index("elsewhere") < peers.index("impl-4-other"), peers
        assert "src/auth" not in peers.split("elsewhere")[1] or True
        run("send", "lead-level question", "--from", "impl-3.1", "--to", "lead", "--ask")
        assert load(ws).mail[-1].to == "lead-3"
        out = run("wait", "--agent", "lead-3", "--task", "3.1", "--or-mail", "--timeout", "1", expect_fail=True)   # 5: a worker's ask wakes the lead
        assert "lead-level question" in out and "mail arrived while you waited" in out, out
        run("wait", "--agent", "lead-3", "--task", "3.1", "--or-mail", "--timeout", "1", expect_fail=True)         # 124: nothing new
        run("return", "3", "--agent", "lead-3", "--status", "DONE")             # the lead is gone → controller is the fallback
        out = run("send", "orphan question", "--from", "impl-3.1", "--to", "controller", "--ask")
        assert "impl-3.1 -> controller" in out, out
        run("return", "3.1", "--agent", "impl-3.1", "--status", "DONE")
        run("return", "4", "--agent", "impl-4-other", "--status", "DONE")
        run("inbox", "--agent", "controller")   # ack the orphan ask so later checks stay quiet about it
        run("done", "3.1")
        # --- naming: <role>-<task>, derived when omitted, attempt suffix on repeats, enforced when given -----------
        out = run("dispatch", "4", "--model", "sonnet", "--role", "spec reviewer")
        assert "task 4 → spec-4" in out and load(ws).stint_of("spec-4"), out
        run("return", "4", "--agent", "spec-4", "--status", "DONE")
        assert "→ spec-4-r2" in run("dispatch", "4", "--model", "sonnet", "--role", "spec reviewer"), "a repeat is attempt 2"
        run("return", "4", "--agent", "spec-4-r2", "--status", "DONE")
        assert "→ lead-4" in run("dispatch", "4", "--model", "opus", "--role", "sub-orchestrator")
        run("return", "4", "--agent", "lead-4", "--status", "DONE")
        run("dispatch", "4", "--agent", "Manager Steve", "--model", "sonnet", expect_fail=True)
        run("dispatch", "4", "--agent", "controller", "--model", "sonnet", expect_fail=True)
        run("dispatch", "4", "--agent", "impl-4-codex", "--model", "sonnet")   # a trailing tag is fine
        run("return", "4", "--agent", "impl-4-codex", "--status", "DONE")
        run("done", "4")   # two done cards in one lane: the who column must line up
        assert [natural_key(x) for x in ("impl-4",)] and role_short("quality reviewer") == "quality" and role_short("") == "impl"
        show = run("show", "--no-color")
        assert "by lead-3" not in show and "↳" not in show and "impl-3.1" in show, "no lineage prose on the card line: the name carries it"
        done_lines = [l for l in show.splitlines() if "impl-3.1" in l or "impl-4-codex" in l]
        assert len(done_lines) == 2 and done_lines[0].index("impl-3.1") == done_lines[1].index("impl-4-codex"), "who is a column:\n" + "\n".join(done_lines)
        assert "gpt-5.6" not in show and " sonnet" not in "\n".join(done_lines), "model and engine stay in the header unless they deviate"
        run("set", "models=worker=sonnet")
        run("plan", "approved")
        run("dispatch", "4", "--agent", "impl-4-op", "--model", "opus")
        assert "impl-4-op ·opus" in run("show", "--no-color"), "a deviating model is the one per-card fact worth a suffix"
        run("dispatch", "4", "--agent", "impl-4-eng", "--model", "sonnet", "--engine", "grok")
        assert "impl-4-eng ·grok" in run("show", "--no-color"), "a deviating engine too"
        run("return", "4", "--agent", "impl-4-eng", "--status", "DONE")
        run("return", "4", "--agent", "impl-4-op", "--status", "DONE")
        (ws / "task-5-brief.md").write_text("You are implementing Task 5: do the thing. Repo root: /x\n")
        Path("plan.md").write_text(Path("plan.md").read_text() + "## Task 5: Fifth\n")
        run("init", "plan.md", "--resume")
        assert load(ws).tasks["5"].title == "Fifth", "a plan heading outranks a brief's first line"

        # --- a read-only lane: observations degrade to a printed line, never a traceback ---------------------------
        run("dispatch", "4", "--agent", "impl-4-ro", "--model", "sonnet")
        for f in (ws / JOURNAL, ws / ".journal.lock"):
            f.chmod(0o444)
        try:
            out = run("note", "4", "hi", "--agent", "impl-4-ro")
            assert "not writable" in out and "board note 4 hi --agent impl-4-ro" in out, out
            out = run("vote", "4", "--kind", "approve", "--agent", "impl-4-ro", "--verdict", "ok")
            assert "board vote 4 --kind approve --agent impl-4-ro --verdict ok" in out, out
            assert "not writable" in run("send", "fyi", "--from", "impl-4-ro", "--to", "controller")
            assert "no new mail" in run("inbox", "--agent", "impl-4-ro")
        finally:
            for f in (ws / JOURNAL, ws / ".journal.lock"):
                f.chmod(0o644)
        assert not load(ws).problems and not any(e.get("agent") == "impl-4-ro" and e.get("ev") != "dispatch" for e in load(ws).events)
        run("return", "4", "--agent", "impl-4-ro", "--status", "DONE")

        # --- piggyback delivery: a worker's own board call hands over its mail ---------------------------------
        run("dispatch", "4", "--agent", "impl-4-b", "--model", "sonnet")
        run("send", "heads-up: app.py CLI line moves", "--from", "controller", "--to", "impl-4-b")
        out = run("note", "4", "committing", "--agent", "impl-4-b")
        assert "mail for impl-4-b" in out and "[controller] heads-up" in out and not load(ws).unread("impl-4-b"), out
        assert "no new mail" in run("inbox", "--agent", "impl-4-b")

        # --- report ↔ return: disagreement is a note and a field, never a refusal ----------------------------------
        (ws / "task-4-report.md").write_text("Status: DONE\nall good\n")
        out = run("return", "4", "--agent", "impl-4-b", "--status", "DONE_WITH_CONCERNS", "--report", "task-4-report.md")
        assert "report says Status: DONE" in out and load(ws).stint_of("impl-4-b").reported == "DONE", out
        assert "report ≠ return" in run("postmortem")

        # --- follow: a filtered tail that ends on finish or timeout --------------------------------------------------
        seq0 = load(ws).run.last_seq
        run("send", "fyi", "--from", "controller", "--to", "all")
        run("note", "4", "beat", "--agent", "impl-4-b")
        out = run("follow", "--since", str(seq0), "--timeout", "1", "--kinds", "mail", expect_fail=True)   # 124 on timeout
        assert "mail" in out and "beat" not in out, out
        out = run("follow", "--since", str(seq0), "--timeout", "1", "--for", "controller", expect_fail=True)
        assert "fyi" in out and "beat" not in out, out

        # --- dependency rendezvous: wait on a task's RETURN, peers show what returned ---------------------------
        run("dispatch", "3", "--agent", "impl-3-dep", "--model", "sonnet")
        run("wait", "--agent", "impl-4-b", "--task", "3", "--timeout", "1", expect_fail=True)      # open → 124
        run("lane-exit", "3", "--agent", "impl-3-dep", "--exit", "0")                                  # exited, no report yet → still open
        run("wait", "--agent", "impl-4-b", "--task", "3", "--timeout", "1", expect_fail=True)
        (ws / "task-3-report.md").write_text("Status: DONE\n")
        out = run("wait", "--agent", "impl-4-b", "--task", "3", "--timeout", "1")                   # exited + report on disk → 0
        assert "report on disk" in out and "not yet returned" in out, out
        run("return", "3", "--agent", "impl-3-dep", "--status", "DONE", "--commits", f"{base}..{base}")
        out = run("wait", "--agent", "impl-4-b", "--task", "3", "--timeout", "1")                   # returned → 0
        assert "task 3" in out and "done" in out and base in out, out
        peers = run("peers", "--agent", "impl-4-b")
        assert "returned (their work is on disk" in peers and "impl-3-dep" in peers and "board wait --agent <you> --task N" in peers, peers

        # --- learn: a worker's one-liner reaches its team at their next checkpoint; one watermark for the whole digest ----------
        assert "learn" not in TASK_EVENTS, "a learning after finish is not work"
        run("learn", "4", "x", "--agent", "nobody-9", expect_fail=True)                      # no open stint
        run("learn", "3", "x", "--agent", "impl-3-dep", expect_fail=True)                    # returned → the report
        run("dispatch", "4", "--agent", "impl-4-l", "--model", "sonnet")
        run("learn", "4", "y" * (LEARN_LEN + 1), "--agent", "impl-4-l", expect_fail=True)     # one line
        run("learn", "4", "  ", "--agent", "impl-4-l", expect_fail=True)
        run("learn", "4", "x", expect_fail=True)                                              # no agent, no BOARD_AGENT
        run("dispatch", "3", "--agent", "impl-3-l", "--model", "sonnet")
        out = run("learn", "4", "jest fixture db.sqlite is stale — run npm run db:reset first", "--agent", "impl-4-l", "--path", "tests/fixtures")
        assert "learned #" in out and "impl-3-l" in out and "controller" in out, out
        run("learn", "3", "JEST  fixture db.sqlite is stale — run npm run db:reset first", "--agent", "impl-3-l", expect_fail=True)   # duplicate, case/space-insensitive
        out = run("inbox", "--agent", "impl-3-l")
        assert "learned since your last check" in out and "[peer impl-4-l · gotcha] jest fixture" in out and "(tests/fixtures)" in out and "verify" in out, out
        assert "no new mail" in run("inbox", "--agent", "impl-3-l"), "the batch is acked as one"
        assert "jest fixture" not in run("inbox", "--agent", "impl-4-l"), "a sender never receives its own learning"
        ctrl = run("inbox", "--agent", "controller")
        assert "learned (curate" in ctrl and "jest fixture" in ctrl and "task 4" in ctrl and "record changes" not in ctrl, ctrl
        # record changes since dispatch: a decision or rail after the stint started is news; before it, the brief already carried it
        run("decide", "D-02", "cookie auth", "--why", "browser clients keep the session")
        out = run("decide", "D-02", "header auth", "--why", "mobile clients send no cookies")
        assert "revised" in out, out
        run("rail", "no npm publish from lanes")
        out = run("inbox", "--agent", "impl-4-l")
        assert "record changes since your dispatch" in out and "decision D-02 cookie auth — why: browser clients" in out \
            and "decision D-02 (revised) header auth" in out and "rail no npm publish" in out and "outranks your brief" in out, out
        assert "no new mail" in run("inbox", "--agent", "impl-4-l")
        assert "record changes" not in run("inbox", "--agent", "controller"), "the controller wrote them"
        run("dispatch", "3", "--agent", "impl-3-m", "--model", "sonnet")
        out = run("inbox", "--agent", "impl-3-m")
        assert "record changes" not in out and "learned since" in out and "jest fixture" in out, "a later worker gets the backlog of learnings, not the record it was briefed on:\n" + out
        assert "why: browser clients" in (ws / "decisions.md").read_text() and "supersedes the earlier D-02" in (ws / "decisions.md").read_text()
        # one watermark: mail + learning in one batch — both shown, both acked; --peek acks nothing
        run("send", "moving tests/helpers.ts", "--from", "impl-4-l", "--to", "impl-3-l")
        run("learn", "4", "npm test needs NODE_OPTIONS=--experimental-vm-modules", "--agent", "impl-4-l", "--kind", "constraint")
        out = run("inbox", "--agent", "impl-3-l", "--peek")
        assert "[peer impl-4-l] moving tests" in out and "[peer impl-4-l · constraint] npm test" in out, out
        out = run("inbox", "--agent", "impl-3-l")
        assert "moving tests" in out and "npm test needs" in out, out
        assert "no new mail" in run("inbox", "--agent", "impl-3-l")
        acks = [e for e in load(ws).events if e.get("ev") == "ack" and e.get("agent") == "impl-3-l"]
        assert acks[-1].get("count") == 1 and acks[-1].get("learned") == 1, acks[-1]
        # the cap, and check names it
        run("learn", "4", "third one", "--agent", "impl-4-l")
        run("learn", "4", "fourth one", "--agent", "impl-4-l", expect_fail=True)
        assert any("learnings at the cap" in f for f in check(load(ws))), check(load(ws))
        # team scope in a tree: a subtree's learnings stay with the subtree and its lead; the lead's reach its workers and its peers
        run("todo", "3.5", "Sub")
        run("dispatch", "3", "--agent", "lead-3-x", "--model", "opus", "--role", "sub-orchestrator")
        run("dispatch", "3.5", "--agent", "impl-3.5", "--model", "sonnet", "--by", "lead-3-x")
        out = run("learn", "3.5", "subtree gotcha: the sub api needs a token", "--agent", "impl-3.5")
        assert "lead-3-x" in out and "impl-4-l" not in out and "impl-3-m" not in out, out
        assert "subtree gotcha" not in run("inbox", "--agent", "impl-4-l")
        out = run("inbox", "--agent", "lead-3-x")
        assert "[peer impl-3.5 · gotcha] subtree gotcha" in out, out
        run("learn", "3", "lead says: rate limit is 10 rps", "--agent", "lead-3-x", "--kind", "invariant")
        assert "[lead lead-3-x · invariant] lead says" in run("inbox", "--agent", "impl-3.5"), "a lead's learning reaches its workers, tagged lead"
        assert "[peer lead-3-x · invariant] lead says" in run("inbox", "--agent", "impl-3-m"), "and its peers under the same dispatcher"
        out = run("learn", "4", "controller learned: CI needs the seed step", "--agent", "controller")
        assert "learned #" in out and "impl-3-m" in out, out
        # BOARD_AGENT: inside a lane no worker-side call needs --agent
        os.environ["BOARD_AGENT"] = "impl-3-m"
        try:
            out = run("learn", "3", "env default line")
            assert "[controller · gotcha] controller learned" in out, "the learn call itself delivers the lane's digest:\n" + out
            assert load(ws).learned[-1].agent == "impl-3-m"
            assert "no new mail" in run("inbox"), "inbox defaults to the lane's own name"
        finally:
            os.environ.pop("BOARD_AGENT", None)
        # a read-only lane prints the learn line to carry in the return
        for f in (ws / JOURNAL, ws / ".journal.lock"):
            f.chmod(0o444)
        try:
            out = run("learn", "3", "ro line", "--agent", "impl-3-m", "--kind", "fact")
            assert "not writable" in out and "board learn 3 'ro line' --agent impl-3-m --kind fact" in out, out
        finally:
            for f in (ws / JOURNAL, ws / ".journal.lock"):
                f.chmod(0o644)
        # views
        show = run("show", "--no-color")
        assert "learn " in show and "new for you" in show, show
        assert json.loads(run("show", "--json"))["learn"]
        lst = run("learn")
        assert "[gotcha] impl-4-l (task 4" in lst and "constraint 1" in lst, lst
        assert "[constraint] impl-4-l" in run("task", "4") or "constraint" in run("task", "4"), run("task", "4")
        res = run("resume")
        assert "## Learned" in res and "jest fixture" in res and "D-02: header auth — why: mobile clients" in res and "project memory" not in res, res
        # memory: the run as one project-context record — handoff while open, observation when the final gate stands
        run("learn", "3", "tried sqlite in-memory for tests — the migrations need a file", "--agent", "impl-3-m", "--kind", "failed")
        run("decide", "D-03", "no ORM", "--owner", "controller")   # no --why: the record says so instead of inventing one
        run("exec", "3", "--name", "unit", "--agent", "impl-3-m", "--", sys.executable, "-c", "pass")
        rec = json.loads(run("memory"))
        assert rec["record_type"] == "handoff" and rec["current_state"]["status"] == "in_progress" and rec["task"]["id"] == load(ws).run.id, rec
        assert all(d["rationale"] for d in rec["decisions"]) and any("mobile clients" in d["rationale"] for d in rec["decisions"]) \
            and any("not recorded" in d["rationale"] for d in rec["decisions"]), rec["decisions"]
        assert any("dependency task 2 failed" in a.get("reason", "") for a in rec["attempts"]) and any("sqlite in-memory" in a["approach"] and a["outcome"] == "failed" for a in rec["attempts"]), rec["attempts"]
        assert any(l["type"] == "gotcha" for l in rec["learnings"]) and any(l["type"] == "constraint" for l in rec["learnings"]) \
            and not any("sqlite in-memory" in l["statement"] for l in rec["learnings"]), rec["learnings"]
        assert any(v["check"] == "task 3 unit" and v["outcome"] == "passed" and v["details"].startswith("raw/") for v in rec["verification"]), rec["verification"]
        assert rec["changes"]["capture"] == "agent-authored" and "commits" not in rec["changes"] and any(a["type"] == "journal" for a in rec["changes"]["artifacts"]), rec["changes"]   # no accepted stint carried commits → no empty list either
        assert rec["scope"] == [] and "orchestrate" in rec["tags"] and rec["current_state"]["remaining"] and rec["current_state"]["next_steps"], rec
        rec = json.loads(run("memory", "--observation", "--scope", "auth, api"))
        assert rec["record_type"] == "observation" and rec["scope"] == ["auth", "api"]
        out = run("memory", "--out", str(ws / "memory.json"))
        assert "ctx handoff --agent orchestrate --session-id" in out and json.loads((ws / "memory.json").read_text())["record_type"] == "handoff", out
        # hints appear only when the repo keeps project memory (the files `ctx init` creates); the board never runs ctx
        (ws / "raw").mkdir(exist_ok=True)
        (ws / "raw" / "final.md").write_text("fail — tasks open\n")
        assert "project memory" not in run("finish", "--gate", "fail", "--evidence", "raw/final.md", "--msg", "still open")
        (Path(tmp) / ".agent").mkdir()
        (Path(tmp) / ".agent" / "PROJECT_CONTEXT.jsonl").write_text('{"record_type":"observation"}\n')
        out = run("finish", "--gate", "fail", "--evidence", "raw/final.md", "--msg", "still open")
        assert "project memory: board memory --out" in out and "ctx handoff --agent orchestrate" in out, out
        rec = json.loads(run("memory"))
        assert any(v["check"] == "final-deliverable gate" and v["outcome"] == "failed" for v in rec["verification"]), rec["verification"]
        assert "## Project memory" in run("resume") and "ctx handoff" in run("resume")
        out = run("init", "plan.md", "--resume")
        assert "project memory: 1 entry" in out and "ctx context --scope" in out, out
        # a gated lane's wrapper waits AS the engine but is not the engine: --peek shows and never acks (observed live: a
        # wrapper's wait consumed the learning the engine was launched to receive)
        run("return", "4", "--agent", "impl-4-l", "--status", "DONE")
        run("send", "for the engine, not the wrapper", "--from", "controller", "--to", "impl-3-m")
        run("learn", "3.5", "gate test: a fixture the engine must hear about", "--agent", "impl-3.5")
        out = run("wait", "--agent", "impl-3-m", "--task", "4", "--timeout", "1", "--peek")
        assert "task 4" in out and "for the engine" not in out, out
        assert len(load(ws).unread("impl-3-m")) == 1 and not any(e.get("agent") == "impl-3-m" and e.get("ev") == "ack" and int(e.get("upto") or 0) >= load(ws).mail[-1].seq for e in load(ws).events), "peek must not ack"
        out = run("wait", "--agent", "impl-3-m", "--task", "4", "--timeout", "1")
        assert "for the engine" in out and "gate test" not in out, out   # impl-3.5's learning stays in its subtree; the mail is delivered and acked
        assert not load(ws).unread("impl-3-m")
        assert "--peek" in run("launch", "3", "--agent", "impl-3-gatepeek", "--engine", "grok", "--model", "m", "--after", "4", "--dry-run", "--", "plan.md"), "the wrapper's gate never acks"
        for tid, a in (("3", "impl-3-l"), ("3", "impl-3-m"), ("3.5", "impl-3.5"), ("3", "lead-3-x")):
            run("return", tid, "--agent", a, "--status", "DONE")
        subprocess.run(["git", "checkout", "-q", "-b", "elsewhere"], check=True)
        assert "(you: elsewhere)" in run("show", "--no-color"), "viewer's branch is named when it differs from the run's"
        subprocess.run(["git", "checkout", "-q", "main"], check=True)

        # --- the pane follows the active run: registry, latest-run policy, runs listing ---------------------------
        regs = registry_runs()
        assert regs and Path(regs[0]["ws"]).resolve() == ws.resolve() and regs[0]["repo"] == Path(tmp).name, regs
        elsewhere = Path(tmp) / "elsewhere"
        elsewhere.mkdir()
        assert latest_run_ws(elsewhere / ".orchestrate").resolve() == ws.resolve(), "a repo with no run follows the live one"
        assert latest_run_ws(ws).resolve() == ws.resolve()
        assert Path(tmp).name in run("runs") and "← here" in run("runs")
        os.environ["ORCHESTRATE_WS"] = str(ws)
        assert latest_run_ws(elsewhere).resolve() == elsewhere.resolve(), "an explicit ORCHESTRATE_WS is never overridden"
        os.environ.pop("ORCHESTRATE_WS")
        # observed model keyed by the NAMED role when the models map has it
        run("set", "models=worker=sonnet,integrator=opus")
        run("plan", "approved")
        run("dispatch", "4", "--agent", "integ-4", "--model", "opus", "--role", "integrator")
        run("return", "4", "--agent", "integ-4", "--status", "DONE", "--observed-model", "opus")
        st = load(ws)
        assert st.run.observed.get("integrator") == "opus" and not any("integ-4" in d for d in st.run.drift), (st.run.observed, st.run.drift)

        # --- an older repo: a pre-journal workspace is detected, refused by bare init, adopted by --resume ----
        shutil.rmtree(ws)
        ws.mkdir()
        (ws / "run.md").write_text("# Run\nstrategy staged, chosen because the tasks are independent\n")
        (ws / "task-1-brief.md").write_text("# Task 1: Scaffold\n")
        (ws / "task-1-report.md").write_text("Status: DONE\n")
        (ws / "task-2-brief.md").write_text("# Task 2: Auth\n")
        (ws / "progress.md").write_text("Task 1: complete (review clean)\n")
        st = load(ws)
        assert workspace_shape(ws, st)[0] == "pre-journal" and st.tasks["1"].state == "done" and st.tasks["2"].state == "todo"
        assert any("predates the journal" in f for f in check(st)), check(st)
        run("memory", expect_fail=True)   # no run record to describe
        run("init", "plan.md", "--strategy", "staged", "--goal", "Adopt me", expect_fail=True)
        assert (ws / "progress.md").exists() and not (ws / "archive").exists(), "refusal must leave the ledger where it is"
        out = run("init", "plan.md", "--resume", "--strategy", "staged", "--review", "dual", "--goal", "Adopt me")
        assert "adopted a pre-journal workspace" in out and "1 done" in out, out
        st = load(ws)
        runmd = (ws / "run.md").read_text()
        assert st.run.adopted and st.tasks["1"].state == "done" and st.tasks["2"].state == "todo" and st.tasks["3"].state == "todo"
        assert runmd.startswith(OPEN) and "chosen because" in runmd, "Resolved block goes above the existing prose, never over it"
        assert not any("predates" in f for f in check(st))
        rp = replay(st)
        assert rp and "inconclusive (pre-journal history" in rp[0] and not any("without its journal line" in r for r in rp), rp
        run("init", "plan.md", "--resume")  # idempotent: nothing archived, nothing re-queued
        assert len(load(ws).events) == len(st.events)
        print("board: selftest OK")
        return 0
    finally:
        os.chdir(cwd)
        if env_ws is not None:
            os.environ["ORCHESTRATE_WS"] = env_ws
        if env_home is None:
            os.environ.pop("ORCHESTRATE_HOME", None)
        else:
            os.environ["ORCHESTRATE_HOME"] = env_home
        for k, v in saved_env.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
