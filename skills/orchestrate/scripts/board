#!/usr/bin/env python3
"""board — the journal (v2) and its views. Stdlib only. Resolves the workspace through the main
worktree, so it works from any pane or lane whose cwd is anywhere inside the repo or a worktree.

Everything is derived from `.orchestrate/` — briefs, reports, findings, the ledger — plus ONE
append-only, hash-chained stream, `.orchestrate/journal.jsonl`. Newest fact wins; a ledger line
is final. The board is a VIEW, never a second record: transitions are the controller's to record;
workers only observe (note · exec · learn · send · inbox · wait · peers · vote), and a lane in a
read-only sandbox degrades to a printed line instead of a traceback. Every worker-side call also
hands over what the worker has not seen yet: mail, what peers learned, decisions and rails that
changed since its dispatch — one watermark, delivered at the worker's own checkpoints.

CONTROLLER — the loop
  init PLAN --strategy S [--review --engine --host --models r=t,.. --effort --isolation --trigger
       --workers --budget --confirm --alias --lanes --goal ".."] [--resume | --fresh]
  set key=value ..                 re-resolve a dimension (the plan goes back to pending)
  plan [--why ".."] · plan approved|changed|skipped [--msg]
  dispatch N --model M [--agent <role>-<task>: derived when omitted] [--role --engine --effort --worktree --owns --by LEAD
       --session --log --cmd-file]        names: impl-3 · lead-1 · impl-1.1 · spec-3 · quality-3 · verify-3 · integ-1 · fix-3-r2
  return N --agent A --status DONE|DONE_WITH_CONCERNS|NEEDS_CONTEXT|BLOCKED|REFUSED
       [--commits a..b --report PATH --observed-model M --tokens 84k --session ID]
  review N --kind K [--round --agent --model] · gate N --kind K --verdict ok|fail|warn [--round --findings]
  exec N --name X -- <cmd> · result N --name X --exit RC [--log]     a check THROUGH the journal
  nudge N --agent A · escalate N --agent A --to MODEL --why ".." · blocked N --msg ".."
  decide ID "msg" [--why ".." --owner --task] · rail "msg" · todo N [title]     (re-deciding an id supersedes it)
  done N [--msg]                   writes the ledger line; refused over a failed gate or check
  check [--finish] [--replay] [--json] · finish --gate pass|fail --evidence PATH [--force --reason]
  wait --task N [--task M] [--timeout 0]   block until their work is on disk (exit 3: one cannot land)

LANES — a subprocess engine as one command
  launch N --agent A --engine E --model M [--effort --owns --after N,M --cwd --extra='..' --dry-run --fg] -- spec.md
  lane-exit N --agent A --exit RC · receipt N --agent A [--tokens --calls --cost --session]
  (exit 125 = a dependency failed and the engine never started; 124 = the gate timed out)

WORKERS — observations (every one also hands you your unread mail, peers' learnings, record changes)
  note N "msg" --agent A · exec N --name X --agent A -- <cmd> · result N --name X --exit RC --agent A
  learn N "one line" --agent A [--kind gotcha|failed|invariant|constraint|convention|fact|question] [--path P]
       (what the next worker would re-pay — capped, deduped, team-scoped; depth goes in your report)
  send "msg" --from A --to <agent|controller|lead|all> [--ask] [--re SEQ] · inbox --agent A [--peek]
       (controller/lead resolve to YOUR dispatcher in a tree: a subtree's questions go to its lead)
  wait --agent A [--timeout S] · wait --agent A --task N [--or-mail: exit 5 when mail comes first] · peers --agent A
  vote N --kind K --agent A --verdict ok|fail|warn [--why ".."]

VIEWS
  board (live kanban: q · j/k · enter · e · a · r · n) · watch [--here] · runs · show [-x --attention --json]
  plan · agents · attention · task N · log [-n --json] · mail [--task N] · learn (the run's learnings)
  follow [--for controller --kinds .. --since SEQ --timeout S] · postmortem · resume [--no-probe] · path
  memory [--observation|--handoff --scope a,b --out PATH]   the run as a project-context
       record (JSON for `ctx append --input` / `ctx handoff --input`) — printed, never appended by the board
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import unicodedata
from pathlib import Path

SCHEMA = 2
COLUMNS = ["todo", "in_progress", "review", "done", "blocked"]
LABELS = {c: c.upper().replace("_", " ") for c in COLUMNS}
STALE_AFTER = 10 * 60  # seconds without an ARTIFACT delta before an open stint is flagged
JOURNAL = "journal.jsonl"
LEGACY_JOURNAL = "board.jsonl"
KEEP_ON_ARCHIVE = {"board", ".gitignore", ".journal.lock", "toolbox.md", "archive"}
DIMS = ("strategy", "review", "engine", "host", "models", "effort", "isolation", "trigger",
        "workers", "budget", "confirm", "alias", "goal", "lanes")
TIER_DEFAULT = {"orchestrator": "opus-class", "worker": "sonnet-class", "reviewer": "sonnet-class",
                "advisor": "strongest", "reasoner": "opus-class", "peer": "codex/grok"}
STATUSES = ("DONE", "DONE_WITH_CONCERNS", "NEEDS_CONTEXT", "BLOCKED", "REFUSED")
TASK_EVENTS = {"todo", "title", "dispatch", "return", "review", "gate", "nudge", "escalate", "done",
               "blocked", "note", "check", "vote", "exit", "receipt"}
# Mail is information, not conversation: hard caps keep two agents from talking instead of working.
MAIL_CAP = 8        # sends per stint — beyond this the answer belongs in the report
THREAD_CAP = 3      # replies-to-replies — beyond this it is a meeting, not a message
# A learning is one line a peer would otherwise re-pay for; the report carries the depth.
LEARN_CAP = 3       # learnings per stint
LEARN_LEN = 300     # characters per learning
LEARN_KINDS = ("gotcha", "failed", "invariant", "constraint", "convention", "fact", "question")   # project-context's learnings.type + failed (an attempt)
WAIT_SLICE = 110    # default `board wait` timeout (s): under every harness's shell-tool timeout
DONE_SHOW = 3  # done cards shown in contracted mode before "+N more"
# Lanes are a PROJECTION of the canonical state × the open stint's role — declared with
# `board init --lanes …` (a run dim) or defaulted to COLUMNS; the state model underneath never changes.
LANE_OF_ROLE = (("implement", "implement"), ("worker", "implement"), ("executor", "implement"), ("fix", "implement"),
                ("verif", "verify"), ("integrat", "integrate"), ("advis", "advise"), ("review", "review"),
                ("judge", "review"))
LANE_BASE = {"implement": "in_progress", "verify": "in_progress", "integrate": "in_progress", "advise": "in_progress"}
# Agent names are `<role>-<task>[-tag…]`: impl-3 · lead-1 · impl-1.1 · spec-3 · quality-3 · verify-3 · integ-1 · fix-3-r2.
# The role says what the sender IS (a small model reads `[peer impl-1.2]` and knows), the task id says WHERE in the
# tree it sits (impl-1.1 is under lead-1), the run makes it unique. Omit --agent and the board derives it.
AGENT_RE = re.compile(r"^[a-z][a-z0-9]*-\d+(?:\.\d+)*(?:-[a-z0-9]+)*$")
ROLE_SHORT = (("sub-orch", "lead"), ("lead", "lead"), ("orchestr", "lead"), ("integrat", "integ"), ("fix", "fix"), ("spec", "spec"),
              ("qual", "quality"), ("verif", "verify"), ("judge", "judge"), ("lens", "lens"), ("panel", "lens"), ("review", "review"),
              ("advis", "advisor"), ("peer", "peer"), ("counter", "peer"), ("plan", "planner"), ("research", "research"),
              ("implement", "impl"), ("worker", "impl"), ("executor", "impl"))
# Per-engine resume-by-id lines (printed by `board resume` for every open stint that journaled a session).
RESUME_CMD = {
    "codex": "codex exec resume {id} -c 'sandbox_mode=\"workspace-write\"' --json -o out.md - < nudge.md",
    "claude": "claude -p --resume {id} \"<nudge>\"",
    "grok": "grok -r {id} --prompt-file nudge.md",
    "opencode": "opencode run -s {id} \"<nudge>\"",
    "hermes": "hermes -z \"<nudge>\" --resume {id}",
    "kimi": "kimi -S {id} -p \"<nudge>\"",
    "pi": "pi --session {id} -p \"<nudge>\"",
    "cursor": "cursor-agent -p --resume {id} \"<nudge>\"",
    "agy": "agy -p --conversation {id} \"<nudge>\"",
}
# Executable lane templates for `board launch`. argv is a LIST (no quoting bugs): {repo} {model} {effort}
# {session} {spec} {out} {usage} are filled in; "{spec_text}" becomes "$(cat spec)" in the wrapper. `prompt`:
# how the brief reaches the engine (stdin | flag | text). `session`: "pin" (board mints the id) or "stream"
# (read from the log after exit). `receipt`: how usage is captured after exit. Approval and sandbox flags
# are deliberately absent — pass them with --extra, knowingly (grok --always-approve, codex --approve-for-me…).
ENGINES = {
    "grok": {"argv": ["grok", "--cwd", "{repo}", "-m", "{model}", "--reasoning-effort", "{effort}", "-s", "{session}",
                      "--prompt-file", "{spec}", "--output-format", "json"], "prompt": "flag", "session": "pin",
             "receipt": "grok-usage", "resume": "grok -r {id} --prompt-file nudge.md"},
    "codex": {"argv": ["codex", "exec", "--cd", "{repo}", "-m", "{model}", "-c", "model_reasoning_effort={effort}",
                       "--sandbox", "workspace-write", "--json", "-o", "{out}", "-"], "prompt": "stdin", "session": "stream",
              "receipt": "codex-log"},
    "claude": {"argv": ["claude", "-p", "--session-id", "{session}", "--model", "{model}", "--effort", "{effort}",
                        "--output-format", "stream-json", "--verbose", "--permission-mode", "acceptEdits"], "prompt": "stdin",
               "session": "pin", "receipt": "claude-log"},
    "opencode": {"argv": ["opencode", "run", "-f", "{spec}", "--model", "{model}", "--variant", "{effort}", "--format", "json",
                          "Execute the attached brief."], "prompt": "flag", "session": "none", "receipt": "none"},
    "hermes": {"argv": ["hermes", "-z", "{spec_text}", "--model", "{model}", "--usage-file", "{usage}", "--ignore-rules"],
               "prompt": "text", "session": "none", "receipt": "hermes-usage"},
    "kimi": {"argv": ["kimi", "-p", "{spec_text}", "-m", "{model}", "--output-format", "stream-json"], "prompt": "text",
             "session": "none", "receipt": "none"},
    "pi": {"argv": ["pi", "-p", "-nc", "--no-session", "--model", "{model}", "--thinking", "{effort}", "--mode", "json",
                    "@{spec}", "Execute this brief."], "prompt": "flag", "session": "none", "receipt": "none"},
    "cursor": {"argv": ["cursor-agent", "-p", "--model", "{model}", "--output-format", "stream-json", "{spec_text}"],
               "prompt": "text", "session": "none", "receipt": "none"},
    "agy": {"argv": ["agy", "-p", "--cwd", "{repo}", "--model", "{model}", "--effort", "{effort}", "--output-format",
                     "stream-json", "{spec_text}"], "prompt": "text", "session": "none", "receipt": "none"},
}
# Per-engine launch previews for the flight plan (pre-configured from the record; slugs stay the engine file's job).
LAUNCH_CMD = {
    "codex": "codex exec --cd <repo> -m {model} -c model_reasoning_effort={effort} --sandbox workspace-write --worktree --json -o out.md - < spec.md",
