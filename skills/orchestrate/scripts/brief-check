#!/usr/bin/env bash
# brief-check <brief-file> [<brief-file>...] — validate task brief(s) against the
# priming anatomy (references/shared-token-economy.md). Exit 0 = dispatchable;
# non-zero = one reason per line on stderr. Validates controller-COMPOSED briefs,
# never raw scripts/task-brief output (that's an input to composition).
# Multi-brief mode (2+ files) adds a cross-brief collision pass: the same
# `write: <path>` deliverable or the same report path claimed by two briefs is a
# clobber waiting for a less careful worker — fail before dispatch.
set -euo pipefail

[ "$#" -ge 1 ] || { echo "usage: brief-check <brief-file> [<brief-file>...]" >&2; exit 2; }

fail=0
err() { echo "brief-check: $1" >&2; fail=1; }

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

extract_report_path() {
  awk '
    { l = tolower($0) }
    on && (l ~ /^#+[ \t]/ || l ~ /^\*\*[a-z]/) { on = 0 }
    !on && (l ~ /^#+[ \t].*report/ || l ~ /^\*\*report/) { on = 1 }
    on { print }
  ' "$1" | grep -oE '\.orchestrate/[A-Za-z0-9._/-]+\.md' | head -1 || true
}

check_brief() {
  local brief="$1"
  [ -f "$brief" ] || { err "no such file: $brief"; return; }

  # Required sections (case-insensitive heading match anywhere in the file)
  local section
  for section in objective scope verification report "stop condition"; do
    grep -qiE "^#+ .*${section}|^\*\*${section}" "$brief" || err "$brief: missing section: ${section}"
  done

  # Pointer lines: `read: <path> — <why>` (optional `@ <sha>`; `(will exist)` skipped)
  local unpinned=0 line path resolved
  while IFS= read -r line; do
    case "$line" in *"(will exist)"*) continue ;; esac
    path="$(printf '%s' "$line" | sed -E 's/^[[:space:]]*-?[[:space:]]*read:[[:space:]]*//' | awk '{print $1}')"
    [ -n "$path" ] || continue
    case "$path" in
      /*) resolved="$path" ;;
      *)  resolved="$repo_root/$path" ;;
    esac
    [ -e "$resolved" ] || err "$brief: dead pointer: $path (resolved: $resolved)"
    case "$line" in *"@ "*) : ;; *) unpinned=$((unpinned+1)) ;; esac
  done < <(grep -E '^[[:space:]]*-?[[:space:]]*read:' "$brief" || true)

  # Warn (not fail) on unpinned pointers when multiple worktrees are active
  if [ "$unpinned" -gt 0 ] && [ "$(git worktree list 2>/dev/null | wc -l)" -gt 1 ]; then
    echo "brief-check: warning: $brief: $unpinned unpinned pointer(s) with >1 worktree active — pin with '@ <sha>'" >&2
  fi

  # Report contract must name a .orchestrate/... .md path and its directory must exist.
  # Scoped to the Report section — a pointer elsewhere (e.g. read: .orchestrate/toolbox.md)
  # must not satisfy this check.
  local report_path dir
  report_path="$(extract_report_path "$brief")"
  if [ -n "$report_path" ]; then
    dir="$repo_root/$(dirname "$report_path")"
    [ -d "$dir" ] || err "$brief: report directory missing: $dir (run scripts/workspace first)"
  else
    err "$brief: report contract names no .orchestrate/<...>.md path (the report section must state where to write)"
  fi
}

for brief in "$@"; do
  check_brief "$brief"
done

# Cross-brief collision pass (multi-brief mode only): no two briefs may claim the
# same `write:` deliverable path, and no two briefs may share a report path.
if [ "$#" -ge 2 ]; then
  collisions="$(
    for brief in "$@"; do
      [ -f "$brief" ] || continue
      grep -E '^[[:space:]]*-?[[:space:]]*write:' "$brief" 2>/dev/null \
        | sed -E 's/^[[:space:]]*-?[[:space:]]*write:[[:space:]]*//' | awk -v b="$brief" '{print $1 "\t" b}'
      rp="$(extract_report_path "$brief")"
      [ -n "$rp" ] && printf '%s\t%s\n' "$rp" "$brief"
    done | sort | awk -F'\t' '
      { if ($1 == prev_path && $2 != prev_brief) printf "%s claimed by both %s and %s\n", $1, prev_brief, $2
        prev_path=$1; prev_brief=$2 }'
  )"
  if [ -n "$collisions" ]; then
    while IFS= read -r c; do err "cross-brief collision: $c"; done <<< "$collisions"
  fi

  # Dependencies (say, never fail): brief B reads a path brief A writes → B's input is A's output.
  # A hard dependency launches gated (`board launch … --after A`: the wrapper waits, the model never
  # pays to wait); a soft one builds against the contract and calls `board wait --task A` only before
  # its verification run. Running it unblocked is a legitimate choice — hence a hint, not an error.
  task_id() { basename "$1" | sed -E 's/^task-(.+)-brief\.md$/\1/; s/^card-(.+)\.md$/\1/'; }
  deps="$(
    for a in "$@"; do
      [ -f "$a" ] || continue
      ta="$(task_id "$a")"
      grep -E '^[[:space:]]*-?[[:space:]]*write:' "$a" 2>/dev/null \
        | sed -E 's/^[[:space:]]*-?[[:space:]]*write:[[:space:]]*//' | awk '{print $1}' | while IFS= read -r w; do
        [ -n "$w" ] || continue
        for b in "$@"; do
          [ "$b" != "$a" ] && [ -f "$b" ] || continue
          tb="$(task_id "$b")"
          grep -E '^[[:space:]]*-?[[:space:]]*read:' "$b" 2>/dev/null \
            | sed -E 's/^[[:space:]]*-?[[:space:]]*read:[[:space:]]*//' | awk '{print $1}' | while IFS= read -r r; do
            [ -n "$r" ] || continue
            # shellcheck disable=SC2053 # unquoted $w on purpose: a write: glob (src/api/**) matches its files
            if [[ "$r" == "$w" || "$r" == "$w"/* || "$r" == $w ]]; then printf '%s\t%s\t%s\n' "$tb" "$ta" "$r"; fi
          done
        done
      done
    done | sort -u
  )"
  if [ -n "$deps" ]; then
    while IFS=$'\t' read -r tb ta path; do
      [ -n "$tb" ] || continue
      echo "brief-check: dependency: task $tb reads $path, written by task $ta — launch $tb with --after $ta (hard), or have it 'board wait --task $ta' before its verification run (soft)" >&2
    done <<< "$deps"
  fi

  # One snapshot per batch (warn, not fail): all pinned pointers across a batch should share one
  # repo revision — two workers each correct against a different version of the truth raise no
  # error on their own (shared-token-economy.md). A deliberate mixed batch is a re-dispatch
  # decision the controller makes knowingly.
  distinct_pins="$(
    for brief in "$@"; do
      [ -f "$brief" ] || continue
      grep -oE '@ [0-9a-fA-F]{7,40}' "$brief" || true
    done | sort -u
  )"
  pin_count="$(printf '%s\n' "$distinct_pins" | grep -c '@' || true)"
  if [ "$pin_count" -gt 1 ]; then
    echo "brief-check: warning: mixed snapshot — $pin_count distinct '@ <sha>' pins across this batch; one snapshot per fan-out batch unless the mix is a deliberate re-dispatch decision" >&2
  fi
fi

exit "$fail"
